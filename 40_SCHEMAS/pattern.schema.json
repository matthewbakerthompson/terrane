{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-as-code/schemas/pattern.schema.json",
  "title": "Pattern",
  "description": "A building block plus the decision, or a list of them in one file.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "name",
        "blocks",
        "intent",
        "consequences",
        "when_not_to_use"
      ],
      "properties": {
        "pattern_id": {
          "type": "string"
        },
        "replaces": {
          "type": "string",
          "description": "This record's own id, said to stand in for the record of that id in a library read before this one. Without it a second record of an id is an error."
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "Candidate",
            "Approved",
            "Deprecated",
            "Retired"
          ]
        },
        "category": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "intent": {
          "type": "string"
        },
        "consequences": {
          "type": "string"
        },
        "when_not_to_use": {
          "type": "string"
        },
        "satisfies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
          },
          "description": "Controls in the register the pattern is designed to meet. An organization's own pattern may say; a shipped one does not, and `patterns` in model.yaml is where an estate says it of any pattern."
        },
        "owner_org_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
        },
        "decision_ref": {
          "type": "string"
        },
        "method_ref": {
          "type": "string",
          "description": "The method's reference pattern this one implements, by id (PAT-002)."
        }
      }
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern_id",
          "name",
          "blocks",
          "intent",
          "consequences",
          "when_not_to_use"
        ],
        "properties": {
          "pattern_id": {
            "type": "string"
          },
          "replaces": {
            "type": "string",
            "description": "This record's own id, said to stand in for the record of that id in a library read before this one. Without it a second record of an id is an error."
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Candidate",
              "Approved",
              "Deprecated",
              "Retired"
            ]
          },
          "category": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "intent": {
            "type": "string"
          },
          "consequences": {
            "type": "string"
          },
          "when_not_to_use": {
            "type": "string"
          },
          "satisfies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
            },
            "description": "Controls in the register the pattern is designed to meet. An organization's own pattern may say; a shipped one does not, and `patterns` in model.yaml is where an estate says it of any pattern."
          },
          "owner_org_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
          },
          "decision_ref": {
            "type": "string"
          },
          "method_ref": {
            "type": "string",
            "description": "The method's reference pattern this one implements, by id (PAT-002)."
          }
        }
      }
    }
  ]
}
