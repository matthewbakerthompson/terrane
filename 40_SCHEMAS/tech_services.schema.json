            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "service_name": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "component_type": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "answers_for": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "product": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "cloud_provider": {
          "enum": [
            "AWS",
            "Azure",
            "GCP",
            "On-prem",
            "SaaS"
          ]
        },
        "cloud_account": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "network_zone": {
          "enum": [
            "Edge",
            "Public",
            "Private-App",
            "Private-Data",
            "Shared-Services",
            "On-prem"
          ]
        },
        "availability_zone": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "cidr": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "overrides": {
          "type": "object"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "without": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Parts of the shape this instance does without, by alias."
        },
        "modules": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "module"
                ],
                "properties": {
                  "module": {
                    "type": "string"
                  },
                  "as": {
                    "type": "string"
                  },
                  "optional": {
                    "type": "boolean"
                  },
                  "with": {
                    "type": "object",
                    "description": "Parameter name to value; a value may use the shape tokens."
                  }
                }
              }
            ]
          },
          "description": "Parts added to the shape, or re-bound, by this instance."
        },
        "choose": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Slot name to the option this instance chooses, or `none` for an optional slot."
        },
        "ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "An id the shape makes to the id the estate already uses for it, so a product moves onto a shape without renaming what points at it."
        },
        "extra": {
          "type": "object"
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modules"
          ],
          "description": "Assembled from parts with no shape: the parts under `modules`, the provider they resolve against, and the blocks, binds, patterns and relations a shape would carry. Not with `archetype`.",
