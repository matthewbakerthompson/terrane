            },
            "blocks": {
              "type": "array"
            },
            "bind": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "relations": {
              "type": "object"
            }
          }
        }
      },
