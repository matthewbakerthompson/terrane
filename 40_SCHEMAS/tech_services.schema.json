{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-as-code/schemas/tech_services.schema.json",
  "title": "Technology Service",
  "description": "A technology service, or a list of them in one file.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tech_service_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
        },
        "name": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "Proposed",
            "Planned",
            "Active",
            "Deprecated",
            "Retired"
          ]
        },
        "togaf_layer": {
          "enum": [
            "Business",
            "Application",
            "Data",
            "Technology"
          ]
        },
        "architecture_domain": {
          "enum": [
            "Business",
            "Application",
            "Data",
            "Technology",
            "Governance"
          ]
        },
        "abstraction_level": {
          "enum": [
            "Contextual",
            "Conceptual",
            "Logical",
            "Physical"
          ]
        },
        "last_reviewed": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "company_domain": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "company_subdomain": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "tags": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "archetype": {
          "type": "string"
        },
        "archetype_instance": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "module": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
