@startuml
' Merchant Portal — Architecture
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Merchant Portal — Architecture

AddElementTag("actors", $bgColor="#fde68a", $borderColor="#b45309", $fontColor="#0f172a", $legendText="actor")
AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("offered_interfaces", $bgColor="#e6ecff", $borderColor="#6366f1", $fontColor="#0f172a", $legendText="offered interface")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")
AddElementTag("tech_services", $bgColor="#fed7aa", $borderColor="#c2410c", $fontColor="#0f172a", $legendText="technology service")
AddRelTag("api-call", $legendText="API call")
AddRelTag("event", $legendText="Event on the bus")
AddRelTag("own-datastore", $legendText="Its own datastore")

Boundary(b_Azure, "Azure") {
  Deployment_Node(TS_AZURE_APIM, "Azure API Management", "API gateway", "The API gateway every internal and partner API is published through.", $tags="tech_services") {
    ' aac TS_AZURE_APIM: company_domain="Enterprise Platform"; technology="API gateway"
  }
  Deployment_Node(TS_AZURE_KEYVAULT, "Azure Key Vault", "Secrets manager", "Secret, key and certificate management.", $tags="tech_services") {
    ' aac TS_AZURE_KEYVAULT: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_AZURE_AKS, "Azure Kubernetes Service", "Container platform", "Managed Kubernetes hosting the containerized estate.", $tags="tech_services") {
    ' aac TS_AZURE_AKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Deployment_Node(TS_AZURE_MONITOR, "Azure Monitor", "Observability", "Metrics, logs and alerts for the Azure-hosted estate.", $tags="tech_services") {
    ' aac TS_AZURE_MONITOR: company_domain="Enterprise Platform"; technology="Observability"
  }
  Deployment_Node(TS_AZURE_SERVICEBUS, "Azure Service Bus", "Message queue", "Enterprise messaging backbone for domain events.", $tags="tech_services") {
    ' aac TS_AZURE_SERVICEBUS: company_domain="Enterprise Platform"; technology="Message queue"
  }
  Deployment_Node(TS_AZURE_SQL, "Azure SQL Database", "Relational database", "Managed relational database for operational datastores.", $tags="tech_services") {
    ' aac TS_AZURE_SQL: company_domain="Enterprise Platform"; technology="Relational database"
  }
  Boundary(b_Azure__azure_payments_prod, "subscription azure-payments-prod") {
    System(SYS_MERCHANT_EVENTS, "Merchant Portal Event Publisher", "Publishes Merchant Portal domain events onto the enterprise bus. Built with Service Bus.", $tags="systems")
    ' aac SYS_MERCHANT_EVENTS: company_domain="Payments"; hosting="Azure"; technology="Service Bus"
    Boundary(b_Azure__azure_payments_prod__Edge, "Edge") {
      Deployment_Node(TS_MERCHANT_DNS, "Merchant Portal DNS", "Azure DNS", "Name resolution and, in practice, the failover mechanism of last resort.", $tags="tech_services") {
        ' aac TS_MERCHANT_DNS: company_domain="Payments"; technology="Azure DNS"
      }
      Deployment_Node(TS_MERCHANT_WAF, "Merchant Portal Web application firewall", "Azure WAF", "Request inspection at the edge. Blocks the traffic nobody wrote a test for.", $tags="tech_services") {
        ' aac TS_MERCHANT_WAF: company_domain="Payments"; technology="Azure WAF"
      }
    }
    Boundary(b_Azure__azure_payments_prod__Private_App, "Private-App") {
      System(OI_MERCHANT_API, "Merchant Portal API", "The domain API Merchant Portal offers its channels, its jobs and its partners. Built with HTTPS.", $tags="offered_interfaces")
      ' aac OI_MERCHANT_API: company_domain="Payments"; technology="HTTPS"
      Deployment_Node(TS_MERCHANT_CACHE, "Merchant Portal Cache", "Azure Cache for Redis", "In-memory key-value store. Also, in most estates, an accidental database with no backup.", $tags="tech_services") {
        ' aac TS_MERCHANT_CACHE: company_domain="Payments"; technology="Azure Cache for Redis"
      }
      System(SYS_MERCHANT_API, "Merchant Portal Service", "Domain API for the merchant portal: applications, settlement inquiries, chargeback responses and statement downloads. Built with AKS · Merchant Portal Cache.", $tags="systems")
      ' aac SYS_MERCHANT_API: company_domain="Payments"; hosting="Azure"; technology="AKS · Merchant Portal Cache"
      System(SYS_MERCHANT_WEB, "Merchant Portal Web", "Customer-facing front end for Merchant Portal. Built with AKS.", $tags="systems")
      ' aac SYS_MERCHANT_WEB: company_domain="Payments"; hosting="Azure"; technology="AKS"
    }
    Boundary(b_Azure__azure_payments_prod__Private_Data, "Private-Data") {
      Deployment_Node(TS_MERCHANT_BACKUP, "Merchant Portal Backup and recovery", "Azure Backup", "Copies that survive the thing they came from. The recovery objective is a property of this, not of the database.", $tags="tech_services") {
        ' aac TS_MERCHANT_BACKUP: company_domain="Payments"; technology="Azure Backup"
      }
      System(SYS_MERCHANT_STORE, "Merchant Portal Database", "Relational database for Merchant Portal, encrypted with a customer managed key. Built with Azure SQL.", $tags="systems")
      ' aac SYS_MERCHANT_STORE: company_domain="Payments"; hosting="Azure"; technology="Azure SQL"
    }
  }
}
Person(ACT_MERCHANT_ONBOARDING_ANALYST, "Merchant Onboarding Analyst", "Reviews a merchant's application and the documents behind it before the account opens.", $tags="actors")
' aac ACT_MERCHANT_ONBOARDING_ANALYST: company_domain="Payments"; actor_kind="Role"; internal="Yes"
SystemDb(DA_MERCHANT_OPERATIONAL, "Merchant Portal operational data", "Operational records held by Merchant Portal.", $tags="data_assets")
' aac DA_MERCHANT_OPERATIONAL: company_domain="Payments"
Deployment_Node(TS_ENTRA_ID, "Microsoft Entra ID", "Identity provider", "Workforce and customer identity provider.", $tags="tech_services") {
  ' aac TS_ENTRA_ID: company_domain="Enterprise Platform"; technology="Identity provider"
}

Rel(SYS_MERCHANT_WEB, OI_MERCHANT_API, "Merchant Portal Web to API", "HTTPS", $tags="api-call")
' aac rel: source="SYS_MERCHANT_WEB"; target="OI_MERCHANT_API"; label="Merchant Portal Web to API"; interface_id="INT-MERCHANT-WEB-API"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"; offered_interface_id="OI-MERCHANT-API"
Rel(SYS_MERCHANT_API, SYS_MERCHANT_STORE, "Merchant Portal Service to Database", "TDS", $tags="own-datastore")
' aac rel: source="SYS_MERCHANT_API"; target="SYS_MERCHANT_STORE"; label="Merchant Portal Service to Database"; interface_id="INT-MERCHANT-API-STORE"; kind="own-datastore"; integration_style="Request-response"; frequency="Realtime"; direction="Outbound"
Rel(SYS_MERCHANT_API, SYS_MERCHANT_EVENTS, "Merchant Portal Service to Event Publisher", "AMQP", $tags="event")
' aac rel: source="SYS_MERCHANT_API"; target="SYS_MERCHANT_EVENTS"; label="Merchant Portal Service to Event Publisher"; interface_id="INT-MERCHANT-API-EVENTS"; kind="event"; integration_style="Event"; frequency="Realtime"; direction="Outbound"
Rel(SYS_MERCHANT_API, TS_AZURE_APIM, "runs on")
' aac rel: source="SYS_MERCHANT_API"; target="TS_AZURE_APIM"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_API, TS_AZURE_AKS, "runs on")
' aac rel: source="SYS_MERCHANT_API"; target="TS_AZURE_AKS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_API, TS_MERCHANT_CACHE, "runs on")
' aac rel: source="SYS_MERCHANT_API"; target="TS_MERCHANT_CACHE"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_API, TS_AZURE_MONITOR, "runs on")
' aac rel: source="SYS_MERCHANT_API"; target="TS_AZURE_MONITOR"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_API, TS_AZURE_KEYVAULT, "runs on")
' aac rel: source="SYS_MERCHANT_API"; target="TS_AZURE_KEYVAULT"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_WEB, TS_MERCHANT_DNS, "runs on")
' aac rel: source="SYS_MERCHANT_WEB"; target="TS_MERCHANT_DNS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_WEB, TS_MERCHANT_WAF, "runs on")
' aac rel: source="SYS_MERCHANT_WEB"; target="TS_MERCHANT_WAF"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_WEB, TS_AZURE_AKS, "runs on")
' aac rel: source="SYS_MERCHANT_WEB"; target="TS_AZURE_AKS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_WEB, TS_ENTRA_ID, "runs on")
' aac rel: source="SYS_MERCHANT_WEB"; target="TS_ENTRA_ID"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_STORE, TS_AZURE_SQL, "runs on")
' aac rel: source="SYS_MERCHANT_STORE"; target="TS_AZURE_SQL"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_STORE, TS_MERCHANT_BACKUP, "runs on")
' aac rel: source="SYS_MERCHANT_STORE"; target="TS_MERCHANT_BACKUP"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_STORE, TS_AZURE_KEYVAULT, "runs on")
' aac rel: source="SYS_MERCHANT_STORE"; target="TS_AZURE_KEYVAULT"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_EVENTS, TS_AZURE_SERVICEBUS, "runs on")
' aac rel: source="SYS_MERCHANT_EVENTS"; target="TS_AZURE_SERVICEBUS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCHANT_API, DA_MERCHANT_OPERATIONAL, "ReadWrite")
' aac rel: source="SYS_MERCHANT_API"; target="DA_MERCHANT_OPERATIONAL"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(ACT_MERCHANT_ONBOARDING_ANALYST, SYS_MERCHANT_API, "Reviews applications")
' aac rel: source="ACT_MERCHANT_ONBOARDING_ANALYST"; target="SYS_MERCHANT_API"; label="Reviews applications"; relation="actor_uses_system"; interaction="Reviews applications"
Rel(OI_MERCHANT_API, SYS_MERCHANT_API, "offered by")
' aac rel: source="OI_MERCHANT_API"; target="SYS_MERCHANT_API"; label="offered by"; field="system_id"

SHOW_LEGEND()
