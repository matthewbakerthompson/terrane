  }
  Deployment_Node(TS_AWS_RDS, "Amazon RDS for PostgreSQL", "Relational database", "Managed relational database, Multi-AZ, encrypted with a customer managed key.", $tags="tech_services") {
    ' aac TS_AWS_RDS: company_domain="Enterprise Platform"; technology="Relational database"
  }
  Deployment_Node(TS_AWS_KMS, "AWS KMS", "Key management", "Customer managed keys for data at rest.", $tags="tech_services") {
