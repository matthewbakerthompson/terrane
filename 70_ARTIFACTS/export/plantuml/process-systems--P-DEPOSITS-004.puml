@startuml
' Settle brokered CDs and keep the position — Systems, Data and Controls
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Settle brokered CDs and keep the position — Systems, Data and Controls

AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("controls", $bgColor="#fca5a5", $borderColor="#b91c1c", $fontColor="#0f172a", $legendText="control")
AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_DEP_03, "Brokered CD Program Management", "Issue and administer CDs through broker-dealer networks: allocations, settlement, and broker relationships. A primary funding channel.", $tags="capabilities")
  ' aac CAP_DEP_03: company_domain="Deposits"
  System(CAP_DEP_03_02, "Brokered CD Settlement & Record Keeping", "Settle issues through the depository, keep the position, and keep the pass-through records insurance coverage depends on.", $tags="capabilities")
  ' aac CAP_DEP_03_02: company_domain="Deposits"
}
Boundary(b_Control, "Control") {
  System(CTL_BROKERED_RECON, "Brokered deposit position reconciliation", "The brokered CD position is reconciled daily to the depository and the brokers' allocations, and breaks are cleared.", $tags="controls")
  ' aac CTL_BROKERED_RECON: company_domain=""
}
Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_DEPOSIT_ACCOUNT, "Deposit account and CD record", "Depositor identity and ownership category, account terms, rate, interest accrued, maturity and instructions.", $tags="data_assets")
  ' aac DA_DEPOSIT_ACCOUNT: company_domain=""
  SystemDb(DA_GL, "General ledger entries", "Posted financial entries, settlement and reconciliation balances.", $tags="data_assets")
  ' aac DA_GL: company_domain=""
}
Boundary(b_Process, "Process") {
  System(P_DEPOSITS_004, "Settle brokered CDs and keep the position", "Settle each brokered issue through the depository against the brokers' allocations, record the CD position, and pay interest and maturities through the same channel, reconciling to the brokers' records. The underlying depositors are the brokers' customers, so their insurance coverage depends on the pass-through records kept here.", $tags="processes")
  ' aac P_DEPOSITS_004: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_BROKER_GW, "Brokered deposit settlement gateway", "Exchanges brokered CD issuance, allocation and position files with the broker-dealers and the depository.", $tags="systems")
  ' aac SYS_BROKER_GW: company_domain=""
  System(SYS_DEPOSIT, "Deposit platform", "System of record for CDs and savings: opening, interest accrual, maturities, early withdrawal and tax reporting.", $tags="systems")
  ' aac SYS_DEPOSIT: company_domain=""
  System(SYS_GL, "General ledger", "General ledger and financial accounting.", $tags="systems")
  ' aac SYS_GL: company_domain=""
  System(SYS_RECON, "Reconciliation platform", "Automated reconciliation and exception management.", $tags="systems")
  ' aac SYS_RECON: company_domain=""
}

Rel(P_DEPOSITS_004, SYS_DEPOSIT, "Primary")
' aac rel: source="P_DEPOSITS_004"; target="SYS_DEPOSIT"; label="Primary"; relation="process_uses_system"; role="Primary"
Rel(P_DEPOSITS_004, SYS_BROKER_GW, "Supporting")
' aac rel: source="P_DEPOSITS_004"; target="SYS_BROKER_GW"; label="Supporting"; relation="process_uses_system"; role="Supporting"
Rel(P_DEPOSITS_004, SYS_RECON, "Supporting")
' aac rel: source="P_DEPOSITS_004"; target="SYS_RECON"; label="Supporting"; relation="process_uses_system"; role="Supporting"
Rel(P_DEPOSITS_004, SYS_GL, "Supporting")
' aac rel: source="P_DEPOSITS_004"; target="SYS_GL"; label="Supporting"; relation="process_uses_system"; role="Supporting"
Rel(P_DEPOSITS_004, DA_DEPOSIT_ACCOUNT, "Both")
' aac rel: source="P_DEPOSITS_004"; target="DA_DEPOSIT_ACCOUNT"; label="Both"; relation="process_uses_data_asset"; access="Both"
Rel(P_DEPOSITS_004, DA_GL, "Write")
' aac rel: source="P_DEPOSITS_004"; target="DA_GL"; label="Write"; relation="process_uses_data_asset"; access="Write"
Rel(P_DEPOSITS_004, CTL_BROKERED_RECON, "governed by")
' aac rel: source="P_DEPOSITS_004"; target="CTL_BROKERED_RECON"; label="governed by"; relation="process_governed_by_control"
Rel(P_DEPOSITS_004, CAP_DEP_03_02, "supports")
' aac rel: source="P_DEPOSITS_004"; target="CAP_DEP_03_02"; label="supports"; relation="process_supports_capability"
Rel(P_DEPOSITS_004, CAP_DEP_03, "supports")
' aac rel: source="P_DEPOSITS_004"; target="CAP_DEP_03"; label="supports"; relation="process_supports_capability"

SHOW_LEGEND()
@enduml
