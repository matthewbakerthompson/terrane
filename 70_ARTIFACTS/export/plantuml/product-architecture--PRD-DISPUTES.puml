@startuml
' Dispute Management — Architecture
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Dispute Management — Architecture

AddElementTag("actors", $bgColor="#fde68a", $borderColor="#b45309", $fontColor="#0f172a", $legendText="actor")
AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")
AddElementTag("tech_services", $bgColor="#fed7aa", $borderColor="#c2410c", $fontColor="#0f172a", $legendText="technology service")
AddRelTag("api-call", $legendText="API call")
AddRelTag("partner-file", $legendText="Partner file")
AddRelTag("scheduled-file", $legendText="Scheduled file")

Boundary(b_Azure, "Azure") {
  Deployment_Node(TS_AZURE_APIM, "Azure API Management", "API gateway", "The API gateway every internal and partner API is published through.", $tags="tech_services") {
    ' aac TS_AZURE_APIM: company_domain="Enterprise Platform"; technology="API gateway"
  }
  Deployment_Node(TS_AZURE_KEYVAULT, "Azure Key Vault", "Secrets manager", "Secret, key and certificate management.", $tags="tech_services") {
    ' aac TS_AZURE_KEYVAULT: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_AZURE_AKS, "Azure Kubernetes Service", "Container platform", "Managed Kubernetes hosting the containerized estate.", $tags="tech_services") {
    ' aac TS_AZURE_AKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Boundary(b_Azure__azure_cards_prod, "subscription azure-cards-prod") {
    Boundary(b_Azure__azure_cards_prod__Private_App, "Private-App") {
      System(SYS_DISPUTES_GATEWAY, "Dispute Management Platform Integration Gateway", "Our side of the Pegasystems integration: mapping, retry and audit. Built with AKS.", $tags="systems")
      ' aac SYS_DISPUTES_GATEWAY: company_domain="Servicing"; hosting="Azure"; technology="AKS"
    }
  }
  Boundary(b_Azure__azure_data_prod, "subscription azure-data-prod") {
    Boundary(b_Azure__azure_data_prod__Private_Data, "Private-Data") {
      System(SYS_DATA_INGEST, "Enterprise Data Ingestion Hub", "Landing zone and ingestion orchestration for inbound file and event feeds before they reach the warehouse. Built with Service Bus · Snowflake Data Cloud.", $tags="systems")
      ' aac SYS_DATA_INGEST: company_domain="Data and Analytics"; hosting="Azure"; technology="Service Bus · Snowflake Data Cloud"
    }
  }
}
Boundary(b_On_prem, "On-prem") {
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
}
Boundary(b_SaaS, "SaaS") {
  Boundary(b_SaaS__Edge, "Edge") {
    System_Ext(SYS_CRM, "Dynamics 365 Customer Service", "Contact center desktop and case management for servicing agents. Built with Microsoft.", $tags="systems")
    ' aac SYS_CRM: company_domain="Servicing"; hosting="SaaS"; technology="Microsoft"
    System_Ext(SYS_DISPUTES_SAAS, "Pega Smart Dispute", "Dispute Management Platform, provided by Pegasystems and running in the vendor tenancy. Built with Pegasystems.", $tags="systems")
    ' aac SYS_DISPUTES_SAAS: company_domain="Servicing"; hosting="SaaS"; technology="Pegasystems"
  }
}
SystemDb(DA_DISPUTES_VENDOR_FEED, "Dispute Management Platform vendor feed", "Landed vendor extract from Pegasystems.", $tags="data_assets")
' aac DA_DISPUTES_VENDOR_FEED: company_domain="Servicing"
Person(ACT_SERVICING_AGENT, "Servicing Agent", "Contact center staff handling balance, dispute and account queries.", $tags="actors")
' aac ACT_SERVICING_AGENT: company_domain="Servicing"; actor_kind="Role"; internal="Yes"

Rel(SYS_CRM, SYS_DISPUTES_GATEWAY, "CRM to Dispute Gateway", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CRM"; target="SYS_DISPUTES_GATEWAY"; label="CRM to Dispute Gateway"; interface_id="INT-CRM-DISPUTES"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"; patterns="private-egress-to-saas"
Rel(SYS_CRM, SYS_CORE_LEDGER, "Servicing CRM to Core Ledger", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CRM"; target="SYS_CORE_LEDGER"; label="Servicing CRM to Core Ledger"; interface_id="INT-CRM-LEDGER"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CORE_LEDGER, SYS_DATA_INGEST, "Core Ledger to Data Ingestion Hub", "FileTransfer", $tags="scheduled-file")
' aac rel: source="SYS_CORE_LEDGER"; target="SYS_DATA_INGEST"; label="Core Ledger to Data Ingestion Hub"; interface_id="INT-LEDGER-INGEST"; kind="scheduled-file"; integration_style="Batch"; auth_method="KeyPair"; frequency="Daily"; direction="Outbound"
Rel(SYS_CORE_LEDGER, SYS_DISPUTES_GATEWAY, "SYS-CORE-LEDGER to Dispute Management Platform Gateway", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CORE_LEDGER"; target="SYS_DISPUTES_GATEWAY"; label="SYS-CORE-LEDGER to Dispute Management Platform Gateway"; interface_id="INT-DISPUTES-UP-GATEWAY"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"
Rel(SYS_DISPUTES_GATEWAY, SYS_DISPUTES_SAAS, "Dispute Management Platform Gateway to Pegasystems", "HTTPS", $tags="api-call")
' aac rel: source="SYS_DISPUTES_GATEWAY"; target="SYS_DISPUTES_SAAS"; label="Dispute Management Platform Gateway to Pegasystems"; interface_id="INT-DISPUTES-GATEWAY-SAAS"; kind="api-call"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"
Rel(SYS_DISPUTES_SAAS, SYS_DATA_INGEST, "Pegasystems return feed", "SFTP", $tags="partner-file")
' aac rel: source="SYS_DISPUTES_SAAS"; target="SYS_DATA_INGEST"; label="Pegasystems return feed"; interface_id="INT-DISPUTES-SAAS-FEED"; kind="partner-file"; integration_style="Batch"; auth_method="KeyPair"; frequency="Daily"; direction="Inbound"
Rel(SYS_DISPUTES_GATEWAY, TS_AZURE_AKS, "runs on")
' aac rel: source="SYS_DISPUTES_GATEWAY"; target="TS_AZURE_AKS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_DISPUTES_GATEWAY, TS_AZURE_APIM, "runs on")
' aac rel: source="SYS_DISPUTES_GATEWAY"; target="TS_AZURE_APIM"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_DISPUTES_GATEWAY, TS_AZURE_KEYVAULT, "runs on")
' aac rel: source="SYS_DISPUTES_GATEWAY"; target="TS_AZURE_KEYVAULT"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_DISPUTES_SAAS, DA_DISPUTES_VENDOR_FEED, "Write")
' aac rel: source="SYS_DISPUTES_SAAS"; target="DA_DISPUTES_VENDOR_FEED"; label="Write"; relation="system_reads_writes"; operation="Write"
Rel(SYS_DATA_INGEST, DA_DISPUTES_VENDOR_FEED, "Read")
' aac rel: source="SYS_DATA_INGEST"; target="DA_DISPUTES_VENDOR_FEED"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(ACT_SERVICING_AGENT, SYS_CRM, "Handles cases")
' aac rel: source="ACT_SERVICING_AGENT"; target="SYS_CRM"; label="Handles cases"; relation="actor_uses_system"; interaction="Handles cases"
Rel(ACT_SERVICING_AGENT, SYS_DISPUTES_SAAS, "Raises disputes")
' aac rel: source="ACT_SERVICING_AGENT"; target="SYS_DISPUTES_SAAS"; label="Raises disputes"; relation="actor_uses_system"; interaction="Raises disputes"

SHOW_LEGEND()
@enduml
