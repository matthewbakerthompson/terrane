' aac rel: source="P_COLLECTIONS_005"; target="DA_BUREAU_FILE"; label="Writes"; relation="process_uses_data_asset"; access="Writes"
Rel(P_COLLECTIONS_005, CTL_BUREAU_ACC, "governed by")
' aac rel: source="P_COLLECTIONS_005"; target="CTL_BUREAU_ACC"; label="governed by"; relation="process_governed_by_control"
