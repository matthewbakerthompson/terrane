AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_BILL_01, "Interest & Fee Assessment", "Calculate interest, fees, and minimum payment.", $tags="capabilities")
  ' aac CAP_BILL_01: company_domain="Servicing"
}
Boundary(b_Control, "Control") {
  System(CTL_CYCLE_VALID, "Cycle assessment validation", "Interest, fee, and minimum-payment computation is validated against the cardholder agreement on every pricing or product change, and sampled each cycle.", $tags="controls")
  ' aac CTL_CYCLE_VALID: company_domain=""
}
Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_TRANSACTION, "Card transaction history", "Authorized, cleared and settled card transactions.", $tags="data_assets")
  ' aac DA_TRANSACTION: company_domain="Payments"
  SystemDb(DA_CUSTOMER_PROFILE, "Customer profile", "Contact details, preferences and servicing history.", $tags="data_assets")
  ' aac DA_CUSTOMER_PROFILE: company_domain="Servicing"
}
Boundary(b_Process, "Process") {
  System(P_SERVICING_001, "Assess interest, fees, and minimum payment", "Calculate interest, fees, and the minimum payment due for the billing cycle. Cycle assessment applies the cardholder agreement exactly: interest method, fee triggers, and minimum-payment formula, because a systematic error here is a remediation event.", $tags="processes")
  ' aac P_SERVICING_001: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
}

Rel(P_SERVICING_001, SYS_CORE_LEDGER, "Primary")
' aac rel: source="P_SERVICING_001"; target="SYS_CORE_LEDGER"; label="Primary"; relation="process_uses_system"; role="Primary"
