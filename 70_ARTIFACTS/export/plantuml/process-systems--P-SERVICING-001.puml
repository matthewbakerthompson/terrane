Rel(P_SERVICING_001, DA_TRANSACTION, "Both")
' aac rel: source="P_SERVICING_001"; target="DA_TRANSACTION"; label="Both"; relation="process_uses_data_asset"; access="Both"
Rel(P_SERVICING_001, CTL_CYCLE_VALID, "governed by")
' aac rel: source="P_SERVICING_001"; target="CTL_CYCLE_VALID"; label="governed by"; relation="process_governed_by_control"
Rel(P_SERVICING_001, CAP_BILL_01, "supports")
' aac rel: source="P_SERVICING_001"; target="CAP_BILL_01"; label="supports"; relation="process_supports_capability"

