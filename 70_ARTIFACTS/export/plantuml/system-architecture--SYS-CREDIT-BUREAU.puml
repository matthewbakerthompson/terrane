@startuml
' Experian Credit Bureau — Architecture
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Experian Credit Bureau — Architecture

AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")
AddElementTag("tech_services", $bgColor="#fed7aa", $borderColor="#c2410c", $fontColor="#0f172a", $legendText="technology service")
AddRelTag("api-call", $legendText="API call")
AddRelTag("scheduled-file", $legendText="Scheduled file")

Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_BUREAU_FILE, "Credit bureau furnishing file", "Monthly tradeline furnishing extract and consumer-dispute responses.", $tags="data_assets")
  ' aac DA_BUREAU_FILE: company_domain=""
  SystemDb(DA_DISPUTE_CASE, "Dispute case file", "Claims, evidence, correspondence, timers, and determinations for error resolution.", $tags="data_assets")
  ' aac DA_DISPUTE_CASE: company_domain=""
  SystemDb(DA_LENDING_OPERATIONAL, "Installment Lending operational data", "Operational records held by Installment Lending.", $tags="data_assets")
  ' aac DA_LENDING_OPERATIONAL: company_domain="Lending"
}
Boundary(b_System, "System") {
  System(SYS_BUREAU_GW, "Credit bureau gateway", "Credit bureau furnishing and consumer dispute exchange.", $tags="systems")
  ' aac SYS_BUREAU_GW: company_domain=""
  System_Ext(SYS_CREDIT_BUREAU, "Experian Credit Bureau", "External credit reference agency used for affordability and bureau search at application time. Reached over PrivateLink from the lending workload account. Built with Experian.", $tags="systems")
  ' aac SYS_CREDIT_BUREAU: company_domain="Risk and Compliance"; hosting="SaaS"; technology="Experian"
  System(SYS_LENDING_HUB, "Installment Lending Integration Hub", "Mediates every Installment Lending integration: one place for mapping, routing, retry and the audit trail, so the spokes do not each carry their own.", $tags="systems")
  ' aac SYS_LENDING_HUB: company_domain="Lending"; hosting="AWS"
  System(SYS_LENDING_API, "Installment Lending Service", "Domain service for Installment Lending, behind the Installment Lending API. Built with EKS · Installment Lending Cache.", $tags="systems")
  ' aac SYS_LENDING_API: company_domain="Lending"; hosting="AWS"; technology="EKS · Installment Lending Cache"
}
Boundary(b_Technology_Service, "Technology Service") {
  Deployment_Node(TS_AWS_CLOUDWATCH, "Amazon CloudWatch", "Observability", "Metrics, logs and alarms for every workload in the landing zone.", $tags="tech_services") {
    ' aac TS_AWS_CLOUDWATCH: company_domain="Enterprise Platform"; technology="Observability"
  }
  Deployment_Node(TS_AWS_EKS, "Amazon EKS", "Container platform", "Managed Kubernetes running the containerized workloads.", $tags="tech_services") {
    ' aac TS_AWS_EKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Deployment_Node(TS_AWS_PRIVATELINK, "AWS PrivateLink", "Private egress", "Private egress to partner and vendor endpoints without internet transit.", $tags="tech_services") {
    ' aac TS_AWS_PRIVATELINK: company_domain="Enterprise Platform"; technology="Private egress"
  }
  Deployment_Node(TS_AWS_SECRETS, "AWS Secrets Manager", "Secrets manager", "Application credentials and rotation.", $tags="tech_services") {
    ' aac TS_AWS_SECRETS: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_LENDING_CACHE, "Installment Lending Cache", "Amazon ElastiCache", "In-memory key-value store. Also, in most estates, an accidental database with no backup.", $tags="tech_services") {
    ' aac TS_LENDING_CACHE: company_domain="Lending"; technology="Amazon ElastiCache"
  }
  Deployment_Node(TS_NET_SUB_LEND_APP_A, "Lending App Subnet A", "Subnet", $tags="tech_services") {
    ' aac TS_NET_SUB_LEND_APP_A: company_domain="Lending"; technology="Subnet"
  }
  Deployment_Node(TS_NET_SUB_LEND_APP_B, "Lending App Subnet B", "Subnet", $tags="tech_services") {
    ' aac TS_NET_SUB_LEND_APP_B: company_domain="Lending"; technology="Subnet"
  }
}

Rel(SYS_BUREAU_GW, SYS_CREDIT_BUREAU, "Credit Bureau Gateway to Credit Bureau", "FileTransfer", $tags="scheduled-file")
' aac rel: source="SYS_BUREAU_GW"; target="SYS_CREDIT_BUREAU"; label="Credit Bureau Gateway to Credit Bureau"; interface_id="INT-BUREAU-GW-BUREAU"; kind="scheduled-file"; integration_style="Batch"; auth_method="KeyPair"; frequency="Monthly"; direction="Outbound"; patterns="regulatory-file-furnishing"
Rel(SYS_LENDING_API, SYS_CREDIT_BUREAU, "Installment Lending Service to Credit Bureau", "HTTPS", $tags="api-call")
' aac rel: source="SYS_LENDING_API"; target="SYS_CREDIT_BUREAU"; label="Installment Lending Service to Credit Bureau"; interface_id="INT-LENDING-API-BUREAU"; kind="api-call"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CREDIT_BUREAU, SYS_LENDING_HUB, "CREDIT-BUREAU via Installment Lending hub", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CREDIT_BUREAU"; target="SYS_LENDING_HUB"; label="CREDIT-BUREAU via Installment Lending hub"; interface_id="INT-LENDING-CREDIT-BUREAU-HUB"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_LENDING_API, TS_AWS_EKS, "runs on")
' aac rel: source="SYS_LENDING_API"; target="TS_AWS_EKS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_LENDING_API, TS_LENDING_CACHE, "runs on")
' aac rel: source="SYS_LENDING_API"; target="TS_LENDING_CACHE"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_LENDING_API, TS_AWS_CLOUDWATCH, "runs on")
' aac rel: source="SYS_LENDING_API"; target="TS_AWS_CLOUDWATCH"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_LENDING_API, TS_AWS_SECRETS, "runs on")
' aac rel: source="SYS_LENDING_API"; target="TS_AWS_SECRETS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_LENDING_API, TS_AWS_PRIVATELINK, "runs on")
' aac rel: source="SYS_LENDING_API"; target="TS_AWS_PRIVATELINK"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_LENDING_API, TS_NET_SUB_LEND_APP_A, "runs on")
' aac rel: source="SYS_LENDING_API"; target="TS_NET_SUB_LEND_APP_A"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_LENDING_API, TS_NET_SUB_LEND_APP_B, "runs on")
' aac rel: source="SYS_LENDING_API"; target="TS_NET_SUB_LEND_APP_B"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_LENDING_API, DA_LENDING_OPERATIONAL, "ReadWrite")
' aac rel: source="SYS_LENDING_API"; target="DA_LENDING_OPERATIONAL"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(SYS_BUREAU_GW, DA_BUREAU_FILE, "ReadWrite")
' aac rel: source="SYS_BUREAU_GW"; target="DA_BUREAU_FILE"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(SYS_BUREAU_GW, DA_DISPUTE_CASE, "Read")
' aac rel: source="SYS_BUREAU_GW"; target="DA_DISPUTE_CASE"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_CREDIT_BUREAU, DA_BUREAU_FILE, "Read")
' aac rel: source="SYS_CREDIT_BUREAU"; target="DA_BUREAU_FILE"; label="Read"; relation="system_reads_writes"; operation="Read"

SHOW_LEGEND()
@enduml
