' aac rel: source="SYS_CORE_LEDGER"; target="DA_PAYMENT_INSTR"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_LOAN_SVC, DA_PAYMENT_INSTR, "Read")
' aac rel: source="SYS_LOAN_SVC"; target="DA_PAYMENT_INSTR"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(P_CARD_PMT_001, DA_PAYMENT_INSTR, "Both")
' aac rel: source="P_CARD_PMT_001"; target="DA_PAYMENT_INSTR"; label="Both"; relation="process_uses_data_asset"; access="Both"
Rel(P_PAYMENTS_002, DA_PAYMENT_INSTR, "Reads")
' aac rel: source="P_PAYMENTS_002"; target="DA_PAYMENT_INSTR"; label="Reads"; relation="process_uses_data_asset"; access="Reads"
Rel(P_LENDING_009, DA_PAYMENT_INSTR, "Read")
' aac rel: source="P_LENDING_009"; target="DA_PAYMENT_INSTR"; label="Read"; relation="process_uses_data_asset"; access="Read"
Rel(P_LENDING_017, DA_PAYMENT_INSTR, "Read")
' aac rel: source="P_LENDING_017"; target="DA_PAYMENT_INSTR"; label="Read"; relation="process_uses_data_asset"; access="Read"
Rel(P_PAYMENTS_008, DA_PAYMENT_INSTR, "Both")
' aac rel: source="P_PAYMENTS_008"; target="DA_PAYMENT_INSTR"; label="Both"; relation="process_uses_data_asset"; access="Both"
Rel(P_PAYMENTS_009, DA_PAYMENT_INSTR, "Write")
' aac rel: source="P_PAYMENTS_009"; target="DA_PAYMENT_INSTR"; label="Write"; relation="process_uses_data_asset"; access="Write"
Rel(P_PAYMENTS_010, DA_PAYMENT_INSTR, "Read")
' aac rel: source="P_PAYMENTS_010"; target="DA_PAYMENT_INSTR"; label="Read"; relation="process_uses_data_asset"; access="Read"
Rel(P_FRAUD_007, DA_PAYMENT_INSTR, "Read")
