@startuml
' Third-Party Servicing Delivery — Frameworks, Controls, Systems
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Third-Party Servicing Delivery — Frameworks, Controls, Systems

AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("controls", $bgColor="#fca5a5", $borderColor="#b91c1c", $fontColor="#0f172a", $legendText="control")
AddElementTag("frameworks", $bgColor="#d9f99d", $borderColor="#4d7c0f", $fontColor="#0f172a", $legendText="framework")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_TPS_05, "Client Audit & Oversight Support", "Support client and client-regulator oversight activity.", $tags="capabilities")
  ' aac CAP_TPS_05: company_domain="Cross-Functional Services"
  System(CAP_TPS_04, "Client Billing & Revenue Management", "Bill servicing fees and manage revenue recognition.", $tags="capabilities")
  ' aac CAP_TPS_04: company_domain="Cross-Functional Services"
  System(CAP_TPS_01, "Client Program Configuration & Setup", "Configure platform, product, and treatment for a client program.", $tags="capabilities")
  ' aac CAP_TPS_01: company_domain="Cross-Functional Services"
  System(CAP_TPS_03, "Client Reporting & Data Exchange", "Deliver contracted reporting and data feeds to clients.", $tags="capabilities")
  ' aac CAP_TPS_03: company_domain="Cross-Functional Services"
  System(CAP_TPS_06, "Client-Directed Change Management", "Intake, price, and deliver client-requested change.", $tags="capabilities")
  ' aac CAP_TPS_06: company_domain="Cross-Functional Services"
  System(CAP_TPS_02, "Portfolio Conversion & Deconversion", "Convert client portfolios onto and off the servicing platform.", $tags="capabilities")
  ' aac CAP_TPS_02: company_domain="Cross-Functional Services"
  System(CAP_TPS, "Third-Party Servicing Delivery", "Third-Party Servicing Delivery. Level 0 enterprise capability domain (Core tier).", $tags="capabilities")
  ' aac CAP_TPS: company_domain="Cross-Functional Services"
}
Boundary(b_Control, "Control") {
  System(CTL_CLIENT_SLA, "Client reporting and feed monitoring", "Contracted client reporting and data feeds are monitored to schedule and specification; misses alert before the client notices and count against the SLA.", $tags="controls")
  ' aac CTL_CLIENT_SLA: company_domain=""
  System(CTL_CONV_VERIFY, "Conversion balance and record verification", "Portfolio conversions verify record counts, balances, and regulatory continuity before and after cutover, with client sign-off at each gate.", $tags="controls")
  ' aac CTL_CONV_VERIFY: company_domain=""
}
Boundary(b_Framework, "Framework") {
  System(FW_BIAN, "BIAN", "The Banking Industry Architecture Network's service landscape. A reference model of banking service domains, organized into business areas. Strong on what a bank does and deliberately silent on how it is run.", $tags="frameworks")
  ' aac FW_BIAN: company_domain=""
  System(FW_DMBOK, "DAMA-DMBOK", "The data management body of knowledge: governance, quality, architecture, metadata, master data, security. The only one of these with a defensible account of what a data function is responsible for.", $tags="frameworks")
  ' aac FW_DMBOK: company_domain=""
  System(FW_ITIL, "ITIL 4", "Service management practice: incident, change, problem, service level. The frame technology operations is actually run and audited against, and the vocabulary a service management tool already speaks.", $tags="frameworks")
  ' aac FW_ITIL: company_domain=""
}
Boundary(b_Process, "Process") {
  System(P_TPS_006, "Bill client servicing fees", "Calculate and invoice servicing fees per the contract and recognize the revenue. Fee billing calculates from contracted schedules against actual volumes; invoices carry the detail clients audit, and revenue recognition follows the contract.", $tags="processes")
  ' aac P_TPS_006: company_domain=""
  System(P_TPS_001, "Configure client program", "Configure platform, product, treatment, and reporting for a new client program. Program configuration translates the client contract into platform, product, treatment, and reporting settings; every setting traces to a contract clause or a documented default.", $tags="processes")
  ' aac P_TPS_001: company_domain=""
  System(P_TPS_002, "Convert client portfolio", "Migrate a client portfolio onto the servicing platform with reconciled balances and no cardholder disruption.", $tags="processes")
  ' aac P_TPS_002: company_domain=""
  System(P_TPS_003, "Deconvert client portfolio", "Migrate a client portfolio off the servicing platform and hand over records. Deconversion hands a portfolio off with data, documents, and cutover timing per contract; the obligation to do it well survives the relationship ending.", $tags="processes")
  ' aac P_TPS_003: company_domain=""
  System(P_TPS_005, "Exchange client data feed", "Send and receive contracted data feeds with the client on schedule. Data feeds run both directions on contracted schedules with schema and quality checks at the boundary; feed failures page, because clients reconcile against them.", $tags="processes")
  ' aac P_TPS_005: company_domain=""
  System(P_TPS_008, "Intake and deliver client-directed change", "Receive, price, approve, and deliver a change requested by a servicing client. Client-directed changes are priced, approved, and delivered under the contract's change provisions; scope discipline here is what keeps serviced portfolios profitable.", $tags="processes")
  ' aac P_TPS_008: company_domain=""
  System(P_TPS_004, "Produce contracted client reporting", "Produce and deliver reporting to the schedule and specification in the client contract. Contracted reporting ships to specification and schedule; late or wrong reporting is an SLA breach with credits, so production is monitored like any critical batch.", $tags="processes")
  ' aac P_TPS_004: company_domain=""
  System(P_TPS_007, "Support client audit or examination", "Assemble evidence and respond to client and client-regulator oversight requests. Client audits and client-regulator exams get coordinated evidence with the same discipline as the bank's own exams; commitments made in responses are tracked.", $tags="processes")
  ' aac P_TPS_007: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
  System(SYS_GL, "General ledger", "General ledger and financial accounting.", $tags="systems")
  ' aac SYS_GL: company_domain=""
  System(SYS_GRC, "Governance, risk and compliance platform", "Policy, control, issue, and risk register management.", $tags="systems")
  ' aac SYS_GRC: company_domain=""
  System(SYS_CLIENT_PORTAL, "Servicing client portal", "Client reporting, data exchange, and interaction.", $tags="systems")
  ' aac SYS_CLIENT_PORTAL: company_domain=""
  System_Ext(SYS_WORKTRACK, "Work and change tracking", "Work item and change tracking. Built with SaaS.", $tags="systems")
  ' aac SYS_WORKTRACK: company_domain=""; hosting="SaaS"; technology="SaaS"
}

