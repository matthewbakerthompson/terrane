@startuml
' Process Landscape
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Process Landscape

AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")

Boundary(b_Client_Opportunity_to_Live_Program, "Client Opportunity to Live Program") {
  System(P_TPS_006, "Bill client servicing fees", "Calculate and invoice servicing fees per the contract and recognize the revenue. Fee billing calculates from contracted schedules against actual volumes; invoices carry the detail clients audit, and revenue recognition follows the contract.", $tags="processes")
  ' aac P_TPS_006: company_domain=""
  System(P_TPS_001, "Configure client program", "Configure platform, product, treatment, and reporting for a new client program. Program configuration translates the client contract into platform, product, treatment, and reporting settings; every setting traces to a contract clause or a documented default.", $tags="processes")
  ' aac P_TPS_001: company_domain=""
  System(P_TPS_002, "Convert client portfolio", "Migrate a client portfolio onto the servicing platform with reconciled balances and no cardholder disruption.", $tags="processes")
  ' aac P_TPS_002: company_domain=""
  System(P_TPS_003, "Deconvert client portfolio", "Migrate a client portfolio off the servicing platform and hand over records. Deconversion hands a portfolio off with data, documents, and cutover timing per contract; the obligation to do it well survives the relationship ending.", $tags="processes")
  ' aac P_TPS_003: company_domain=""
  System(P_TPS_005, "Exchange client data feed", "Send and receive contracted data feeds with the client on schedule. Data feeds run both directions on contracted schedules with schema and quality checks at the boundary; feed failures page, because clients reconcile against them.", $tags="processes")
  ' aac P_TPS_005: company_domain=""
  System(P_TPS_008, "Intake and deliver client-directed change", "Receive, price, approve, and deliver a change requested by a servicing client. Client-directed changes are priced, approved, and delivered under the contract's change provisions; scope discipline here is what keeps serviced portfolios profitable.", $tags="processes")
  ' aac P_TPS_008: company_domain=""
  System(P_TPS_004, "Produce contracted client reporting", "Produce and deliver reporting to the schedule and specification in the client contract. Contracted reporting ships to specification and schedule; late or wrong reporting is an SLA breach with credits, so production is monitored like any critical batch.", $tags="processes")
  ' aac P_TPS_004: company_domain=""
  System(P_TPS_007, "Support client audit or examination", "Assemble evidence and respond to client and client-regulator oversight requests. Client audits and client-regulator exams get coordinated evidence with the same discipline as the bank's own exams; commitments made in responses are tracked.", $tags="processes")
  ' aac P_TPS_007: company_domain=""
}
Boundary(b_Concept_to_Market, "Concept to Market") {
  System(P_PRODUCT_002, "Author and version disclosure", "Author, review, approve, and version cardholder agreements and disclosures. Agreements and disclosures are versioned with effective dates; every account references the version it was disclosed under, which is what makes remediation tractable.", $tags="processes")
  ' aac P_PRODUCT_002: company_domain=""
  System(P_PRODUCT_001, "Design and approve product change", "Define, price, and obtain approval for a change to a card product. A product change binds pricing, terms, and eligibility; approval spans product, credit, finance, legal, and compliance before configuration starts.", $tags="processes")
  ' aac P_PRODUCT_001: company_domain=""
  System(P_PRODUCT_003, "Launch product to market", "Configure, test, and release a product for origination across all affected systems. Launch is a coordinated configuration across origination, core, servicing, and statements, verified in test before the product opens to volume.", $tags="processes")
  ' aac P_PRODUCT_003: company_domain=""
  System(P_PRODUCT_004, "Retire or migrate product", "Sunset a product and migrate affected accounts with required notice. Retirement manages the migration and notices for live accounts; terms changes ride the change-in-terms rules, and the product stays resolvable for history.", $tags="processes")
  ' aac P_PRODUCT_004: company_domain=""
}
Boundary(b_Delinquency_to_Recovery, "Delinquency to Recovery") {
  System(P_COLLECTIONS_001, "Assign delinquency treatment strategy", "Segment delinquent accounts and assign the contact and treatment strategy. Runs nightly after delinquency bucketing; the strategy drives queue, channel, intensity, and hardship routing, and a wrong assignment is a conduct risk as much as a loss risk.", $tags="processes")
  ' aac P_COLLECTIONS_001: company_domain=""
  System(P_DELQ_001, "Detect and bucket delinquent account", "Identify accounts that have missed a payment and assign them to the correct delinquency bucket. Bucketing runs in the nightly cycle and is the trigger for every downstream collections treatment; a bucketing error propagates into contact, reporting, and accounting.", $tags="processes")
  ' aac P_DELQ_001: company_domain=""
  System(P_SERVICING_008, "Enroll account in hardship or assistance program", "Assess eligibility and enroll an account into a hardship or payment assistance program. Hardship enrollment applies documented eligibility consistently; program terms change interest, fees, and reporting, so enrollment is evidenced and reviewed.", $tags="processes")
  ' aac P_SERVICING_008: company_domain=""
  System(P_COLLECTIONS_004, "Execute charge-off", "Execute charge-off on policy timing and record the accounting effect. Timing follows the charge-off policy aligned to regulatory guidance; the entry moves the balance to charged-off status and hands the account to recovery placement.", $tags="processes")
  ' aac P_COLLECTIONS_004: company_domain=""
  System(P_RECOVERY_002, "Execute debt sale", "Assemble, price, and execute a sale of charged-off receivables. Debt sale packages carry account-level data quality and documentation warranties; buyer diligence and post-sale complaint routing are part of the process, not after-thoughts.", $tags="processes")
  ' aac P_RECOVERY_002: company_domain=""
  System(P_COLLECTIONS_002, "Execute outbound collections contact", "Execute outbound contact attempts within contact-frequency and communication constraints. Contact windows, frequency caps, and channel consent come from FDCPA, Reg F, and TCPA; the process starts at queue release and ends when the disposition is recorded.", $tags="processes")
  ' aac P_COLLECTIONS_002: company_domain=""
  System(P_COLLECTIONS_005, "Furnish credit bureau data", "Compile and furnish account data to the consumer reporting agencies. Monthly Metro 2 furnishing to the bureaus; accuracy is an FCRA obligation, and the file must reconcile to the system of record before transmission.", $tags="processes")
  ' aac P_COLLECTIONS_005: company_domain=""
  System(P_RECOVERY_003, "Handle bankruptcy notification", "Receive, verify, and action a bankruptcy notification with required account treatment. The automatic stay stops collection on notice; verification, claim filing, and account treatment follow bankruptcy chapter rules with dates that are court deadlines.", $tags="processes")
  ' aac P_RECOVERY_003: company_domain=""
  System(P_RECOVERY_004, "Handle deceased cardholder and estate", "Verify a deceased notification and manage the account through estate resolution. Estate handling balances recovery with conduct: verified notification stops collection contact, and the claim proceeds through the estate at the estate's pace.", $tags="processes")
  ' aac P_RECOVERY_004: company_domain=""
  System(P_COLLECTIONS_007, "Issue debt validation notice", "Generate and deliver the required validation notice within the prescribed period. The validation notice is a statutory precondition to continued collection on affected accounts; timing and content mistakes surface directly as regulatory findings.", $tags="processes")
  ' aac P_COLLECTIONS_007: company_domain=""
  System(P_COLLECTIONS_003, "Negotiate and administer payment arrangement", "Agree, document, and administer a payment arrangement or settlement. Covers promises to pay, long-term arrangements, and settlements; terms must fit the approved matrix, and the arrangement drives bucket movement and interest treatment downstream.", $tags="processes")
  ' aac P_COLLECTIONS_003: company_domain=""
  System(P_RECOVERY_001, "Place account with collection agency", "Select, place, and monitor charged-off accounts with an external collection agency. Agency placement follows the approved network with performance and conduct oversight; the agency acts in the bank's name, so its conduct is the bank's risk.", $tags="processes")
  ' aac P_RECOVERY_001: company_domain=""
  System(P_RECOVERY_005, "Post recovery and account for proceeds", "Post recoveries and account for proceeds from agency, legal, and sale channels. Proceeds post against charged-off balances with channel attribution; recoveries feed the loss forecast, so mis-posting distorts the allowance.", $tags="processes")
  ' aac P_RECOVERY_005: company_domain=""
}
Boundary(b_Inquiry_to_Resolution, "Inquiry to Resolution") {
  System(P_COMPLIANCE_005, "Analyze complaint signal for conduct risk", "Aggregate and analyze complaint data for unfair or deceptive practice risk. Feeds the UDAAP program: complaint taxonomy, root cause, and trend analysis across channels, including complaints held by servicing clients about serviced portfolios.", $tags="processes")
  ' aac P_COMPLIANCE_005: company_domain=""
  System(P_SERVICING_005, "Authenticate cardholder", "Authenticate a cardholder to policy before disclosing information or executing a change. Authentication strength scales with request risk; failures route to step-up rather than disclosure, and the policy is tuned with the fraud team.", $tags="processes")
  ' aac P_SERVICING_005: company_domain=""
  System(P_SERVICING_006, "Capture and resolve complaint", "Capture, classify, resolve, and evidence a cardholder complaint. Complaint handling runs intake through evidenced resolution with regulatory routing where required; the taxonomy feeds UDAAP analysis, so classification is not clerical.", $tags="processes")
  ' aac P_SERVICING_006: company_domain=""
  System(P_SERVICING_004, "Execute account maintenance request", "Execute a cardholder-requested change to account details or preferences. Maintenance changes execute after authentication with an audit trail; address changes get extra scrutiny because they precede takeover fraud.", $tags="processes")
  ' aac P_SERVICING_004: company_domain=""
  System(P_DISPUTE_002, "Execute network chargeback", "Submit and track a chargeback through the network within the applicable filing window. Chargeback rights and filing windows differ by network and reason code; a missed window converts a recoverable dispute into an issuer loss.", $tags="processes")
  ' aac P_DISPUTE_002: company_domain=""
  System(P_DISPUTE_004, "Finalize dispute determination and notify", "Make the final dispute determination, adjust the account, and issue the compliant notice. The determination closes the Reg E or Reg Z clock: account adjustment, provisional credit disposition, and the written explanation must all land within the window.", $tags="processes")
  ' aac P_DISPUTE_004: company_domain=""
  System(P_PRIVACY_001, "Fulfill consumer privacy request", "Receive, verify, and fulfill a consumer privacy rights request within the required period. Identity verification precedes any disclosure; state privacy laws set the clocks and the evidence of fulfillment is retained per request.", $tags="processes")
  ' aac P_PRIVACY_001: company_domain=""
  System(P_SERVICING_007, "Generate and deliver required notice", "Generate and deliver a regulatory or contractual notice to the cardholder. Notice generation is driven by account events with content owned by legal and compliance; proof of delivery and version are retained per notice.", $tags="processes")
  ' aac P_SERVICING_007: company_domain=""
  System(P_CUST_INQ_001, "Handle cardholder inquiry", "Receive, understand, and resolve a cardholder inquiry across any servicing channel. First-contact resolution is the design goal across phone, chat, and secure message; anything unresolved routes to a case with ownership and a promise date.", $tags="processes")
  ' aac P_CUST_INQ_001: company_domain=""
  System(P_COLLECTIONS_006, "Handle credit reporting dispute", "Investigate and respond to a consumer credit reporting dispute within the required period. Direct and bureau-routed disputes both land here; FCRA sets the investigation window, and the outcome must correct both the bureau file and the account when the consumer is right.", $tags="processes")
  ' aac P_COLLECTIONS_006: company_domain=""
  System(P_FRAUD_002, "Investigate and adjudicate fraud case", "Investigate a suspected fraud case and reach a documented determination. The case determination separates true fraud from friendly fraud and abuse, drives the Reg E liability decision, and feeds the loss and strategy data.", $tags="processes")
  ' aac P_FRAUD_002: company_domain=""
  System(P_SERVICING_010, "Monitor and score servicing interactions", "Sample, monitor, score, and calibrate servicing interactions for quality and regulatory compliance signal.", $tags="processes")
  ' aac P_SERVICING_010: company_domain=""
  System(P_DISPUTE_001, "Process cardholder dispute claim", "Take a cardholder dispute claim, apply provisional credit, investigate, determine, and notify within regulatory timers.", $tags="processes")
  ' aac P_DISPUTE_001: company_domain=""
  System(P_DISPUTE_003, "Process representment and pre-arbitration", "Evaluate merchant representment and pursue pre-arbitration where warranted. Representment evidence is weighed against the reason code requirements; pre-arbitration is pursued only where the economics and the evidence support it.", $tags="processes")
  ' aac P_DISPUTE_003: company_domain=""
  System(P_FRAUD_003, "Respond to account takeover event", "Contain, remediate, and communicate an account takeover or identity compromise event. Account takeover response contains first, then remediates credentials, reverses fraudulent activity, and communicates with the cardholder; speed limits the loss.", $tags="processes")
  ' aac P_FRAUD_003: company_domain=""
}
Boundary(b_Prospect_to_Funded_Account, "Prospect to Funded Account") {
  System(P_MARKETING_001, "Build and permission prospect list", "Source, screen, and permission prospect data for use in acquisition campaigns. Prospect data carries permissible-purpose and suppression obligations; the list that leaves this process is the compliant universe for everything downstream.", $tags="processes")
  ' aac P_MARKETING_001: company_domain=""
  System(P_ORIG_001, "Capture card application", "Accept and validate a complete card application from any origination channel. Capture is complete when the application has every field decisioning needs and the applicant has the required disclosures; incomplete applications route to cure, not decline.", $tags="processes")
  ' aac P_ORIG_001: company_domain=""
  System(P_MARKETING_002, "Construct and approve firm offer of credit", "Define offer criteria and terms, and obtain compliance approval before release. A firm offer of credit commits the bank under FCRA; criteria, terms, and the compliance sign-off are locked before any channel sees the offer.", $tags="processes")
  ' aac P_MARKETING_002: company_domain=""
  System(P_ORIG_006, "Establish account and issue credentials", "Open the account on the core platform and issue the card credential. Account establishment writes the account of record and triggers credential issuance; a failure here strands an approved applicant, which is why it carries a same-day SLA.", $tags="processes")
  ' aac P_ORIG_006: company_domain=""
  System(P_MARKETING_003, "Execute acquisition campaign", "Deploy the approved offer across selected channels and manage in-flight performance. In-flight management covers channel performance, budget, and suppression hygiene; changes to a live campaign re-enter compliance review when terms move.", $tags="processes")
  ' aac P_MARKETING_003: company_domain=""
  System(P_ORIG_004, "Execute credit decision", "Apply the approved credit strategy to render an approve, decline, or counter-offer decision with a line assignment.", $tags="processes")
  ' aac P_ORIG_004: company_domain=""
  System(P_ORIG_009, "Handle application withdrawal and abandonment", "Manage applications withdrawn by the applicant or abandoned before completion. Withdrawn and abandoned applications still carry notice, retention, and bureau obligations; this process closes them compliantly instead of letting them age.", $tags="processes")
  ' aac P_ORIG_009: company_domain=""
  System(P_ORIG_005, "Issue adverse action notice", "Generate and deliver a compliant adverse action or counter-offer notice within the required period. ECOA and FCRA set the notice content and the clock; the principal reasons must match the actual decision factors, which is exactly what fair-lending testing checks.", $tags="processes")
  ' aac P_ORIG_005: company_domain=""
  System(P_ORIG_007, "Manage card production and fulfillment", "Oversee vendor-executed card personalization, production, and delivery, including inventory, service levels, and exception handling.", $tags="processes")
  ' aac P_ORIG_007: company_domain=""
  System(P_ORIG_008, "Provision credential to digital wallet", "Provision the card credential into a digital wallet or tokenized environment. Wallet provisioning runs the network token flows with step-up verification where risk requires; weak provisioning is a known fraud vector the strategy watches.", $tags="processes")
  ' aac P_ORIG_008: company_domain=""
  System(P_MARKETING_005, "Review campaign performance and adjust targeting", "Evaluate response, approval, and early vintage economics for in-flight campaigns and decide continue, adjust, or stop.", $tags="processes")
  ' aac P_MARKETING_005: company_domain=""
  System(P_MARKETING_004, "Review marketing creative for compliance", "Review creative, disclosures, and claims for regulatory adequacy before release. Review covers claims, disclosures, and UDAAP risk across every asset and channel; nothing ships without the documented sign-off this process exists to produce.", $tags="processes")
  ' aac P_MARKETING_004: company_domain=""
  System(P_ORIG_003, "Screen application for fraud", "Score and adjudicate the application for synthetic, stolen, and first-party fraud risk. Fraud screening runs before credit decisioning so stolen and synthetic identities never consume a bureau pull; referred applications go to manual review with an SLA.", $tags="processes")
  ' aac P_ORIG_003: company_domain=""
  System(P_CREDIT_001, "Set and deploy credit decision strategy", "Define, test, approve, and deploy changes to the credit decision strategy and its cutoffs. Strategy changes ship through champion-challenger testing with documented approval; the deployed strategy is the single decisioning authority for originations.", $tags="processes")
  ' aac P_CREDIT_001: company_domain=""
  System(P_ORIG_002, "Verify applicant identity and satisfy CIP", "Verify the applicant's identity and record evidence satisfying customer identification obligations. CIP evidence is retained per BSA requirements; verification failures route to document request rather than automatic decline, and synthetic identity signals feed fraud screening.", $tags="processes")
  ' aac P_ORIG_002: company_domain=""
}
Boundary(b_Transact_to_Statement, "Transact to Statement") {
  System(P_REWARDS_001, "Accrue rewards earn", "Calculate and post rewards earn to the rewards ledger for qualifying activity. Earn accrues per the program terms with promotional multipliers; the accrual creates the liability finance reconciles, so earn rules and accounting stay in lockstep.", $tags="processes")
  ' aac P_REWARDS_001: company_domain=""
  System(P_SERVICING_011, "Administer secured card deposit lifecycle", "Collect, hold, apply, and refund security deposits for secured card accounts, including graduation and charge-off application, with correct accounting and disclosure treatment.", $tags="processes")
  ' aac P_SERVICING_011: company_domain=""
  System(P_SERVICING_012, "Apply servicemember and military lending protections", "Identify covered borrowers, apply the required rate and fee protections, and evidence compliance for servicemember accounts.", $tags="processes")
  ' aac P_SERVICING_012: company_domain=""
  System(P_SERVICING_001, "Assess interest, fees, and minimum payment", "Calculate interest, fees, and the minimum payment due for the billing cycle. Cycle assessment applies the cardholder agreement exactly: interest method, fee triggers, and minimum-payment formula, because a systematic error here is a remediation event.", $tags="processes")
  ' aac P_SERVICING_001: company_domain=""
  System(P_CARD_PMT_001, "Capture and apply cardholder payment", "Accept a cardholder payment through any channel and apply it to the account on the correct effective date.", $tags="processes")
  ' aac P_CARD_PMT_001: company_domain=""
  System(P_STMT_GEN_001, "Cut cycle and generate statement", "Cut the billing cycle and generate the cardholder statement including the rewards position. Cycle cut is the hard deadline that sequences assessment, statement generation, and delivery; a late cut cascades into payment due dates and regulatory timing.", $tags="processes")
  ' aac P_STMT_GEN_001: company_domain=""
  System(P_SERVICING_002, "Deliver and archive statement", "Deliver the statement by the cardholder's elected channel and retain it for retrieval. Delivery honors the e-consent election and postal fallback; the archived statement is the legal record retrieved for disputes and subpoenas.", $tags="processes")
  ' aac P_SERVICING_002: company_domain=""
  System(P_FRAUD_001, "Detect and action transaction fraud alert", "Detect a suspected fraudulent transaction, action the alert, and contact the cardholder. Alert handling runs against loss and customer-friction budgets; actions span block, reissue, and contact, and the clock matters because exposure grows per transaction.", $tags="processes")
  ' aac P_FRAUD_001: company_domain=""
  System(P_DIGITAL_001, "Enroll cardholder in digital servicing", "Register and authenticate a cardholder for web and mobile self-service. Enrollment binds the cardholder to a verified identity with step-up options; weak enrollment is the account-takeover front door, so identity proofing follows the fraud strategy.", $tags="processes")
  ' aac P_DIGITAL_001: company_domain=""
  System(P_CREDIT_004, "Execute credit line decrease or account action", "Apply risk-driven line decreases or account actions, with required notice. Adverse action obligations apply to decreases and closures just as they do to declines; the notice must state the principal reasons and bureau information used.", $tags="processes")
  ' aac P_CREDIT_004: company_domain=""
  System(P_CREDIT_003, "Execute credit line increase program", "Identify eligible accounts and execute line increases under the approved strategy. Eligibility, ability-to-pay checks, and notice requirements are built into the program design; execution is batch with opt-out handling.", $tags="processes")
  ' aac P_CREDIT_003: company_domain=""
  System(P_SETTLEMENT_001, "Fund daily network settlement position", "Determine and fund the daily settlement position with the networks. The settlement position must fund by the network deadline in the settlement currency; a miss is a network compliance event, so the process carries same-day escalation.", $tags="processes")
  ' aac P_SETTLEMENT_001: company_domain=""
  System(P_PAYMENTS_002, "Ingest clearing file and post transactions", "Receive network clearing files and post transactions to cardholder accounts. Clearing ingestion matches presentments to authorizations, posts to accounts, and routes exceptions; the file must balance to network totals before posting completes.", $tags="processes")
  ' aac P_PAYMENTS_002: company_domain=""
  System(P_CREDIT_007, "Maintain authorization strategy", "Define and deploy the rules governing real-time authorization decisions. Authorization strategy balances approval rates, fraud losses, and credit exposure in real time; changes deploy through the same testing discipline as origination strategy.", $tags="processes")
  ' aac P_CREDIT_007: company_domain=""
  System(P_PAYMENTS_004, "Manage token and credential lifecycle", "Issue, update, suspend, and delete payment tokens and credentials. Token lifecycle events flow between networks, wallets, and the account of record; a stale token strands the cardholder's wallet, so lifecycle sync is monitored.", $tags="processes")
  ' aac P_PAYMENTS_004: company_domain=""
  System(P_SETTLEMENT_004, "Monitor and optimize interchange qualification", "Monitor interchange qualification rates, identify downgrades, and drive corrections in processing configuration.", $tags="processes")
  ' aac P_SETTLEMENT_004: company_domain=""
  System(P_CREDIT_008, "Perform account review and reissue decision", "Review account risk periodically and decide reissue, close, or continue. Periodic account review drives reissue, line, and closure decisions at card expiry and on risk triggers; decisions carry the same notice obligations as any adverse action.", $tags="processes")
  ' aac P_CREDIT_008: company_domain=""
  System(P_INTERCHANGE_POST_001, "Post interchange and settlement entries", "Calculate and post interchange and settlement accounting entries to the ledger. Interchange entries reconcile to network reports before posting; unexplained variances stop the post rather than flowing into revenue.", $tags="processes")
  ' aac P_INTERCHANGE_POST_001: company_domain=""
  System(P_PAYMENTS_001, "Process authorization request", "Receive, decision, and respond to a real-time authorization request within the network response window.", $tags="processes")
  ' aac P_PAYMENTS_001: company_domain=""
  System(P_SERVICING_003, "Process billing adjustment or goodwill credit", "Apply approved goodwill credits, fee reversals, and billing corrections. Adjustments carry approval limits and reason codes; patterns feed complaint and conduct analysis because repeated goodwill on the same defect is a signal.", $tags="processes")
  ' aac P_SERVICING_003: company_domain=""
  System(P_PAYMENTS_003, "Process returned payment and assess NSF", "Handle returned and reversed payments and assess the associated fees. Return handling reverses the payment application, restores the balance, assesses any permitted fee, and feeds NSF patterns to risk; Reg E error claims can start here.", $tags="processes")
  ' aac P_PAYMENTS_003: company_domain=""
  System(P_REWARDS_002, "Process rewards redemption", "Execute a cardholder rewards redemption and settle the resulting obligation. Redemption executes across cash, statement credit, and partner channels; partner settlement follows the program contract, and failed redemptions reverse cleanly.", $tags="processes")
  ' aac P_REWARDS_002: company_domain=""
  System(P_NETWORK_RECON_001, "Reconcile network settlement", "Reconcile network settlement files against internal transaction and ledger positions and resolve breaks.", $tags="processes")
  ' aac P_NETWORK_RECON_001: company_domain=""
  System(P_DIGITAL_002, "Serve digital self-service transaction", "Execute a cardholder self-service action in web or mobile without agent involvement. Self-service actions execute against the same core services as agent actions, with the same entitlements; the channel changes, the control does not.", $tags="processes")
  ' aac P_DIGITAL_002: company_domain=""
}
System(P_CREDIT_009, "Acquire and refresh credit bureau data", "Source consumer bureau data for prescreen, account review, and portfolio monitoring under permissible purpose, and manage refresh cadence and quality.", $tags="processes")
' aac P_CREDIT_009: company_domain=""
System(P_COMPLIANCE_001, "Assess and land regulatory change", "Detect a regulatory change, assess applicability and impact, and drive implementation. Starts at horizon scanning and ends when the change is implemented and evidenced in the affected processes; applicability calls are documented even when the answer is not applicable.", $tags="processes")
' aac P_COMPLIANCE_001: company_domain=""
System(P_EA_007, "Assess change impact of a proposed system change", "Trace a proposed system or interface change to the processes, capabilities, and clients it affects, and brief the change authority.", $tags="processes")
' aac P_EA_007: company_domain=""
System(P_EA_005, "Assess technology lifecycle and rationalization", "Rate each application and platform for tolerate, invest, migrate, or eliminate; identify duplication and end-of-support exposure.", $tags="processes")
' aac P_EA_005: company_domain=""
System(P_QE_002, "Build and maintain the automated regression suite", "Author, review, and prune automated tests so the regression suite stays fast, trusted, and aligned to current behavior.", $tags="processes")
' aac P_QE_002: company_domain=""
System(P_QE_008, "Certify a release for production", "Assess test results, open defects, and exit criteria, and issue or withhold the quality certification the change authority relies on.", $tags="processes")
' aac P_QE_008: company_domain=""
System(P_CREDIT_005, "Conduct monthly portfolio credit review", "Review vintage, roll-rate, and segment performance against risk appetite and record the actions agreed at the portfolio credit review.", $tags="processes")
' aac P_CREDIT_005: company_domain=""
System(P_RISK_003, "Coordinate regulatory examination", "Coordinate the response to a regulatory examination, including evidence and findings. Exam coordination controls the single flow of requests, evidence, and meetings; every submission is logged and consistent with what other responses have said.", $tags="processes")
' aac P_RISK_003: company_domain=""
System(P_APPDEV_009, "Decommission an application", "Retire an application: migrate or archive its data to the retention schedule, remove interfaces and access, and update the inventory.", $tags="processes")
' aac P_APPDEV_009: company_domain=""
System(P_TECH_001, "Deliver software change", "Design, build, test, and release a software change into production. The umbrella delivery flow from approved demand to production release; the engineering-level decomposition lives in the P-APPDEV and P-QE processes it coordinates.", $tags="processes")
' aac P_TECH_001: company_domain=""
System(P_DATAENG_002, "Deploy and monitor production model", "Deploy an approved model to production and monitor its ongoing performance. Deployment follows model risk approval; monitoring covers drift, stability, and performance against the validation baseline, with retirement triggers agreed up front.", $tags="processes")
' aac P_DATAENG_002: company_domain=""
System(P_APPDEV_002, "Design and build a software increment", "Design, implement, and unit-test a work item to its acceptance criteria within the agreed architecture and standards.", $tags="processes")
' aac P_APPDEV_002: company_domain=""
System(P_INFOSEC_002, "Detect and respond to security event", "Detect, investigate, contain, and remediate a security event. Detection through containment runs the incident playbook with severity-driven escalation; the timeline is evidence for both the CRI assessment and any notification duty.", $tags="processes")
' aac P_INFOSEC_002: company_domain=""
System(P_CREDIT_002, "Develop and validate credit model", "Build, document, and validate credit and fraud models prior to production deployment. Development evidence, data lineage, and validation results follow model risk management expectations; nothing reaches production without an independent validation record.", $tags="processes")
' aac P_CREDIT_002: company_domain=""
System(P_STRATEGY_001, "Evaluate and execute portfolio transaction", "Assess, diligence, price, and execute the acquisition or sale of a card portfolio, through to hand-off into conversion.", $tags="processes")
' aac P_STRATEGY_001: company_domain=""
System(P_EA_008, "Evaluate and select a technology or platform", "Run the evaluation for a new technology or vendor platform: requirements, options, proof of concept, and a recommendation into procurement.", $tags="processes")
' aac P_EA_008: company_domain=""
System(P_COMPLIANCE_002, "Execute compliance monitoring test", "Execute a scheduled control test and record the result and any exceptions. Runs the monitoring schedule agreed with the compliance plan; exceptions become issues in remediation tracking with owners and dates rather than emails.", $tags="processes")
' aac P_COMPLIANCE_002: company_domain=""
System(P_TECH_003, "Execute disaster recovery test", "Plan and execute a recovery test against committed recovery objectives. The annual test exercises recovery against committed RTO and RPO with business participation; misses become tracked remediation, and the evidence supports the CRI assessment.", $tags="processes")
' aac P_TECH_003: company_domain=""
System(P_QE_003, "Execute functional and regression testing", "Run planned functional tests and the regression suite against a candidate build, and record results against the plan.", $tags="processes")
' aac P_QE_003: company_domain=""
System(P_GL_CLOSE_001, "Execute monthly financial close", "Complete the period-end close, including reconciliations, accruals, and reporting sign-off. The close calendar drives reconciliations, accruals, and sign-offs to the reporting deadline; open items age visibly and block sign-off past threshold.", $tags="processes")
' aac P_GL_CLOSE_001: company_domain=""
System(P_QE_004, "Execute performance and resilience testing", "Load, soak, and failover-test a candidate against stated capacity and recovery objectives before a material release.", $tags="processes")
' aac P_QE_004: company_domain=""
System(P_DATAGOV_004, "Execute records retention and disposition", "Apply the retention schedule and execute defensible disposition of records. Disposition is defensible destruction: eligibility verified against holds, execution evidenced by certificate, and the retention schedule is the single authority.", $tags="processes")
' aac P_DATAGOV_004: company_domain=""
System(P_VENDORMGMT_003, "Execute supplier exit", "Execute the exit of a supplier, including data return and service transition. Exit executes the termination plan: service transition, data return or destruction with certificate, and access revocation, proving the exit clause was real.", $tags="processes")
' aac P_VENDORMGMT_003: company_domain=""
System(P_PARTNERSHIPS_001, "Fulfill issuing bank oversight obligations", "Produce contracted reporting, respond to oversight requests, and manage obligations under the issuing bank agreement.", $tags="processes")
' aac P_PARTNERSHIPS_001: company_domain=""
System(P_EA_003, "Grant or decline an architecture exception", "Evaluate a request to deviate from a standard, set conditions and expiry, and track the exception to closure.", $tags="processes")
' aac P_EA_003: company_domain=""
System(P_PAYMENTS_005, "Implement network mandate release", "Assess and implement network mandate and release changes by the required date. Network mandates carry hard effective dates and fines for misses; assessment, build, and attestation are tracked per mandate from bulletin to production.", $tags="processes")
' aac P_PAYMENTS_005: company_domain=""
System(P_DATAENG_001, "Ingest and integrate source data", "Acquire, integrate, and land source data into the enterprise data platform. Ingestion lands source extracts into the platform with schema validation, lineage capture, and quality checks at the gate rather than downstream.", $tags="processes")
' aac P_DATAENG_001: company_domain=""
System(P_SETTLEMENT_003, "Investigate and clear settlement exception", "Investigate settlement breaks and exceptions and drive them to resolution. Settlement exceptions are worked to root cause across network reports, the gateway, and the ledger; recurring breaks feed a fix, not a workaround.", $tags="processes")
' aac P_SETTLEMENT_003: company_domain=""
System(P_COMPLIANCE_004, "Investigate and file suspicious activity report", "Investigate an alert and, where warranted, prepare and file the regulatory report. The SAR decision and filing run on the BSA clock from alert qualification; the investigation file must stand on its own for examiner review, and filing is confidential by law.", $tags="processes")
' aac P_COMPLIANCE_004: company_domain=""
System(P_EA_004, "Maintain architecture standards and reference models", "Author, review, version, and retire the standards and reference models that solution reviews are judged against.", $tags="processes")
' aac P_EA_004: company_domain=""
System(P_INFOSEC_004, "Maintain cardholder data scope and evidence", "Maintain the cardholder data environment scope and the supporting compliance evidence. PCI scope is maintained continuously: network segmentation, asset inventory, and evidence collection, so assessment is a report, not a scramble.", $tags="processes")
' aac P_INFOSEC_004: company_domain=""
System(P_FRAUD_006, "Maintain fraud detection strategy", "Define, test, and deploy changes to fraud detection rules and models. Strategy changes are tested against recent fraud and false-positive performance before deployment; every rule change is versioned and reversible.", $tags="processes")
' aac P_FRAUD_006: company_domain=""
System(P_SERVICING_009, "Maintain servicing knowledge content", "Author, review, and publish agent-facing knowledge and guidance. Knowledge content is the agent's authority in the moment; review cadence and ownership keep it aligned with policy, because stale guidance becomes wrong answers at scale.", $tags="processes")
' aac P_SERVICING_009: company_domain=""
System(P_EA_001, "Maintain target-state architecture and roadmap", "Define and refresh the target state for each domain and the sequenced roadmap to reach it, aligned to the investment plan.", $tags="processes")
' aac P_EA_001: company_domain=""
System(P_EA_009, "Maintain the application and technology inventory", "Keep the inventory of applications, platforms, and interfaces complete and attributed, including owner, tier, hosting, and lifecycle state.", $tags="processes")
' aac P_EA_009: company_domain=""
System(P_EA_006, "Maintain the capability map and process inventory", "Keep the business architecture model current: harvest changes, run the quality gates, and publish the refreshed model to its consumers.", $tags="processes")
' aac P_EA_006: company_domain=""
System(P_APPDEV_007, "Manage application configuration and feature flags", "Control configuration and feature-flag changes so behavior can be changed or reverted without a code release, with an audit trail.", $tags="processes")
' aac P_APPDEV_007: company_domain=""
System(P_FUNDING_001, "Manage daily funding position", "Determine, fund, and report the daily liquidity and funding position. The daily position covers settlement obligations, deposit flows, and contingency lines; a funding miss is a same-day escalation, not a report.", $tags="processes")
' aac P_FUNDING_001: company_domain=""
System(P_QE_006, "Manage defects to closure", "Triage, prioritize, assign, and verify defects found in test or production, and report defect trends by area.", $tags="processes")
' aac P_QE_006: company_domain=""
System(P_RISK_001, "Manage issue and remediation to closure", "Track an identified issue through remediation to evidenced closure. Issues from any source (audit, compliance, self-identified, exam) run one lifecycle: owner, action plan, dates, and evidenced closure that survives challenge.", $tags="processes")
' aac P_RISK_001: company_domain=""
System(P_APPDEV_006, "Manage technical debt", "Record, size, and prioritize technical debt, and reserve capacity in each increment to retire it. Debt items live in the same backlog as features so the trade-off is visible at prioritization, not discovered at incident time.", $tags="processes")
' aac P_APPDEV_006: company_domain=""
System(P_DATAGOV_002, "Measure and remediate data quality", "Measure data quality against defined expectations and drive remediation. Quality rules run against critical data elements with published thresholds; breaches create remediation work with the data owner, not just a dashboard entry.", $tags="processes")
' aac P_DATAGOV_002: company_domain=""
System(P_VENDORMGMT_002, "Monitor supplier risk and performance", "Monitor supplier risk, performance, and service levels through the relationship. Ongoing monitoring covers risk, performance, and financial condition on a tier-driven cadence; findings route to the relationship owner with dates.", $tags="processes")
' aac P_VENDORMGMT_002: company_domain=""
System(P_DATAGOV_001, "Onboard and classify data asset", "Register a data asset, assign ownership, and classify it for handling. Onboarding assigns owner, steward, classification, and retention up front; the Collibra registration is the system of record this model's stub points at.", $tags="processes")
' aac P_DATAGOV_001: company_domain=""
System(P_VENDORMGMT_001, "Onboard and diligence supplier", "Assess, diligence, and contract a new supplier with required security and risk terms. Due diligence is risk-tiered per the TPRM policy; no supplier touches cardholder data before security review and contract terms land, which is the EX.DD control.", $tags="processes")
' aac P_VENDORMGMT_001: company_domain=""
System(P_TECH_004, "Onboard and operate integration", "Design, register, and operate an interface between systems. Integration onboarding registers the interface, its data, and its owners before traffic flows; unregistered interfaces are how impact analysis goes blind.", $tags="processes")
' aac P_TECH_004: company_domain=""
System(P_QE_001, "Plan the test strategy for a release", "Decide scope, risk-based depth, environments, data, and entry and exit criteria for a release before build starts.", $tags="processes")
' aac P_QE_001: company_domain=""
System(P_REG_DATA_PREP_001, "Prepare regulatory reporting data", "Assemble, validate, and certify the data supporting regulatory reporting submissions. Report data is assembled from governed sources with reconciliation to the ledger and prior submissions; certification is a named officer's sign-off, not a batch job.", $tags="processes")
' aac P_REG_DATA_PREP_001: company_domain=""
System(P_FINANCE_002, "Process supplier payment", "Validate, approve, and execute payment to a supplier. Invoices match to contract and receipt before payment; approval limits and segregation of duties are the fraud controls the audit tests.", $tags="processes")
' aac P_FINANCE_002: company_domain=""
System(P_CREDIT_006, "Produce loss forecast and allowance", "Produce the credit loss forecast and set the allowance for the reporting period. The CECL forecast and allowance feed the financial statements; assumptions, overlays, and approvals are documented for both auditors and examiners.", $tags="processes")
' aac P_CREDIT_006: company_domain=""
System(P_INFOSEC_001, "Provision and certify access", "Grant, review, and certify access to systems and data. Access follows least privilege with owner approval; the quarterly certification and automatic revocation of uncertified access are the controls CRI assesses.", $tags="processes")
' aac P_INFOSEC_001: company_domain=""
System(P_QE_007, "Provision test environments and masked data", "Stand up and refresh non-production environments with representative, masked data, and retire them on schedule.", $tags="processes")
' aac P_QE_007: company_domain=""
System(P_DATAGOV_003, "Publish metadata and lineage to catalog", "Publish metadata, lineage, and ownership into the governance catalog. The catalog is where consumers discover data and its lineage; publication is part of change delivery, not an afterthought, so the catalog stays current by construction.", $tags="processes")
' aac P_DATAGOV_003: company_domain=""
System(P_FINANCE_001, "Recognize interchange and servicing revenue", "Calculate and recognize interchange, fee, and servicing revenue for the period. Revenue recognition follows the network and client contract terms; interchange, fees, and servicing revenue post to the ledger with support for audit.", $tags="processes")
' aac P_FINANCE_001: company_domain=""
System(P_SETTLEMENT_002, "Reconcile cash and suspense accounts", "Reconcile cash and suspense account positions and clear aged items. Cash and suspense reconcile daily with aging visible; suspense is a control account, and items that age past threshold escalate to investigation.", $tags="processes")
' aac P_SETTLEMENT_002: company_domain=""
System(P_REWARDS_003, "Reconcile rewards liability", "Reconcile the rewards ledger to the recorded liability and resolve differences. The rewards liability reconciliation catches earn, redemption, and expiry drift between the ledger and finance; differences are investigated, not plugged.", $tags="processes")
' aac P_REWARDS_003: company_domain=""
System(P_FRAUD_004, "Recover and write off fraud loss", "Pursue recovery of fraud losses and write off the residual with correct accounting. Recovery pursues merchants, networks, and other issuers where rights exist; the residual writes off to the fraud loss line with the accounting evidenced.", $tags="processes")
' aac P_FRAUD_004: company_domain=""
System(P_APPDEV_001, "Refine and prioritize the product backlog", "Break approved demand into sized, ordered work items with acceptance criteria, and agree the next increment with the business owner.", $tags="processes")
' aac P_APPDEV_001: company_domain=""
System(P_INFOSEC_003, "Remediate vulnerability", "Triage and remediate an identified vulnerability within the applicable service level. Severity sets the remediation SLA; breaches escalate rather than languish, and closure requires verification, not just a patch record.", $tags="processes")
' aac P_INFOSEC_003: company_domain=""
System(P_TECH_002, "Respond to service incident", "Detect, triage, resolve, and review a service incident. Incident response runs detect, triage, resolve, and review with severity-driven communication; customer-impacting incidents feed problem management and the resilience picture.", $tags="processes")
' aac P_TECH_002: company_domain=""
System(P_APPDEV_003, "Review and merge code", "Peer-review a change for correctness, security, and standards before it is merged to the main line. Merge rights sit with reviewers, not authors, which is the segregation the change-control audit tests; review evidence stays on the pull request.", $tags="processes")
' aac P_APPDEV_003: company_domain=""
System(P_EA_002, "Review solution architecture for an initiative", "Assess a proposed solution against standards, target state, and risk before funding and again before build; record the decision.", $tags="processes")
' aac P_EA_002: company_domain=""
System(P_APPDEV_004, "Run the build and deployment pipeline", "Build, package, scan, and promote a change through environments automatically, with gates that stop a failing build.", $tags="processes")
' aac P_APPDEV_004: company_domain=""
System(P_QE_005, "Run user acceptance testing with the business", "Prepare scripts and data, run acceptance with business owners, and obtain their sign-off or documented rejection.", $tags="processes")
' aac P_QE_005: company_domain=""
System(P_APPDEV_005, "Scan code and dependencies for security defects", "Run static, dependency, and secret scanning on every change and remediate findings within the applicable service level.", $tags="processes")
' aac P_APPDEV_005: company_domain=""
System(P_COMPLIANCE_003, "Screen for sanctions and watchlists", "Screen parties and transactions against sanctions and watchlists and adjudicate hits. Screening runs at onboarding and on list updates across cardholders, clients, and suppliers; a hit blocks processing until dispositioned, and the disposition is retained as evidence.", $tags="processes")
' aac P_COMPLIANCE_003: company_domain=""
System(P_FRAUD_005, "Submit network fraud reporting", "Compile and submit fraud reporting to the networks within required thresholds. Network fraud reporting (TC40, SAFE) has thresholds and deadlines; late or wrong reporting risks network compliance programs and fines.", $tags="processes")
' aac P_FRAUD_005: company_domain=""
System(P_APPDEV_008, "Support a production application", "Diagnose and fix application defects escalated from service management, and feed root causes back into the backlog.", $tags="processes")
' aac P_APPDEV_008: company_domain=""
System(P_RISK_002, "Validate model independently", "Perform independent validation of a model and record the outcome and conditions. Independent validation is organizationally separate from development; findings condition or block production use, and revalidation triggers are set at approval.", $tags="processes")
' aac P_RISK_002: company_domain=""
System(P_QE_009, "Verify a release in production", "Run post-deployment checks and smoke tests in production, confirm monitoring is green, and trigger rollback if criteria fail.", $tags="processes")
' aac P_QE_009: company_domain=""

SHOW_LEGEND()
@enduml
