@startuml
' Installment Lending Integration Hub — Architecture
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Installment Lending Integration Hub — Architecture

AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")
AddElementTag("tech_services", $bgColor="#fed7aa", $borderColor="#c2410c", $fontColor="#0f172a", $legendText="technology service")
AddRelTag("api-call", $legendText="API call")

Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_CARD_ACCOUNT, "Card account master", "Account, balance, limit and status records for every card account.", $tags="data_assets")
  ' aac DA_CARD_ACCOUNT: company_domain="Card Issuing"
  SystemDb(DA_BUREAU_FILE, "Credit bureau furnishing file", "Monthly tradeline furnishing extract and consumer-dispute responses.", $tags="data_assets")
  ' aac DA_BUREAU_FILE: company_domain=""
  SystemDb(DA_CUSTOMER_PROFILE, "Customer profile", "Contact details, preferences and servicing history.", $tags="data_assets")
  ' aac DA_CUSTOMER_PROFILE: company_domain="Servicing"
  SystemDb(DA_DISPUTE_CASE, "Dispute case file", "Claims, evidence, correspondence, timers, and determinations for error resolution.", $tags="data_assets")
  ' aac DA_DISPUTE_CASE: company_domain=""
  SystemDb(DA_PAYMENT_INSTR, "Payment instructions", "Cardholder payment methods and instructions: ACH details, scheduled payments.", $tags="data_assets")
  ' aac DA_PAYMENT_INSTR: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
  System_Ext(SYS_CRM, "Dynamics 365 Customer Service", "Contact center desktop and case management for servicing agents. Built with Microsoft.", $tags="systems")
  ' aac SYS_CRM: company_domain="Servicing"; hosting="SaaS"; technology="Microsoft"
  System_Ext(SYS_CREDIT_BUREAU, "Experian Credit Bureau", "External credit reference agency used for affordability and bureau search at application time. Reached over PrivateLink from the lending workload account. Built with Experian.", $tags="systems")
  ' aac SYS_CREDIT_BUREAU: company_domain="Risk and Compliance"; hosting="SaaS"; technology="Experian"
  System(SYS_LENDING_HUB, "Installment Lending Integration Hub", "Mediates every Installment Lending integration: one place for mapping, routing, retry and the audit trail, so the spokes do not each carry their own.", $tags="systems")
  ' aac SYS_LENDING_HUB: company_domain="Lending"; hosting="AWS"
}
Boundary(b_Technology_Service, "Technology Service") {
  Deployment_Node(TS_ENTRA_ID, "Microsoft Entra ID", "Identity provider", "Workforce and customer identity provider.", $tags="tech_services") {
    ' aac TS_ENTRA_ID: company_domain="Enterprise Platform"; technology="Identity provider"
  }
  Deployment_Node(TS_ONPREM_DC, "Primary Data Center", "Virtual network", "The data center the mainframe and the authorization switch live in. Modeled because half the integration cost of any cloud onboarding is the path back to here.", $tags="tech_services") {
    ' aac TS_ONPREM_DC: company_domain="Enterprise Platform"; technology="Virtual network"
  }
}

Rel(SYS_CRM, SYS_CORE_LEDGER, "Servicing CRM to Core Ledger", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CRM"; target="SYS_CORE_LEDGER"; label="Servicing CRM to Core Ledger"; interface_id="INT-CRM-LEDGER"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CORE_LEDGER, SYS_LENDING_HUB, "CORE-LEDGER via Installment Lending hub", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CORE_LEDGER"; target="SYS_LENDING_HUB"; label="CORE-LEDGER via Installment Lending hub"; interface_id="INT-LENDING-CORE-LEDGER-HUB"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CREDIT_BUREAU, SYS_LENDING_HUB, "CREDIT-BUREAU via Installment Lending hub", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CREDIT_BUREAU"; target="SYS_LENDING_HUB"; label="CREDIT-BUREAU via Installment Lending hub"; interface_id="INT-LENDING-CREDIT-BUREAU-HUB"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CRM, SYS_LENDING_HUB, "CRM via Installment Lending hub", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CRM"; target="SYS_LENDING_HUB"; label="CRM via Installment Lending hub"; interface_id="INT-LENDING-CRM-HUB"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CRM, TS_ENTRA_ID, "runs on")
' aac rel: source="SYS_CRM"; target="TS_ENTRA_ID"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CORE_LEDGER, TS_ONPREM_DC, "runs on")
' aac rel: source="SYS_CORE_LEDGER"; target="TS_ONPREM_DC"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CORE_LEDGER, DA_PAYMENT_INSTR, "Read")
' aac rel: source="SYS_CORE_LEDGER"; target="DA_PAYMENT_INSTR"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_CREDIT_BUREAU, DA_BUREAU_FILE, "Read")
' aac rel: source="SYS_CREDIT_BUREAU"; target="DA_BUREAU_FILE"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_CRM, DA_DISPUTE_CASE, "ReadWrite")
' aac rel: source="SYS_CRM"; target="DA_DISPUTE_CASE"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(SYS_CORE_LEDGER, DA_CARD_ACCOUNT, "ReadWrite")
' aac rel: source="SYS_CORE_LEDGER"; target="DA_CARD_ACCOUNT"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(SYS_CRM, DA_CUSTOMER_PROFILE, "ReadWrite")
' aac rel: source="SYS_CRM"; target="DA_CUSTOMER_PROFILE"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"

SHOW_LEGEND()
@enduml
