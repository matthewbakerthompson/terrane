@startuml
' Customer Identity Service — Architecture
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Customer Identity Service — Architecture

AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("offered_interfaces", $bgColor="#e6ecff", $borderColor="#6366f1", $fontColor="#0f172a", $legendText="offered interface")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")
AddElementTag("tech_services", $bgColor="#fed7aa", $borderColor="#c2410c", $fontColor="#0f172a", $legendText="technology service")
AddRelTag("api-call", $legendText="API call")
AddRelTag("event-over-https", $legendText="Event over HTTPS")

Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_CARD_ACCOUNT, "Card account master", "Account, balance, limit and status records for every card account.", $tags="data_assets")
  ' aac DA_CARD_ACCOUNT: company_domain="Card Issuing"
  SystemDb(DA_CARDSVC_OPERATIONAL, "Card Servicing operational data", "Operational records held by Card Servicing.", $tags="data_assets")
  ' aac DA_CARDSVC_OPERATIONAL: company_domain="Servicing"
  SystemDb(DA_TRANSACTION, "Card transaction history", "Authorized, cleared and settled card transactions.", $tags="data_assets")
  ' aac DA_TRANSACTION: company_domain="Payments"
  SystemDb(DA_COLLECT_ACT, "Collections activity record", "Contact attempts, dispositions, promises, and arrangement terms.", $tags="data_assets")
  ' aac DA_COLLECT_ACT: company_domain=""
  SystemDb(DA_COLLECT_OPERATIONAL, "Collections Workspace operational data", "Operational records held by Collections Workspace.", $tags="data_assets")
  ' aac DA_COLLECT_OPERATIONAL: company_domain="Collections"
  SystemDb(DA_LENDING_OPERATIONAL, "Installment Lending operational data", "Operational records held by Installment Lending.", $tags="data_assets")
  ' aac DA_LENDING_OPERATIONAL: company_domain="Lending"
}
Boundary(b_System, "System") {
  System(SYS_CARDSVC_API, "Card Servicing Service", "The service behind the Card Servicing API, backing the channel. Built with AKS · Card Servicing Cache.", $tags="systems")
  ' aac SYS_CARDSVC_API: company_domain="Servicing"; hosting="Azure"; technology="AKS · Card Servicing Cache"
  System(SYS_COLLECT_API, "Collections Workspace Service", "The service behind the Collections Workspace API, backing the channel. Built with AKS · Collections Workspace Cache.", $tags="systems")
  ' aac SYS_COLLECT_API: company_domain="Collections"; hosting="Azure"; technology="AKS · Collections Workspace Cache"
  System(OI_IDENTITY_API, "Customer Identity API", "Customer authentication and the profile behind it, for every product that signs a customer in. Built with HTTPS.", $tags="offered_interfaces")
  ' aac OI_IDENTITY_API: company_domain="Enterprise Platform"; technology="HTTPS"
  System(SYS_IDENTITY_SVC, "Customer Identity Service", "Shared platform service: Customer Identity Service. Built with AKS.", $tags="systems")
  ' aac SYS_IDENTITY_SVC: company_domain="Enterprise Platform"; hosting="Azure"; technology="AKS"
  System(SYS_IDV_GATEWAY, "Identity Document Verification Integration Gateway", "Our side of the Onfido integration: request mapping, retry and back-off, circuit breaking when the vendor is down, and the audit trail of what we sent them. Built with AKS.", $tags="systems")
  ' aac SYS_IDV_GATEWAY: company_domain="Risk and Compliance"; hosting="Azure"; technology="AKS"
  System(SYS_IDV_WEBHOOKS, "Identity Document Verification Webhook Listener", "Receives Onfido callbacks, verifies their signature, and forwards the event. Public by necessity, small by design. Built with AKS.", $tags="systems")
  ' aac SYS_IDV_WEBHOOKS: company_domain="Risk and Compliance"; hosting="Azure"; technology="AKS"
  System(SYS_LENDING_API, "Installment Lending Service", "Domain service for Installment Lending, behind the Installment Lending API. Built with EKS · Installment Lending Cache.", $tags="systems")
  ' aac SYS_LENDING_API: company_domain="Lending"; hosting="AWS"; technology="EKS · Installment Lending Cache"
}
Boundary(b_Technology_Service, "Technology Service") {
  Deployment_Node(TS_AWS_CLOUDWATCH, "Amazon CloudWatch", "Observability", "Metrics, logs and alarms for every workload in the landing zone.", $tags="tech_services") {
    ' aac TS_AWS_CLOUDWATCH: company_domain="Enterprise Platform"; technology="Observability"
  }
  Deployment_Node(TS_AWS_EKS, "Amazon EKS", "Container platform", "Managed Kubernetes running the containerized workloads.", $tags="tech_services") {
    ' aac TS_AWS_EKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Deployment_Node(TS_AWS_PRIVATELINK, "AWS PrivateLink", "Private egress", "Private egress to partner and vendor endpoints without internet transit.", $tags="tech_services") {
    ' aac TS_AWS_PRIVATELINK: company_domain="Enterprise Platform"; technology="Private egress"
  }
  Deployment_Node(TS_AWS_SECRETS, "AWS Secrets Manager", "Secrets manager", "Application credentials and rotation.", $tags="tech_services") {
    ' aac TS_AWS_SECRETS: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_AZURE_APIM, "Azure API Management", "API gateway", "The API gateway every internal and partner API is published through.", $tags="tech_services") {
    ' aac TS_AZURE_APIM: company_domain="Enterprise Platform"; technology="API gateway"
  }
  Deployment_Node(TS_AZURE_KEYVAULT, "Azure Key Vault", "Secrets manager", "Secret, key and certificate management.", $tags="tech_services") {
    ' aac TS_AZURE_KEYVAULT: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_AZURE_AKS, "Azure Kubernetes Service", "Container platform", "Managed Kubernetes hosting the containerized estate.", $tags="tech_services") {
    ' aac TS_AZURE_AKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Deployment_Node(TS_AZURE_MONITOR, "Azure Monitor", "Observability", "Metrics, logs and alerts for the Azure-hosted estate.", $tags="tech_services") {
    ' aac TS_AZURE_MONITOR: company_domain="Enterprise Platform"; technology="Observability"
  }
  Deployment_Node(TS_CARDSVC_CACHE, "Card Servicing Cache", "Azure Cache for Redis", "In-memory key-value store. Also, in most estates, an accidental database with no backup.", $tags="tech_services") {
    ' aac TS_CARDSVC_CACHE: company_domain="Servicing"; technology="Azure Cache for Redis"
  }
  Deployment_Node(TS_COLLECT_CACHE, "Collections Workspace Cache", "Azure Cache for Redis", "In-memory key-value store. Also, in most estates, an accidental database with no backup.", $tags="tech_services") {
    ' aac TS_COLLECT_CACHE: company_domain="Collections"; technology="Azure Cache for Redis"
  }
  Deployment_Node(TS_IDENTITY_DNS, "Customer Identity Service DNS", "Azure DNS", "Name resolution and, in practice, the failover mechanism of last resort.", $tags="tech_services") {
    ' aac TS_IDENTITY_DNS: company_domain="Enterprise Platform"; technology="Azure DNS"
  }
  Deployment_Node(TS_IDENTITY_WAF, "Customer Identity Service Web application firewall", "Azure WAF", "Request inspection at the edge. Blocks the traffic nobody wrote a test for.", $tags="tech_services") {
    ' aac TS_IDENTITY_WAF: company_domain="Enterprise Platform"; technology="Azure WAF"
  }
  Deployment_Node(TS_LENDING_CACHE, "Installment Lending Cache", "Amazon ElastiCache", "In-memory key-value store. Also, in most estates, an accidental database with no backup.", $tags="tech_services") {
    ' aac TS_LENDING_CACHE: company_domain="Lending"; technology="Amazon ElastiCache"
  }
  Deployment_Node(TS_NET_SUB_LEND_APP_A, "Lending App Subnet A", "Subnet", $tags="tech_services") {
    ' aac TS_NET_SUB_LEND_APP_A: company_domain="Lending"; technology="Subnet"
  }
  Deployment_Node(TS_NET_SUB_LEND_APP_B, "Lending App Subnet B", "Subnet", $tags="tech_services") {
    ' aac TS_NET_SUB_LEND_APP_B: company_domain="Lending"; technology="Subnet"
  }
}

