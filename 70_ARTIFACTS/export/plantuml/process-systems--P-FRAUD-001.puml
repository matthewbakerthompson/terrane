AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_FRAUD_01, "Transaction Fraud Detection & Strategy", "Detect fraudulent transactions in flight and set detection strategy.", $tags="capabilities")
  ' aac CAP_FRAUD_01: company_domain="Servicing"
}
Boundary(b_Control, "Control") {
  System(CTL_FRAUD_SLA, "Fraud alert handling service level", "Fraud alerts are actioned within the loss-budget SLA with disposition quality sampling; Reg E liability decisions are documented per case.", $tags="controls")
  ' aac CTL_FRAUD_SLA: company_domain=""
}
Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_TRANSACTION, "Card transaction history", "Authorized, cleared and settled card transactions.", $tags="data_assets")
  ' aac DA_TRANSACTION: company_domain="Payments"
  SystemDb(DA_CUSTOMER_PROFILE, "Customer profile", "Contact details, preferences and servicing history.", $tags="data_assets")
  ' aac DA_CUSTOMER_PROFILE: company_domain="Servicing"
  SystemDb(DA_DISPUTE_CASE, "Dispute case file", "Claims, evidence, correspondence, timers, and determinations for error resolution.", $tags="data_assets")
  ' aac DA_DISPUTE_CASE: company_domain=""
  SystemDb(DA_MODEL_FEAT, "Model feature store", "Curated features and scores for credit, fraud, and collections models.", $tags="data_assets")
  ' aac DA_MODEL_FEAT: company_domain=""
}
Boundary(b_Process, "Process") {
  System(P_FRAUD_001, "Detect and action transaction fraud alert", "Detect a suspected fraudulent transaction, action the alert, and contact the cardholder. Alert handling runs against loss and customer-friction budgets; actions span block, reissue, and contact, and the clock matters because exposure grows per transaction.", $tags="processes")
  ' aac P_FRAUD_001: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CONTACT, "Contact center platform", "Contact center routing, voice, and digital channels.", $tags="systems")
  ' aac SYS_CONTACT: company_domain=""
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
  System(SYS_FRAUD_DETECT, "Transaction fraud detection", "Real-time transaction fraud scoring and alerting.", $tags="systems")
  ' aac SYS_FRAUD_DETECT: company_domain=""
}

Rel(P_FRAUD_001, SYS_FRAUD_DETECT, "Primary")
