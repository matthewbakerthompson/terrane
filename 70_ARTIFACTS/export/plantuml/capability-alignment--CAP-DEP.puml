Rel(CAP_DEP_03, FW_BIAN, "Operations and Execution > Consumer Services > Brokered Product Proxy")
' aac rel: source="CAP_DEP_03"; target="FW_BIAN"; label="Operations and Execution > Consumer Services > Brokered Product Proxy"; relation="capability_references_framework"; ref="Operations and Execution > Consumer Services > Brokered Product Proxy"
Rel(CAP_DEP_04, FW_BIAN, "Operations and Execution > Loans and Deposits > Term Deposit")
' aac rel: source="CAP_DEP_04"; target="FW_BIAN"; label="Operations and Execution > Loans and Deposits > Term Deposit"; relation="capability_references_framework"; ref="Operations and Execution > Loans and Deposits > Term Deposit"
Rel(CAP_DEP_05, FW_CRI, "Govern > GV.OC-03")
