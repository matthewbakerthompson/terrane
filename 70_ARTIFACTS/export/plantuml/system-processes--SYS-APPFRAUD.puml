Rel(P_LENDING_003, CAP_LEND_02_01, "supports")
' aac rel: source="P_LENDING_003"; target="CAP_LEND_02_01"; label="supports"; relation="process_supports_capability"
Rel(P_FRAUD_008, CAP_FRAUD_08, "supports")
' aac rel: source="P_FRAUD_008"; target="CAP_FRAUD_08"; label="supports"; relation="process_supports_capability"
Rel(P_LENDING_003, CAP_LEND_02, "supports")
