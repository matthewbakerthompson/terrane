@startuml
' Monitor dealer performance and program compliance — Systems, Data and Controls
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Monitor dealer performance and program compliance — Systems, Data and Controls

AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("controls", $bgColor="#fca5a5", $borderColor="#b91c1c", $fontColor="#0f172a", $legendText="control")
AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_LEND_01, "Dealer Network & Program Management", "Recruit, contract, monitor, and manage the dealer network that originates recreation loans, including program terms and dealer performance.", $tags="capabilities")
  ' aac CAP_LEND_01: company_domain="Lending"
}
Boundary(b_Control, "Control") {
  System(CTL_DEALER_MON, "Dealer program and markup monitoring", "Dealer rate markup, early defaults, exceptions and complaints are reviewed monthly against program limits, with action recorded.", $tags="controls")
  ' aac CTL_DEALER_MON: company_domain=""
}
Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_DEALER, "Dealer master and agreement", "Dealer identity, licensing, ownership, program terms, reserve rules and performance history.", $tags="data_assets")
  ' aac DA_DEALER: company_domain=""
  SystemDb(DA_LOAN_ACCOUNT, "Installment loan account", "Loan terms, payment schedule, balances, payment history and status for each installment loan.", $tags="data_assets")
  ' aac DA_LOAN_ACCOUNT: company_domain=""
}
Boundary(b_Process, "Process") {
  System(P_LENDING_002, "Monitor dealer performance and program compliance", "Review each dealer's volume, early payment defaults, funding exceptions, complaints and rate markup against program limits, and put dealers on watch, retrain or end them. Dealer markup is where indirect lending meets fair lending exposure, so the review evidences the markup cap as well as credit quality.", $tags="processes")
  ' aac P_LENDING_002: company_domain=""
}
Boundary(b_System, "System") {
  System_Ext(SYS_DEALER_PORTAL, "Dealer portal", "Where dealers submit applications, see decisions and stipulations, upload contracts, and track funding and reserve. Built with SaaS.", $tags="systems")
  ' aac SYS_DEALER_PORTAL: company_domain=""; hosting="SaaS"; technology="SaaS"
  System(SYS_LOS, "Indirect loan origination system", "Takes dealer applications, runs the credit decision and counteroffers, and carries the contract package to funding.", $tags="systems")
  ' aac SYS_LOS: company_domain=""
  System(SYS_LENDPERF_SEMANTIC, "Lending Portfolio Performance Semantic Layer", "Governed models and metrics exposed to analysts for Lending Portfolio Performance, served from BigQuery through Looker. Built with BigQuery · Looker.", $tags="systems")
  ' aac SYS_LENDPERF_SEMANTIC: company_domain="Lending"; hosting="GCP"; technology="BigQuery · Looker"
}

Rel(P_LENDING_002, SYS_LENDPERF_SEMANTIC, "Primary")
' aac rel: source="P_LENDING_002"; target="SYS_LENDPERF_SEMANTIC"; label="Primary"; relation="process_uses_system"; role="Primary"
Rel(P_LENDING_002, SYS_DEALER_PORTAL, "Supporting")
' aac rel: source="P_LENDING_002"; target="SYS_DEALER_PORTAL"; label="Supporting"; relation="process_uses_system"; role="Supporting"
Rel(P_LENDING_002, SYS_LOS, "Supporting")
' aac rel: source="P_LENDING_002"; target="SYS_LOS"; label="Supporting"; relation="process_uses_system"; role="Supporting"
Rel(P_LENDING_002, DA_DEALER, "Read")
' aac rel: source="P_LENDING_002"; target="DA_DEALER"; label="Read"; relation="process_uses_data_asset"; access="Read"
Rel(P_LENDING_002, DA_LOAN_ACCOUNT, "Read")
' aac rel: source="P_LENDING_002"; target="DA_LOAN_ACCOUNT"; label="Read"; relation="process_uses_data_asset"; access="Read"
Rel(P_LENDING_002, CTL_DEALER_MON, "governed by")
' aac rel: source="P_LENDING_002"; target="CTL_DEALER_MON"; label="governed by"; relation="process_governed_by_control"
Rel(P_LENDING_002, CAP_LEND_01, "supports")
' aac rel: source="P_LENDING_002"; target="CAP_LEND_01"; label="supports"; relation="process_supports_capability"

SHOW_LEGEND()
@enduml
