AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("controls", $bgColor="#fca5a5", $borderColor="#b91c1c", $fontColor="#0f172a", $legendText="control")
AddElementTag("frameworks", $bgColor="#d9f99d", $borderColor="#4d7c0f", $fontColor="#0f172a", $legendText="framework")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_SERV_02, "Account Maintenance & Servicing Requests", "Execute cardholder-requested account changes.", $tags="capabilities")
  ' aac CAP_SERV_02: company_domain="Servicing"
  System(CAP_SERV_05, "Complaint Capture & Resolution", "Capture, classify, resolve, and evidence complaints.", $tags="capabilities")
  ' aac CAP_SERV_05: company_domain="Servicing"
  System(CAP_SERV_01, "Contact Handling & Routing", "Receive and route contacts across voice, chat, and messaging.", $tags="capabilities")
  ' aac CAP_SERV_01: company_domain="Servicing"
  System(CAP_SERV_04, "Correspondence & Notification Management", "Generate and deliver required and elective communications.", $tags="capabilities")
  ' aac CAP_SERV_04: company_domain="Servicing"
  System(CAP_SERV, "Customer Servicing & Care", "Customer Servicing & Care. Level 0 enterprise capability domain (Core tier).", $tags="capabilities")
  ' aac CAP_SERV: company_domain="Servicing"
  System(CAP_SERV_03, "Digital Self-Service", "Enable cardholders to self-serve in web and mobile channels.", $tags="capabilities")
  ' aac CAP_SERV_03: company_domain="Servicing"
  System(CAP_SERV_07, "Hardship & Payment Assistance", "Operate hardship, forbearance, and payment assistance programs.", $tags="capabilities")
  ' aac CAP_SERV_07: company_domain="Servicing"
  System(CAP_SERV_06, "Servicing Knowledge & Agent Enablement", "Equip agents with current, compliant guidance.", $tags="capabilities")
  ' aac CAP_SERV_06: company_domain="Servicing"
  System(CAP_SERV_08, "Servicing Quality Monitoring", "Monitor and score servicing interactions for quality and compliance.", $tags="capabilities")
  ' aac CAP_SERV_08: company_domain="Servicing"
}
Boundary(b_Control, "Control") {
  System(CTL_COMPLAINT_REG, "Complaint regulatory routing", "Complaints are classified to taxonomy, resolved to SLA, and routed to regulators where required; executive and regulator complaints carry expedited handling.", $tags="controls")
  ' aac CTL_COMPLAINT_REG: company_domain=""
  System(CTL_REGE_DETERM, "Dispute determination timeliness and notice", "Final dispute determinations, account adjustment, and the written explanation complete within the Reg E / Reg Z window; the clock is measured from claim receipt.", $tags="controls")
  ' aac CTL_REGE_DETERM: company_domain=""
  System(CTL_NOTICE_CONTENT, "Notice content and delivery evidence", "Required notices use legal-owned templates with version control, and delivery evidence is retained per notice.", $tags="controls")
  ' aac CTL_NOTICE_CONTENT: company_domain=""
  System(CTL_SCRA_MLA, "Servicemember protections screening", "SCRA and MLA eligibility is screened at origination and on notification, with rate and protection application evidenced.", $tags="controls")
  ' aac CTL_SCRA_MLA: company_domain=""
}
Boundary(b_Framework, "Framework") {
  System(FW_BIAN, "BIAN", "The Banking Industry Architecture Network's service landscape. A reference model of banking service domains, organized into business areas. Strong on what a bank does and deliberately silent on how it is run.", $tags="frameworks")
  ' aac FW_BIAN: company_domain=""
}
Boundary(b_Process, "Process") {
  System(P_SERVICING_011, "Administer secured card deposit lifecycle", "Collect, hold, apply, and refund security deposits for secured card accounts, including graduation and charge-off application, with correct accounting and disclosure treatment.", $tags="processes")
  ' aac P_SERVICING_011: company_domain=""
  System(P_SERVICING_012, "Apply servicemember and military lending protections", "Identify covered borrowers, apply the required rate and fee protections, and evidence compliance for servicemember accounts.", $tags="processes")
  ' aac P_SERVICING_012: company_domain=""
  System(P_SERVICING_006, "Capture and resolve complaint", "Capture, classify, resolve, and evidence a cardholder complaint. Complaint handling runs intake through evidenced resolution with regulatory routing where required; the taxonomy feeds UDAAP analysis, so classification is not clerical.", $tags="processes")
  ' aac P_SERVICING_006: company_domain=""
  System(P_SERVICING_008, "Enroll account in hardship or assistance program", "Assess eligibility and enroll an account into a hardship or payment assistance program. Hardship enrollment applies documented eligibility consistently; program terms change interest, fees, and reporting, so enrollment is evidenced and reviewed.", $tags="processes")
  ' aac P_SERVICING_008: company_domain=""
  System(P_DIGITAL_001, "Enroll cardholder in digital servicing", "Register and authenticate a cardholder for web and mobile self-service. Enrollment binds the cardholder to a verified identity with step-up options; weak enrollment is the account-takeover front door, so identity proofing follows the fraud strategy.", $tags="processes")
  ' aac P_DIGITAL_001: company_domain=""
  System(P_SERVICING_004, "Execute account maintenance request", "Execute a cardholder-requested change to account details or preferences. Maintenance changes execute after authentication with an audit trail; address changes get extra scrutiny because they precede takeover fraud.", $tags="processes")
  ' aac P_SERVICING_004: company_domain=""
  System(P_DISPUTE_004, "Finalize dispute determination and notify", "Make the final dispute determination, adjust the account, and issue the compliant notice. The determination closes the Reg E or Reg Z clock: account adjustment, provisional credit disposition, and the written explanation must all land within the window.", $tags="processes")
  ' aac P_DISPUTE_004: company_domain=""
  System(P_SERVICING_007, "Generate and deliver required notice", "Generate and deliver a regulatory or contractual notice to the cardholder. Notice generation is driven by account events with content owned by legal and compliance; proof of delivery and version are retained per notice.", $tags="processes")
  ' aac P_SERVICING_007: company_domain=""
  System(P_CUST_INQ_001, "Handle cardholder inquiry", "Receive, understand, and resolve a cardholder inquiry across any servicing channel. First-contact resolution is the design goal across phone, chat, and secure message; anything unresolved routes to a case with ownership and a promise date.", $tags="processes")
  ' aac P_CUST_INQ_001: company_domain=""
  System(P_SERVICING_009, "Maintain servicing knowledge content", "Author, review, and publish agent-facing knowledge and guidance. Knowledge content is the agent's authority in the moment; review cadence and ownership keep it aligned with policy, because stale guidance becomes wrong answers at scale.", $tags="processes")
  ' aac P_SERVICING_009: company_domain=""
  System(P_SERVICING_010, "Monitor and score servicing interactions", "Sample, monitor, score, and calibrate servicing interactions for quality and regulatory compliance signal.", $tags="processes")
  ' aac P_SERVICING_010: company_domain=""
  System(P_DIGITAL_002, "Serve digital self-service transaction", "Execute a cardholder self-service action in web or mobile without agent involvement. Self-service actions execute against the same core services as agent actions, with the same entitlements; the channel changes, the control does not.", $tags="processes")
  ' aac P_DIGITAL_002: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CARDSVC_API, "Card Servicing Service", "The service behind the Card Servicing API, backing the channel. Built with AKS · Card Servicing Cache.", $tags="systems")
  ' aac SYS_CARDSVC_API: company_domain="Servicing"; hosting="Azure"; technology="AKS · Card Servicing Cache"
  System(SYS_CARDSVC_WEB, "Card Servicing Web", "Browser front end for Card Servicing. Built with AKS.", $tags="systems")
  ' aac SYS_CARDSVC_WEB: company_domain="Servicing"; hosting="Azure"; technology="AKS"
  System(SYS_COLLECT_API, "Collections Workspace Service", "The service behind the Collections Workspace API, backing the channel. Built with AKS · Collections Workspace Cache.", $tags="systems")
  ' aac SYS_COLLECT_API: company_domain="Collections"; hosting="Azure"; technology="AKS · Collections Workspace Cache"
  System(SYS_CONTACT, "Contact center platform", "Contact center routing, voice, and digital channels.", $tags="systems")
  ' aac SYS_CONTACT: company_domain=""
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
  System(SYS_DOC, "Document management and archive", "Document generation, management, and archive.", $tags="systems")
  ' aac SYS_DOC: company_domain=""
  System_Ext(SYS_CRM, "Dynamics 365 Customer Service", "Contact center desktop and case management for servicing agents. Built with Microsoft.", $tags="systems")
  ' aac SYS_CRM: company_domain="Servicing"; hosting="SaaS"; technology="Microsoft"
  System_Ext(SYS_DISPUTES_SAAS, "Pega Smart Dispute", "Dispute Management Platform, provided by Pegasystems and running in the vendor tenancy. Built with Pegasystems.", $tags="systems")
  ' aac SYS_DISPUTES_SAAS: company_domain="Servicing"; hosting="SaaS"; technology="Pegasystems"
  System(SYS_STATEMENTS, "Statement Generation", "Composes, renders and dispatches customer statements.", $tags="systems")
  ' aac SYS_STATEMENTS: company_domain="Servicing"; hosting="On-prem"
}

