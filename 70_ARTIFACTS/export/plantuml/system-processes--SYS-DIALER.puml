@startuml
' Outbound contact platform — Processes and Capabilities
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Outbound contact platform — Processes and Capabilities

AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_COLL_07, "Collections Compliance Oversight", "Assure conformance with debt collection, contact, and state-law requirements.", $tags="capabilities")
  ' aac CAP_COLL_07: company_domain="Collections"
  System(CAP_LEND_05, "Installment Loan Servicing", "Bill, post, and service fixed-term installment loans: payments, payoffs, extensions, and customer contact.", $tags="capabilities")
  ' aac CAP_LEND_05: company_domain="Lending"
  System(CAP_COLL_02, "Outbound Contact Operations", "Execute dialer, digital, and letter treatment.", $tags="capabilities")
  ' aac CAP_COLL_02: company_domain="Collections"
  System(CAP_COLL_02_01, "Owned-Portfolio Collections Contact", "Contact delinquent borrowers on the bank's own card and loan portfolios.", $tags="capabilities")
  ' aac CAP_COLL_02_01: company_domain="Collections"
  System(CAP_COLL_02_02, "Serviced-Portfolio Collections Contact", "Collect on client portfolios to each client's strategy and in its name.", $tags="capabilities")
  ' aac CAP_COLL_02_02: company_domain="Collections"
}
Boundary(b_Process, "Process") {
  System(P_LENDING_011, "Collect delinquent installment loan", "Work past-due installment loans through calls, letters and digital contact, take promises and arrangements, and decide when a loan goes to repossession. Recreation loans are secured and seasonal, so treatment weighs the collateral and the season as well as the days past due; the contact limits that apply to cards apply here too.", $tags="processes")
  ' aac P_LENDING_011: company_domain=""
  System(P_COLLECTIONS_010, "Collect serviced client portfolio to client strategy", "Work delinquent accounts on a client's portfolio to the client's own treatment strategy, scripts and settlement authority, in the client's name, and report results back under the servicing agreement. Collecting another lender's accounts brings third-party collector rules into play, so contact and notice rules can differ from those on the bank's own portfolio.", $tags="processes")
  ' aac P_COLLECTIONS_010: company_domain=""
  System(P_COLLECTIONS_002, "Execute outbound collections contact", "Execute outbound contact attempts within contact-frequency and communication constraints. Contact windows, frequency caps, and channel consent come from FDCPA, Reg F, and TCPA; the process starts at queue release and ends when the disposition is recorded.", $tags="processes")
  ' aac P_COLLECTIONS_002: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_DIALER, "Outbound contact platform", "Outbound dialer and contact campaign execution.", $tags="systems")
  ' aac SYS_DIALER: company_domain=""
}

