!include <C4/C4_Deployment>

title Build rewards redemption on Azure — Footprint

AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")
AddElementTag("work_packages", $bgColor="#ccfbf1", $borderColor="#0d9488", $fontColor="#0f172a", $legendText="work package")

Boundary(b_Capability, "Capability") {
  System(CAP_BILL_04_03, "Rewards Delivery", "Deliver redeemed value to the cardholder or partner.", $tags="capabilities")
  ' aac CAP_BILL_04_03: company_domain="Servicing"
  System(CAP_BILL_04, "Rewards Earn, Accrual & Redemption", "Operate the rewards ledger, accrual, and redemption.", $tags="capabilities")
  ' aac CAP_BILL_04: company_domain="Servicing"
  System(CAP_BILL_04_02, "Rewards Redemption", "Execute redemptions across cash, credit, and partner channels.", $tags="capabilities")
  ' aac CAP_BILL_04_02: company_domain="Servicing"
}
Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_REWARDS_OPERATIONAL, "Rewards Redemption operational data", "Operational records held by Rewards Redemption.", $tags="data_assets")
  ' aac DA_REWARDS_OPERATIONAL: company_domain="Card Issuing"
}
Boundary(b_Process, "Process") {
  System(P_REWARDS_001, "Accrue rewards earn", "Calculate and post rewards earn to the rewards ledger for qualifying activity. Earn accrues per the program terms with promotional multipliers; the accrual creates the liability finance reconciles, so earn rules and accounting stay in lockstep.", $tags="processes")
  ' aac P_REWARDS_001: company_domain=""
  System(P_STMT_GEN_001, "Cut cycle and generate statement", "Cut the billing cycle and generate the cardholder statement including the rewards position. Cycle cut is the hard deadline that sequences assessment, statement generation, and delivery; a late cut cascades into payment due dates and regulatory timing.", $tags="processes")
  ' aac P_STMT_GEN_001: company_domain=""
  System(P_REWARDS_002, "Process rewards redemption", "Execute a cardholder rewards redemption and settle the resulting obligation. Redemption executes across cash, statement credit, and partner channels; partner settlement follows the program contract, and failed redemptions reverse cleanly.", $tags="processes")
  ' aac P_REWARDS_002: company_domain=""
  System(P_REWARDS_003, "Reconcile rewards liability", "Reconcile the rewards ledger to the recorded liability and resolve differences. The rewards liability reconciliation catches earn, redemption, and expiry drift between the ledger and finance; differences are investigated, not plugged.", $tags="processes")
  ' aac P_REWARDS_003: company_domain=""
  System(P_REWARDS_004, "Serve redemption catalog and fulfill orders", "Serve the rewards catalog, take redemptions for statement credit, gift cards, merchandise and travel, send orders to the fulfillment partners, and reverse the points when an order fails or comes back. The rewards liability is relieved only when value is delivered, so undelivered orders are tracked until they close.", $tags="processes")
  ' aac P_REWARDS_004: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_REWARDS_WORKER, "Rewards Redemption Async Worker", "Consumes redemption events and fulfills them: statement credits posted to the ledger, gift-card orders placed with the fulfillment partner. Built with AKS · Event Hubs.", $tags="systems")
  ' aac SYS_REWARDS_WORKER: company_domain="Card Issuing"; hosting="Azure"; technology="AKS · Event Hubs"
  System(SYS_REWARDS_STORE, "Rewards Redemption Database", "Relational database for Rewards Redemption, encrypted with a customer managed key. Built with Azure SQL.", $tags="systems")
  ' aac SYS_REWARDS_STORE: company_domain="Card Issuing"; hosting="Azure"; technology="Azure SQL"
  System(SYS_REWARDS_EVENTS, "Rewards Redemption Event Publisher", "Publishes Rewards Redemption domain events onto the enterprise bus. Built with Service Bus.", $tags="systems")
  ' aac SYS_REWARDS_EVENTS: company_domain="Card Issuing"; hosting="Azure"; technology="Service Bus"
  System(SYS_REWARDS_API, "Rewards Redemption Service", "Domain service for Rewards Redemption, behind the Rewards Redemption API. Built with AKS · Rewards Redemption Cache.", $tags="systems")
  ' aac SYS_REWARDS_API: company_domain="Card Issuing"; hosting="Azure"; technology="AKS · Rewards Redemption Cache"
  System(SYS_REWARDS_WEB, "Rewards Redemption Web", "Customer-facing front end for Rewards Redemption. Built with AKS.", $tags="systems")
  ' aac SYS_REWARDS_WEB: company_domain="Card Issuing"; hosting="Azure"; technology="AKS"
}
Boundary(b_Work_Package, "Work Package") {
  System(WP_REWARDS_BUILD, "Build rewards redemption on Azure", "The first product on the Azure digital shape: the catalog and redemption web front end and API, the product datastore, the event publisher, and the worker that fulfills a redemption after the response. Balances stay with the proposed rewards ledger; this is the channel in front of it.", $tags="work_packages")
  ' aac WP_REWARDS_BUILD: company_domain="Card Issuing"
}

