  System(CAP_COLL_04, "Charge-off Processing", "Execute charge-off on policy timing with the correct accounting effect.", $tags="capabilities")
  ' aac CAP_COLL_04: company_domain="Collections"
  System(CAP_PAY_02, "Clearing & Transaction Posting", "Receive clearing files and post transactions to accounts.", $tags="capabilities")
