Boundary(b_Control, "Control") {
  System(CTL_ADVERSE_ACT, "Adverse action notice completeness", "Every declined application generates a compliant adverse action notice with the principal reasons, within the required period.", $tags="controls")
  ' aac CTL_ADVERSE_ACT: company_domain=""
  System(CTL_AUTH_AVAIL, "Authorization availability and stand-in", "Authorization availability is monitored against the network SLA with tested stand-in arrangements; incidents invoke the resilience playbook.", $tags="controls")
  ' aac CTL_AUTH_AVAIL: company_domain=""
  System(CTL_AUTH_POLICY, "Cardholder authentication to policy", "Cardholder authentication meets the risk-tiered policy before disclosure or account change, across every servicing channel.", $tags="controls")
  ' aac CTL_AUTH_POLICY: company_domain=""
  System(CTL_CHARGEOFF_TIME, "Charge-off timing to policy", "Charge-off executes at the policy timing aligned to regulatory guidance, with exceptions approved and documented.", $tags="controls")
  ' aac CTL_CHARGEOFF_TIME: company_domain=""
  System(CTL_CLIENT_SLA, "Client reporting and feed monitoring", "Contracted client reporting and data feeds are monitored to schedule and specification; misses alert before the client notices and count against the SLA.", $tags="controls")
  ' aac CTL_CLIENT_SLA: company_domain=""
  System(CTL_CLOSE_SIGNOFF, "Close reconciliation sign-off", "Period-end reconciliations and journal approvals complete with segregation of duties before financial sign-off.", $tags="controls")
  ' aac CTL_CLOSE_SIGNOFF: company_domain=""
  System(CTL_COMPLAINT_REG, "Complaint regulatory routing", "Complaints are classified to taxonomy, resolved to SLA, and routed to regulators where required; executive and regulator complaints carry expedited handling.", $tags="controls")
  ' aac CTL_COMPLAINT_REG: company_domain=""
  System(CTL_CONV_VERIFY, "Conversion balance and record verification", "Portfolio conversions verify record counts, balances, and regulatory continuity before and after cutover, with client sign-off at each gate.", $tags="controls")
  ' aac CTL_CONV_VERIFY: company_domain=""
  System(CTL_CYCLE_VALID, "Cycle assessment validation", "Interest, fee, and minimum-payment computation is validated against the cardholder agreement on every pricing or product change, and sampled each cycle.", $tags="controls")
  ' aac CTL_CYCLE_VALID: company_domain=""
  System(CTL_DAILY_RECON, "Daily settlement and clearing reconciliation", "Network settlement, clearing files, and interchange postings reconcile to network totals daily; unreconciled variances stop downstream posting.", $tags="controls")
  ' aac CTL_DAILY_RECON: company_domain=""
  System(CTL_DQ_GATE, "Ingestion data quality gate", "Source ingestion enforces schema and quality thresholds at the boundary; failing loads quarantine rather than land.", $tags="controls")
  ' aac CTL_DQ_GATE: company_domain=""
  System(CTL_CHG_APPROVAL, "Production change approval", "No change reaches production without an approved change record, test evidence, and a rollback plan; emergency changes are reviewed after the fact.", $tags="controls")
  ' aac CTL_CHG_APPROVAL: company_domain=""
  System(CTL_DR_TEST, "Recovery test against committed objectives", "Recovery is exercised at least annually against stated RTO/RPO; misses produce tracked remediation.", $tags="controls")
  ' aac CTL_DR_TEST: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
}

