' aac rel: source="SYS_FRAUD_DETECT"; target="DA_AUTH_LOG"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(P_PAYMENTS_006, DA_AUTH_LOG, "Both")
' aac rel: source="P_PAYMENTS_006"; target="DA_AUTH_LOG"; label="Both"; relation="process_uses_data_asset"; access="Both"
Rel(P_PAYMENTS_007, DA_AUTH_LOG, "Read")
' aac rel: source="P_PAYMENTS_007"; target="DA_AUTH_LOG"; label="Read"; relation="process_uses_data_asset"; access="Read"
Rel(P_COMPLIANCE_008, DA_AUTH_LOG, "Read")
' aac rel: source="P_COMPLIANCE_008"; target="DA_AUTH_LOG"; label="Read"; relation="process_uses_data_asset"; access="Read"

