@startuml
' Transaction fraud detection — Processes and Capabilities
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Transaction fraud detection — Processes and Capabilities

AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_PAY_01_02, "Authorization Fraud Screening", "Real-time fraud scoring inside the authorization decision.", $tags="capabilities")
  ' aac CAP_PAY_01_02: company_domain="Servicing"
  System(CAP_PAY_01, "Authorization Processing", "Decision and respond to real-time authorization requests.", $tags="capabilities")
  ' aac CAP_PAY_01: company_domain="Servicing"
  System(CAP_CRED_06, "Authorization Strategy Management", "Set the rules governing real-time authorization decisions.", $tags="capabilities")
  ' aac CAP_CRED_06: company_domain="Originations"
  System(CAP_PAY_01_01, "Credential Authentication", "Validate card credentials and cryptograms in the authorization path.", $tags="capabilities")
  ' aac CAP_PAY_01_01: company_domain="Servicing"
  System(CAP_PAY_01_03, "Credit & Limit Check", "Open-to-buy and account-status verification at authorization.", $tags="capabilities")
  ' aac CAP_PAY_01_03: company_domain="Servicing"
  System(CAP_FRAUD_08, "First-Party Fraud & Bust-Out Management", "Detect and act on credit abuse by account holders themselves: bust-out, synthetic identities and payment fraud.", $tags="capabilities")
  ' aac CAP_FRAUD_08: company_domain="Servicing"
  System(CAP_FRAUD_02, "Fraud Case Investigation", "Investigate and adjudicate fraud cases.", $tags="capabilities")
  ' aac CAP_FRAUD_02: company_domain="Servicing"
  System(CAP_MERCH_06, "Merchant Monitoring & Exposure Management", "Monitor merchant transaction behavior, credit exposure, and collusion or bust-out patterns across the portfolio.", $tags="capabilities")
  ' aac CAP_MERCH_06: company_domain="Merchant Services"
  System(CAP_FRAUD_01, "Transaction Fraud Detection & Strategy", "Detect fraudulent transactions in flight and set detection strategy.", $tags="capabilities")
  ' aac CAP_FRAUD_01: company_domain="Servicing"
  System(CAP_PAY_01_05, "Transaction Switching", "Route authorization traffic between networks and the host.", $tags="capabilities")
  ' aac CAP_PAY_01_05: company_domain="Servicing"
}
Boundary(b_Process, "Process") {
  System(P_FRAUD_007, "Detect and act on first-party fraud and bust-out", "Spot accounts run up to the limit by their owners with no intent to repay, from rapid balance build, payments that return and links between applications, then restrict the account and route it to fraud rather than collections. Booked as credit loss, first-party fraud is worked by the wrong team and reported in the wrong line.", $tags="processes")
  ' aac P_FRAUD_007: company_domain=""
  System(P_FRAUD_001, "Detect and action transaction fraud alert", "Detect a suspected fraudulent transaction, action the alert, and contact the cardholder. Alert handling runs against loss and customer-friction budgets; actions span block, reissue, and contact, and the clock matters because exposure grows per transaction.", $tags="processes")
  ' aac P_FRAUD_001: company_domain=""
  System(P_FRAUD_002, "Investigate and adjudicate fraud case", "Investigate a suspected fraud case and reach a documented determination. The case determination separates true fraud from friendly fraud and abuse, drives the Reg E liability decision, and feeds the loss and strategy data.", $tags="processes")
  ' aac P_FRAUD_002: company_domain=""
  System(P_CREDIT_007, "Maintain authorization strategy", "Define and deploy the rules governing real-time authorization decisions. Authorization strategy balances approval rates, fraud losses, and credit exposure in real time; changes deploy through the same testing discipline as origination strategy.", $tags="processes")
  ' aac P_CREDIT_007: company_domain=""
  System(P_FRAUD_006, "Maintain fraud detection strategy", "Define, test, and deploy changes to fraud detection rules and models. Strategy changes are tested against recent fraud and false-positive performance before deployment; every rule change is versioned and reversible.", $tags="processes")
  ' aac P_FRAUD_006: company_domain=""
  System(P_MERCHANT_009, "Monitor merchant exposure and activity", "Watch merchant volume, ticket size, refund and chargeback ratios and future delivery exposure against approved limits, and investigate spikes, collusion and bust-out patterns. Excessive chargeback ratios put the merchant and the bank into network monitoring programs, with fines.", $tags="processes")
  ' aac P_MERCHANT_009: company_domain=""
  System(P_PAYMENTS_001, "Process authorization request", "Receive, decision, and respond to a real-time authorization request within the network response window.", $tags="processes")
  ' aac P_PAYMENTS_001: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_FRAUD_DETECT, "Transaction fraud detection", "Real-time transaction fraud scoring and alerting.", $tags="systems")
  ' aac SYS_FRAUD_DETECT: company_domain=""
}

