' aac rel: source="WP_MERCHANT_PORTAL"; target="SYS_MERCHANT_API"; label="Builds"; relation="work_package_affects_system"; effect="Builds"
Rel(WP_MERCHANT_PORTAL, SYS_MERCHANT_STORE, "Builds")
' aac rel: source="WP_MERCHANT_PORTAL"; target="SYS_MERCHANT_STORE"; label="Builds"; relation="work_package_affects_system"; effect="Builds"
Rel(WP_MERCHANT_PORTAL, SYS_MERCHANT_EVENTS, "Builds")
' aac rel: source="WP_MERCHANT_PORTAL"; target="SYS_MERCHANT_EVENTS"; label="Builds"; relation="work_package_affects_system"; effect="Builds"
Rel(SYS_MERCHANT_API, DA_MERCHANT_OPERATIONAL, "ReadWrite")
' aac rel: source="SYS_MERCHANT_API"; target="DA_MERCHANT_OPERATIONAL"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"

SHOW_LEGEND()
