Boundary(b_Capability, "Capability") {
  System(CAP_MERCH_02_01, "Merchant Credit Underwriting", "Assess a merchant's credit and chargeback exposure, and set its limits and reserve terms.", $tags="capabilities")
  ' aac CAP_MERCH_02_01: company_domain="Merchant Services"
  System(CAP_MERCH_07, "Merchant Servicing & Billing", "Bill merchant fees, deliver statements, pay ISO residuals and answer merchant and ISO questions.", $tags="capabilities")
  ' aac CAP_MERCH_07: company_domain="Merchant Services"
  System(CAP_MERCH_02, "Merchant Underwriting & Risk Vetting", "Underwrite merchants against credit and brand risk appetite — the specialty-vertical appetite is the differentiator.", $tags="capabilities")
  ' aac CAP_MERCH_02: company_domain="Merchant Services"
}
Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_MERCHANT, "Merchant master and underwriting file", "Merchant identity, beneficial owners, underwriting decision, limits, pricing and screening results.", $tags="data_assets")
  ' aac DA_MERCHANT: company_domain=""
  SystemDb(DA_MERCHANT_OPERATIONAL, "Merchant Portal operational data", "Operational records held by Merchant Portal.", $tags="data_assets")
  ' aac DA_MERCHANT_OPERATIONAL: company_domain="Payments"
  SystemDb(DA_MERCH_SETTLE, "Merchant settlement and reserve ledger", "Daily merchant volume, fees, chargebacks, funding and reserve balances.", $tags="data_assets")
  ' aac DA_MERCH_SETTLE: company_domain=""
}
Boundary(b_Process, "Process") {
  System(P_MERCHANT_011, "Bill merchant fees and serve statements", "Calculate the month's processing, network and service fees, deliver the merchant statement, pay ISO residuals, and answer merchant and ISO questions about funding and fees. Statements are what a merchant checks its funding against, so a pricing error found here is a refund to many merchants at once.", $tags="processes")
  ' aac P_MERCHANT_011: company_domain=""
  System(P_MERCHANT_005, "Board merchant and register with networks", "Set the approved merchant up on the acquiring platform with its pricing, limits and reserve, assign merchant and terminal ids, and register it with the card networks under the bank's sponsorship. Boarding is where approved terms become system parameters, and a limit keyed wrong is exposure nobody approved.", $tags="processes")
  ' aac P_MERCHANT_005: company_domain=""
  System(P_MERCHANT_002, "Capture merchant application", "Take a merchant's application, sent by an ISO or made directly in the merchant portal, with its owners, processing history, business model and bank account, and check it is complete before underwriting. Beneficial ownership is collected here because sanctions screening and the network's terminated-merchant check both read it.", $tags="processes")
  ' aac P_MERCHANT_002: company_domain=""
  System(P_MERCHANT_009, "Monitor merchant exposure and activity", "Watch merchant volume, ticket size, refund and chargeback ratios and future delivery exposure against approved limits, and investigate spikes, collusion and bust-out patterns. Excessive chargeback ratios put the merchant and the bank into network monitoring programs, with fines.", $tags="processes")
  ' aac P_MERCHANT_009: company_domain=""
  System(P_MERCHANT_001, "Onboard and oversee ISO or agent", "Diligence and contract an independent sales organization or agent, register it with the networks, and review its portfolio quality, complaints and residuals each month. The bank sponsors the ISO's merchants into the networks and carries their liability, so an ISO's underwriting shortcuts become the bank's chargeback losses.", $tags="processes")
  ' aac P_MERCHANT_001: company_domain=""
  System(P_MERCHANT_008, "Process acquiring chargeback", "Receive chargebacks from the networks against merchants, debit the merchant or its reserve, collect the merchant's evidence and represent within the reason code's window, and absorb the loss when the merchant cannot pay. Chargebacks a merchant cannot cover fall on the bank as its sponsor.", $tags="processes")
  ' aac P_MERCHANT_008: company_domain=""
  System(P_MERCHANT_004, "Screen merchant against sanctions and network lists", "Screen the business and its owners against sanctions lists and the networks' terminated-merchant file, and review prohibited and brand-damaging business types before boarding. A merchant on the terminated file, or in a prohibited category, boarded under the bank's sponsorship draws network fines on the bank.", $tags="processes")
  ' aac P_MERCHANT_004: company_domain=""
  System(P_MERCHANT_007, "Set and adjust merchant reserve", "Set the reserve or delayed funding a merchant must carry, raise it when chargebacks, refunds or delivery risk grow, and release it when exposure ends after the merchant leaves. Reserves are held merchant money, so each change is evidenced against the merchant agreement.", $tags="processes")
  ' aac P_MERCHANT_007: company_domain=""
  System(P_MERCHANT_006, "Settle and fund merchants", "Clear the day's card volume, net out fees, chargebacks and reserve holds, and fund each merchant's bank account by ACH, reconciling network settlement to merchant funding. Funding a merchant that should have been held is exactly the loss the reserve was meant to cover.", $tags="processes")
  ' aac P_MERCHANT_006: company_domain=""
  System(P_MERCHANT_010, "Terminate merchant and report to network list", "Close a merchant for risk, fraud or breach, hold funds to cover the chargeback tail, and add it to the networks' terminated-merchant file where the rules require. A termination that is not reported lets the merchant board elsewhere, and is itself a rule breach.", $tags="processes")
  ' aac P_MERCHANT_010: company_domain=""
  System(P_MERCHANT_003, "Underwrite merchant", "Assess the merchant's credit, processing history, delivery timeframes and chargeback exposure against the appetite for its business type, and approve with limits and reserve terms, or decline. Specialty and higher-risk business types are the point of the program, so underwriting sets the exposure every later step monitors.", $tags="processes")
  ' aac P_MERCHANT_003: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_MERCHANT_STORE, "Merchant Portal Database", "Relational database for Merchant Portal, encrypted with a customer managed key. Built with Azure SQL.", $tags="systems")
  ' aac SYS_MERCHANT_STORE: company_domain="Payments"; hosting="Azure"; technology="Azure SQL"
  System(SYS_MERCHANT_EVENTS, "Merchant Portal Event Publisher", "Publishes Merchant Portal domain events onto the enterprise bus. Built with Service Bus.", $tags="systems")
  ' aac SYS_MERCHANT_EVENTS: company_domain="Payments"; hosting="Azure"; technology="Service Bus"
  System(SYS_MERCHANT_API, "Merchant Portal Service", "Domain API for the merchant portal: applications, settlement inquiries, chargeback responses and statement downloads. Built with AKS · Merchant Portal Cache.", $tags="systems")
  ' aac SYS_MERCHANT_API: company_domain="Payments"; hosting="Azure"; technology="AKS · Merchant Portal Cache"
  System(SYS_MERCHANT_WEB, "Merchant Portal Web", "Customer-facing front end for Merchant Portal. Built with AKS.", $tags="systems")
  ' aac SYS_MERCHANT_WEB: company_domain="Payments"; hosting="Azure"; technology="AKS"
}
Boundary(b_Work_Package, "Work Package") {
  System(WP_MERCHANT_PORTAL, "Assemble the merchant portal on Azure", "The merchant portal from the library's parts: the API, the web channel, the datastore, the event publisher, and the onboarding analyst role the product creates. Assembled as one product file with no shape; the landing zone answers for the gateway, the cluster, the database and the bus.", $tags="work_packages")
  ' aac WP_MERCHANT_PORTAL: company_domain="Payments"
}

