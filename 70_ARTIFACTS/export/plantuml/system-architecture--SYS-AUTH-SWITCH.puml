@startuml
' Authorization Switch — Architecture
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Authorization Switch — Architecture

AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("offered_interfaces", $bgColor="#e6ecff", $borderColor="#6366f1", $fontColor="#0f172a", $legendText="offered interface")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")
AddElementTag("tech_services", $bgColor="#fed7aa", $borderColor="#c2410c", $fontColor="#0f172a", $legendText="technology service")
AddRelTag("api-call", $legendText="API call")
AddRelTag("queued-request", $legendText="Request on a queue")

Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_CARD_ACCOUNT, "Card account master", "Account, balance, limit and status records for every card account.", $tags="data_assets")
  ' aac DA_CARD_ACCOUNT: company_domain="Card Issuing"
  SystemDb(DA_TRANSACTION, "Card transaction history", "Authorized, cleared and settled card transactions.", $tags="data_assets")
  ' aac DA_TRANSACTION: company_domain="Payments"
  SystemDb(DA_MODEL_FEAT, "Model feature store", "Curated features and scores for credit, fraud, and collections models.", $tags="data_assets")
  ' aac DA_MODEL_FEAT: company_domain=""
  SystemDb(DA_PAYMENT_INSTR, "Payment instructions", "Cardholder payment methods and instructions: ACH details, scheduled payments.", $tags="data_assets")
  ' aac DA_PAYMENT_INSTR: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_AUTH_SWITCH, "Authorization Switch", "Real-time card authorization switch connected to the scheme networks.", $tags="systems")
  ' aac SYS_AUTH_SWITCH: company_domain="Payments"; hosting="On-prem"
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
  System(OI_LEDGER_QUEUE, "Core Ledger request queue", "Postings, holds and balance requests put on the ledger's MQ request queue, answered on the reply queue in the order they arrived. Built with MQ.", $tags="offered_interfaces")
  ' aac OI_LEDGER_QUEUE: company_domain="Card Issuing"; technology="MQ"
  System(SYS_SCREENING_GATEWAY, "NICE Actimize Screening Integration Gateway", "Our side of the NICE Actimize integration: request mapping, retry and back-off, circuit breaking when the vendor is down, and the audit trail of what we sent them. Built with EKS.", $tags="systems")
  ' aac SYS_SCREENING_GATEWAY: company_domain="Risk and Compliance"; hosting="AWS"; technology="EKS"
  System(SYS_TOKEN, "Tokenization and credential management", "Token and credential lifecycle management.", $tags="systems")
  ' aac SYS_TOKEN: company_domain=""
  System(SYS_FRAUD_DETECT, "Transaction fraud detection", "Real-time transaction fraud scoring and alerting.", $tags="systems")
  ' aac SYS_FRAUD_DETECT: company_domain=""
}
Boundary(b_Technology_Service, "Technology Service") {
  Deployment_Node(TS_AWS_APIGW, "Amazon API Gateway", "API gateway", "The managed front door every AWS-hosted API is published through.", $tags="tech_services") {
    ' aac TS_AWS_APIGW: company_domain="Enterprise Platform"; technology="API gateway"
  }
  Deployment_Node(TS_AWS_CLOUDWATCH, "Amazon CloudWatch", "Observability", "Metrics, logs and alarms for every workload in the landing zone.", $tags="tech_services") {
    ' aac TS_AWS_CLOUDWATCH: company_domain="Enterprise Platform"; technology="Observability"
  }
  Deployment_Node(TS_AWS_EKS, "Amazon EKS", "Container platform", "Managed Kubernetes running the containerized workloads.", $tags="tech_services") {
    ' aac TS_AWS_EKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Deployment_Node(TS_AWS_SECRETS, "AWS Secrets Manager", "Secrets manager", "Application credentials and rotation.", $tags="tech_services") {
    ' aac TS_AWS_SECRETS: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_ONPREM_DC, "Primary Data Center", "Virtual network", "The data center the mainframe and the authorization switch live in. Modeled because half the integration cost of any cloud onboarding is the path back to here.", $tags="tech_services") {
    ' aac TS_ONPREM_DC: company_domain="Enterprise Platform"; technology="Virtual network"
  }
  Deployment_Node(TS_NET_VPC_RISKOPS, "Risk Operations VPC", "Virtual network", "Workload VPC for screening and risk tooling.", $tags="tech_services") {
    ' aac TS_NET_VPC_RISKOPS: company_domain="Risk and Compliance"; technology="Virtual network"
  }
}

Rel(SYS_AUTH_SWITCH, SYS_FRAUD_DETECT, "Authorization Switch to Transaction Fraud Detection", "ISO8583")
' aac rel: source="SYS_AUTH_SWITCH"; target="SYS_FRAUD_DETECT"; label="Authorization Switch to Transaction Fraud Detection"; interface_id="INT-AUTH-FRAUD"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"; patterns="inline-risk-decision"
Rel(SYS_AUTH_SWITCH, SYS_TOKEN, "Authorization Switch to Tokenization Service", "HTTPS", $tags="api-call")
' aac rel: source="SYS_AUTH_SWITCH"; target="SYS_TOKEN"; label="Authorization Switch to Tokenization Service"; interface_id="INT-AUTH-TOKEN"; kind="api-call"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"; patterns="tokenized-card-data"
Rel(SYS_AUTH_SWITCH, OI_LEDGER_QUEUE, "Authorization Switch to Core Ledger", "MQ", $tags="queued-request")
' aac rel: source="SYS_AUTH_SWITCH"; target="OI_LEDGER_QUEUE"; label="Authorization Switch to Core Ledger"; interface_id="INT-AUTH-LEDGER"; kind="queued-request"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"; offered_interface_id="OI-LEDGER-QUEUE"
Rel(SYS_AUTH_SWITCH, SYS_SCREENING_GATEWAY, "SYS-AUTH-SWITCH to NICE Actimize Screening Gateway", "HTTPS", $tags="api-call")
' aac rel: source="SYS_AUTH_SWITCH"; target="SYS_SCREENING_GATEWAY"; label="SYS-AUTH-SWITCH to NICE Actimize Screening Gateway"; interface_id="INT-SCREENING-CALLER-GATEWAY"; kind="api-call"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"
Rel(SYS_SCREENING_GATEWAY, TS_AWS_EKS, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_AWS_EKS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_GATEWAY, TS_AWS_APIGW, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_AWS_APIGW"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_GATEWAY, TS_AWS_SECRETS, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_AWS_SECRETS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_GATEWAY, TS_AWS_CLOUDWATCH, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_AWS_CLOUDWATCH"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_GATEWAY, TS_NET_VPC_RISKOPS, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_NET_VPC_RISKOPS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CORE_LEDGER, TS_ONPREM_DC, "runs on")
' aac rel: source="SYS_CORE_LEDGER"; target="TS_ONPREM_DC"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_AUTH_SWITCH, TS_ONPREM_DC, "runs on")
' aac rel: source="SYS_AUTH_SWITCH"; target="TS_ONPREM_DC"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_FRAUD_DETECT, DA_TRANSACTION, "Read")
' aac rel: source="SYS_FRAUD_DETECT"; target="DA_TRANSACTION"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_FRAUD_DETECT, DA_MODEL_FEAT, "Read")
' aac rel: source="SYS_FRAUD_DETECT"; target="DA_MODEL_FEAT"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_CORE_LEDGER, DA_PAYMENT_INSTR, "Read")
' aac rel: source="SYS_CORE_LEDGER"; target="DA_PAYMENT_INSTR"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_TOKEN, DA_CARD_ACCOUNT, "Read")
' aac rel: source="SYS_TOKEN"; target="DA_CARD_ACCOUNT"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_AUTH_SWITCH, DA_CARD_ACCOUNT, "Read")
' aac rel: source="SYS_AUTH_SWITCH"; target="DA_CARD_ACCOUNT"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_AUTH_SWITCH, DA_TRANSACTION, "ReadWrite")
' aac rel: source="SYS_AUTH_SWITCH"; target="DA_TRANSACTION"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(SYS_CORE_LEDGER, DA_CARD_ACCOUNT, "ReadWrite")
' aac rel: source="SYS_CORE_LEDGER"; target="DA_CARD_ACCOUNT"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(OI_LEDGER_QUEUE, SYS_CORE_LEDGER, "offered by")
' aac rel: source="OI_LEDGER_QUEUE"; target="SYS_CORE_LEDGER"; label="offered by"; field="system_id"

SHOW_LEGEND()
@enduml
