' aac rel: source="P_MERCHANT_010"; target="DA_MERCH_SETTLE"; label="Write"; relation="process_uses_data_asset"; access="Write"
Rel(P_MERCHANT_010, CTL_MERCH_EXPOSURE, "governed by")
