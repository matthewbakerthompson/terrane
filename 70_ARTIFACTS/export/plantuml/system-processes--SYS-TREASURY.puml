@startuml
' Treasury management — Processes and Capabilities
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Treasury management — Processes and Capabilities

AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_DEP_03_01, "Broker Network & Issuance", "Agree brokered CD issues with Treasury and place them through the broker-dealer network.", $tags="capabilities")
  ' aac CAP_DEP_03_01: company_domain="Deposits"
  System(CAP_DEP_03, "Brokered CD Program Management", "Issue and administer CDs through broker-dealer networks: allocations, settlement, and broker relationships. A primary funding channel.", $tags="capabilities")
  ' aac CAP_DEP_03: company_domain="Deposits"
  System(CAP_FIN_06, "Cash & Settlement Reconciliation", "Reconcile cash and settlement positions daily.", $tags="capabilities")
  ' aac CAP_FIN_06: company_domain="Cross-Functional Services"
  System(CAP_DEP_01, "Deposit Product Management", "Define and price CD and savings products: terms, rates, disclosures, and the rate sheet cadence.", $tags="capabilities")
  ' aac CAP_DEP_01: company_domain="Deposits"
  System(CAP_FIN_03, "Funding & Liquidity Management", "Manage funding positions and liquidity.", $tags="capabilities")
  ' aac CAP_FIN_03: company_domain="Cross-Functional Services"
  System(CAP_LEND_03, "Loan Boarding & Dealer Funding", "Board approved loans, verify stipulations and documentation, and fund the dealer.", $tags="capabilities")
  ' aac CAP_LEND_03: company_domain="Lending"
  System(CAP_MERCH_04_01, "Merchant Funding", "Net fees, chargebacks and holds from the day's volume, and fund each merchant.", $tags="capabilities")
  ' aac CAP_MERCH_04_01: company_domain="Merchant Services"
  System(CAP_MERCH_04, "Merchant Settlement & Funding", "Clear and settle merchant card volume and fund merchant accounts daily, with reserves where risk requires them.", $tags="capabilities")
  ' aac CAP_MERCH_04: company_domain="Merchant Services"
  System(CAP_PAY_05, "Network Settlement & Interchange", "Settle positions with networks and account for interchange.", $tags="capabilities")
  ' aac CAP_PAY_05: company_domain="Servicing"
}
Boundary(b_Process, "Process") {
  System(P_LENDING_006, "Board loan and fund dealer", "Create the loan on the servicing platform with its terms, payment schedule and collateral, pay the dealer the amount financed with its reserve, and post the entries. Boarding errors surface months later as wrong payment amounts or payoff quotes, and a funding paid twice or to the wrong dealer is cash out of the door.", $tags="processes")
  ' aac P_LENDING_006: company_domain=""
  System(P_SETTLEMENT_001, "Fund daily network settlement position", "Determine and fund the daily settlement position with the networks. The settlement position must fund by the network deadline in the settlement currency; a miss is a network compliance event, so the process carries same-day escalation.", $tags="processes")
  ' aac P_SETTLEMENT_001: company_domain=""
  System(P_DEPOSITS_003, "Issue brokered CDs through the broker network", "Agree the size, term and rate of a brokered CD issue with Treasury, offer it through the broker-dealer network, and confirm the allocations each broker sold. Brokered CDs are a primary funding channel, and their volume is watched against the brokered deposit limits that apply if capital weakens.", $tags="processes")
  ' aac P_DEPOSITS_003: company_domain=""
  System(P_FUNDING_001, "Manage daily funding position", "Determine, fund, and report the daily liquidity and funding position. The daily position covers settlement obligations, deposit flows, and contingency lines; a funding miss is a same-day escalation, not a report.", $tags="processes")
  ' aac P_FUNDING_001: company_domain=""
  System(P_SETTLEMENT_002, "Reconcile cash and suspense accounts", "Reconcile cash and suspense account positions and clear aged items. Cash and suspense reconcile daily with aging visible; suspense is a control account, and items that age past threshold escalate to investigation.", $tags="processes")
  ' aac P_SETTLEMENT_002: company_domain=""
  System(P_DEPOSITS_001, "Set deposit rates and product terms", "Set the rate sheet for CDs and savings against funding needs and the market, approve term and early withdrawal penalty changes, and publish the disclosures that must match. Rates are the funding cost of every loan the bank makes, and a published rate that differs from the booked one is a disclosure error.", $tags="processes")
  ' aac P_DEPOSITS_001: company_domain=""
  System(P_MERCHANT_006, "Settle and fund merchants", "Clear the day's card volume, net out fees, chargebacks and reserve holds, and fund each merchant's bank account by ACH, reconciling network settlement to merchant funding. Funding a merchant that should have been held is exactly the loss the reserve was meant to cover.", $tags="processes")
  ' aac P_MERCHANT_006: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_TREASURY, "Treasury management", "Treasury, funding, and liquidity management.", $tags="systems")
  ' aac SYS_TREASURY: company_domain=""
}

