Rel(SYS_CUST360_PIPELINE, DA_TRANSACTION, "Read")
' aac rel: source="SYS_CUST360_PIPELINE"; target="DA_TRANSACTION"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_STATEMENTS, DA_TRANSACTION, "Read")
' aac rel: source="SYS_STATEMENTS"; target="DA_TRANSACTION"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(P_DISPUTE_001, DA_TRANSACTION, "Reads")
