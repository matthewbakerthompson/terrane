      ' aac TS_NET_SUB_LEND_APP_A: company_domain="Lending"; technology="Subnet"
    }
    Deployment_Node(TS_NET_SUB_LEND_DATA_A, "Lending Data Subnet A", "Subnet", $tags="tech_services") {
      ' aac TS_NET_SUB_LEND_DATA_A: company_domain="Lending"; technology="Subnet"
    }
    Deployment_Node(TS_NET_NAT_LEND_A, "Lending NAT Gateway A", "Private egress", "Outbound-only egress for the private tiers. One per zone, so a zone loss is not an outage.", $tags="tech_services") {
      ' aac TS_NET_NAT_LEND_A: company_domain="Lending"; technology="Private egress"
    }
    Deployment_Node(TS_NET_SUB_LEND_PUB_A, "Lending Public Subnet A", "Subnet", $tags="tech_services") {
      ' aac TS_NET_SUB_LEND_PUB_A: company_domain="Lending"; technology="Subnet"
