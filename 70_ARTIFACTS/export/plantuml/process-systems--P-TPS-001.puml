Rel(P_TPS_001, DA_CLIENT_SERV, "Both")
' aac rel: source="P_TPS_001"; target="DA_CLIENT_SERV"; label="Both"; relation="process_uses_data_asset"; access="Both"
Rel(P_TPS_001, CTL_CLIENT_SLA, "governed by")
' aac rel: source="P_TPS_001"; target="CTL_CLIENT_SLA"; label="governed by"; relation="process_governed_by_control"
Rel(P_TPS_001, CAP_TPS_01, "supports")
' aac rel: source="P_TPS_001"; target="CAP_TPS_01"; label="supports"; relation="process_supports_capability"

