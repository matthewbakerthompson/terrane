@startuml
' Credit data and decisioning environment — Processes and Capabilities
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Credit data and decisioning environment — Processes and Capabilities

AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_CRED_07, "Account Review & Reissue Decisioning", "Perform periodic account-level risk review and reissue decisions.", $tags="capabilities")
  ' aac CAP_CRED_07: company_domain="Originations"
  System(CAP_ACQ_05, "Acquisition Performance Analytics", "Measure response, approval, and vintage economics of acquisition activity.", $tags="capabilities")
  ' aac CAP_ACQ_05: company_domain="MarTech"
  System(CAP_CRED_03, "Credit Line Assignment & Management", "Set initial lines and manage increases, decreases, and reallocation.", $tags="capabilities")
  ' aac CAP_CRED_03: company_domain="Originations"
  System(CAP_CRED_01, "Credit Strategy & Scorecard Management", "Own the credit decision strategy and its cutoffs.", $tags="capabilities")
  ' aac CAP_CRED_01: company_domain="Originations"
  System(CAP_RGOV_09, "Fair Lending Monitoring", "Test credit decisions, pricing and dealer markup for disparities, and remediate what the testing finds.", $tags="capabilities")
  ' aac CAP_RGOV_09: company_domain="Cross-Functional Services"
  System(CAP_FRAUD_08, "First-Party Fraud & Bust-Out Management", "Detect and act on credit abuse by account holders themselves: bust-out, synthetic identities and payment fraud.", $tags="capabilities")
  ' aac CAP_FRAUD_08: company_domain="Servicing"
  System(CAP_LEND_02, "Indirect Application & Underwriting", "Receive applications through dealers, decision them against credit policy, and return terms while the buyer is at the point of sale.", $tags="capabilities")
  ' aac CAP_LEND_02: company_domain="Lending"
  System(CAP_LEND_02_02, "Indirect Credit Decision & Counteroffer", "Decide the application against credit policy and the collateral's value, and return terms or a counteroffer to the dealer.", $tags="capabilities")
  ' aac CAP_LEND_02_02: company_domain="Lending"
  System(CAP_ACQ_04, "Marketing Compliance & Disclosure Review", "Review creative and offers for regulatory adequacy before release.", $tags="capabilities")
  ' aac CAP_ACQ_04: company_domain="MarTech"
  System(CAP_MERCH_02_01, "Merchant Credit Underwriting", "Assess a merchant's credit and chargeback exposure, and set its limits and reserve terms.", $tags="capabilities")
  ' aac CAP_MERCH_02_01: company_domain="Merchant Services"
  System(CAP_MERCH_02, "Merchant Underwriting & Risk Vetting", "Underwrite merchants against credit and brand risk appetite — the specialty-vertical appetite is the differentiator.", $tags="capabilities")
  ' aac CAP_MERCH_02: company_domain="Merchant Services"
  System(CAP_ACQ_02, "Offer & Pre-Screen Management", "Construct and govern firm offers of credit and pre-screen criteria.", $tags="capabilities")
  ' aac CAP_ACQ_02: company_domain="MarTech"
  System(CAP_ACQ_02_01, "Offer Construction", "Assemble the offer: terms, pricing, and eligibility criteria.", $tags="capabilities")
  ' aac CAP_ACQ_02_01: company_domain="MarTech"
  System(CAP_CRED_04, "Portfolio Risk Monitoring & Segmentation", "Monitor vintage, roll rate, and segment performance across the portfolio.", $tags="capabilities")
  ' aac CAP_CRED_04: company_domain="Originations"
  System(CAP_SERV_09, "Retention, Product Change & Account Closure", "Keep customers who ask to leave, move accounts between products, and close accounts with balances, rewards and notices settled.", $tags="capabilities")
  ' aac CAP_SERV_09: company_domain="Servicing"
  System(CAP_ORIG_04, "Underwriting & Credit Decisioning Execution", "Execute the credit decision against the approved strategy.", $tags="capabilities")
  ' aac CAP_ORIG_04: company_domain="Originations"
}
Boundary(b_Process, "Process") {
  System(P_CREDIT_009, "Acquire and refresh credit bureau data", "Source consumer bureau data for prescreen, account review, and portfolio monitoring under permissible purpose, and manage refresh cadence and quality.", $tags="processes")
  ' aac P_CREDIT_009: company_domain=""
  System(P_CREDIT_005, "Conduct monthly portfolio credit review", "Review vintage, roll-rate, and segment performance against risk appetite and record the actions agreed at the portfolio credit review.", $tags="processes")
  ' aac P_CREDIT_005: company_domain=""
  System(P_MARKETING_002, "Construct and approve firm offer of credit", "Define offer criteria and terms, and obtain compliance approval before release. A firm offer of credit commits the bank under FCRA; criteria, terms, and the compliance sign-off are locked before any channel sees the offer.", $tags="processes")
  ' aac P_MARKETING_002: company_domain=""
  System(P_LENDING_004, "Decide indirect loan and return terms", "Score the application against the recreation lending credit policy, price it, and return an approval, a counteroffer with conditions, or a decline to the dealer while the buyer waits. Counteroffers and declines carry adverse action obligations, and the collateral's value sets the advance, so the decision reads the asset's value guide as well as the bureau.", $tags="processes")
  ' aac P_LENDING_004: company_domain=""
  System(P_FRAUD_007, "Detect and act on first-party fraud and bust-out", "Spot accounts run up to the limit by their owners with no intent to repay, from rapid balance build, payments that return and links between applications, then restrict the account and route it to fraud rather than collections. Booked as credit loss, first-party fraud is worked by the wrong team and reported in the wrong line.", $tags="processes")
  ' aac P_FRAUD_007: company_domain=""
  System(P_ORIG_004, "Execute credit decision", "Apply the approved credit strategy to render an approve, decline, or counter-offer decision with a line assignment.", $tags="processes")
  ' aac P_ORIG_004: company_domain=""
  System(P_CREDIT_008, "Perform account review and reissue decision", "Review account risk periodically and decide reissue, close, or continue. Periodic account review drives reissue, line, and closure decisions at card expiry and on risk triggers; decisions carry the same notice obligations as any adverse action.", $tags="processes")
  ' aac P_CREDIT_008: company_domain=""
  System(P_SERVICING_014, "Retain account at closure request", "When a cardholder asks to close, find the reason, offer what the retention strategy allows, such as a fee waiver, a rate review or a product change, and record the outcome. Offers follow the approved matrix, or two cardholders in the same position get different treatment.", $tags="processes")
  ' aac P_SERVICING_014: company_domain=""
  System(P_MARKETING_005, "Review campaign performance and adjust targeting", "Evaluate response, approval, and early vintage economics for in-flight campaigns and decide continue, adjust, or stop.", $tags="processes")
  ' aac P_MARKETING_005: company_domain=""
  System(P_CREDIT_001, "Set and deploy credit decision strategy", "Define, test, approve, and deploy changes to the credit decision strategy and its cutoffs. Strategy changes ship through champion-challenger testing with documented approval; the deployed strategy is the single decisioning authority for originations.", $tags="processes")
  ' aac P_CREDIT_001: company_domain=""
  System(P_COMPLIANCE_006, "Test credit decisions and pricing for fair lending", "Test approvals, lines, pricing, dealer markup and collections treatment for disparities across protected classes, using proxy methods where the data is not collected, and investigate and remediate what the testing finds. Fair lending findings lead to restitution and consent orders, and discretionary dealer markup is the classic exposure.", $tags="processes")
  ' aac P_COMPLIANCE_006: company_domain=""
  System(P_MERCHANT_003, "Underwrite merchant", "Assess the merchant's credit, processing history, delivery timeframes and chargeback exposure against the appetite for its business type, and approve with limits and reserve terms, or decline. Specialty and higher-risk business types are the point of the program, so underwriting sets the exposure every later step monitors.", $tags="processes")
  ' aac P_MERCHANT_003: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CREDIT_DATA, "Credit data and decisioning environment", "Credit data, analytics, and decisioning environment. Built with Snowflake Data Cloud.", $tags="systems")
  ' aac SYS_CREDIT_DATA: company_domain=""; technology="Snowflake Data Cloud"
}

