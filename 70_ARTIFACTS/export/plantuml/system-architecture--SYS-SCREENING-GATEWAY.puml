@startuml
' NICE Actimize Screening Integration Gateway — Architecture
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title NICE Actimize Screening Integration Gateway — Architecture

AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")
AddElementTag("tech_services", $bgColor="#fed7aa", $borderColor="#c2410c", $fontColor="#0f172a", $legendText="technology service")
AddRelTag("api-call", $legendText="API call")

Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_AUTH_LOG, "Authorization log", "Every authorization request and response, with the decision, the reason and whether stand-in answered.", $tags="data_assets")
  ' aac DA_AUTH_LOG: company_domain=""
  SystemDb(DA_CARD_ACCOUNT, "Card account master", "Account, balance, limit and status records for every card account.", $tags="data_assets")
  ' aac DA_CARD_ACCOUNT: company_domain="Card Issuing"
  SystemDb(DA_TRANSACTION, "Card transaction history", "Authorized, cleared and settled card transactions.", $tags="data_assets")
  ' aac DA_TRANSACTION: company_domain="Payments"
  SystemDb(DA_DEPOSIT_ACCOUNT, "Deposit account and CD record", "Depositor identity and ownership category, account terms, rate, interest accrued, maturity and instructions.", $tags="data_assets")
  ' aac DA_DEPOSIT_ACCOUNT: company_domain=""
  SystemDb(DA_MERCHANT, "Merchant master and underwriting file", "Merchant identity, beneficial owners, underwriting decision, limits, pricing and screening results.", $tags="data_assets")
  ' aac DA_MERCHANT: company_domain=""
  SystemDb(DA_MERCH_SETTLE, "Merchant settlement and reserve ledger", "Daily merchant volume, fees, chargebacks, funding and reserve balances.", $tags="data_assets")
  ' aac DA_MERCH_SETTLE: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_AUTH_SWITCH, "Authorization Switch", "Real-time card authorization switch connected to the scheme networks.", $tags="systems")
  ' aac SYS_AUTH_SWITCH: company_domain="Payments"; hosting="On-prem"
  System(SYS_DEPOSIT, "Deposit platform", "System of record for CDs and savings: opening, interest accrual, maturities, early withdrawal and tax reporting.", $tags="systems")
  ' aac SYS_DEPOSIT: company_domain=""
  System(SYS_MERCH_RISK, "Merchant risk monitoring", "Monitors merchant volume, chargeback ratios and exposure, and checks merchants against the networks' terminated-merchant file.", $tags="systems")
  ' aac SYS_MERCH_RISK: company_domain=""
  System(SYS_SCREENING_GATEWAY, "NICE Actimize Screening Integration Gateway", "Our side of the NICE Actimize integration: request mapping, retry and back-off, circuit breaking when the vendor is down, and the audit trail of what we sent them. Built with EKS.", $tags="systems")
  ' aac SYS_SCREENING_GATEWAY: company_domain="Risk and Compliance"; hosting="AWS"; technology="EKS"
  System(SYS_SCREENING_EGRESS, "NICE Actimize Screening Private Egress", "PrivateLink endpoint and egress allow-list for NICE Actimize. The control that keeps regulated data off the public internet, and the thing a security review asks to see first.", $tags="systems")
  ' aac SYS_SCREENING_EGRESS: company_domain="Enterprise Platform"; hosting="AWS"
}
Boundary(b_Technology_Service, "Technology Service") {
  Deployment_Node(TS_AWS_APIGW, "Amazon API Gateway", "API gateway", "The managed front door every AWS-hosted API is published through.", $tags="tech_services") {
    ' aac TS_AWS_APIGW: company_domain="Enterprise Platform"; technology="API gateway"
  }
  Deployment_Node(TS_AWS_CLOUDWATCH, "Amazon CloudWatch", "Observability", "Metrics, logs and alarms for every workload in the landing zone.", $tags="tech_services") {
    ' aac TS_AWS_CLOUDWATCH: company_domain="Enterprise Platform"; technology="Observability"
  }
  Deployment_Node(TS_AWS_EKS, "Amazon EKS", "Container platform", "Managed Kubernetes running the containerized workloads.", $tags="tech_services") {
    ' aac TS_AWS_EKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Deployment_Node(TS_AWS_PRIVATELINK, "AWS PrivateLink", "Private egress", "Private egress to partner and vendor endpoints without internet transit.", $tags="tech_services") {
    ' aac TS_AWS_PRIVATELINK: company_domain="Enterprise Platform"; technology="Private egress"
  }
  Deployment_Node(TS_AWS_SECRETS, "AWS Secrets Manager", "Secrets manager", "Application credentials and rotation.", $tags="tech_services") {
    ' aac TS_AWS_SECRETS: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_AWS_TGW, "AWS Transit Gateway", "Transit hub", "Hub for VPC-to-VPC and hybrid routing back to the data center.", $tags="tech_services") {
    ' aac TS_AWS_TGW: company_domain="Enterprise Platform"; technology="Transit hub"
  }
  Deployment_Node(TS_ONPREM_DC, "Primary Data Center", "Virtual network", "The data center the mainframe and the authorization switch live in. Modeled because half the integration cost of any cloud onboarding is the path back to here.", $tags="tech_services") {
    ' aac TS_ONPREM_DC: company_domain="Enterprise Platform"; technology="Virtual network"
  }
  Deployment_Node(TS_NET_VPC_RISKOPS, "Risk Operations VPC", "Virtual network", "Workload VPC for screening and risk tooling.", $tags="tech_services") {
    ' aac TS_NET_VPC_RISKOPS: company_domain="Risk and Compliance"; technology="Virtual network"
  }
  Deployment_Node(TS_NET_VPC_SHARED, "Shared Services VPC", "Virtual network", "Hub VPC holding the transit attachments, egress and resolver endpoints.", $tags="tech_services") {
    ' aac TS_NET_VPC_SHARED: company_domain="Enterprise Platform"; technology="Virtual network"
  }
}

Rel(SYS_MERCH_RISK, SYS_SCREENING_GATEWAY, "Merchant Risk Monitoring to Screening Gateway", "HTTPS", $tags="api-call")
' aac rel: source="SYS_MERCH_RISK"; target="SYS_SCREENING_GATEWAY"; label="Merchant Risk Monitoring to Screening Gateway"; interface_id="INT-MERCH-RISK-SCREENING"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"; patterns="inline-risk-decision"
Rel(SYS_DEPOSIT, SYS_SCREENING_GATEWAY, "Deposit Platform to Screening Gateway", "HTTPS", $tags="api-call")
' aac rel: source="SYS_DEPOSIT"; target="SYS_SCREENING_GATEWAY"; label="Deposit Platform to Screening Gateway"; interface_id="INT-DEPOSIT-SCREENING"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"; patterns="inline-risk-decision"
Rel(SYS_AUTH_SWITCH, SYS_SCREENING_GATEWAY, "SYS-AUTH-SWITCH to NICE Actimize Screening Gateway", "HTTPS", $tags="api-call")
' aac rel: source="SYS_AUTH_SWITCH"; target="SYS_SCREENING_GATEWAY"; label="SYS-AUTH-SWITCH to NICE Actimize Screening Gateway"; interface_id="INT-SCREENING-CALLER-GATEWAY"; kind="api-call"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"
Rel(SYS_SCREENING_GATEWAY, SYS_SCREENING_EGRESS, "NICE Actimize Screening Gateway to Private Egress", "HTTPS", $tags="api-call")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="SYS_SCREENING_EGRESS"; label="NICE Actimize Screening Gateway to Private Egress"; interface_id="INT-SCREENING-GATEWAY-EGRESS"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_SCREENING_GATEWAY, TS_AWS_EKS, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_AWS_EKS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_GATEWAY, TS_AWS_APIGW, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_AWS_APIGW"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_EGRESS, TS_AWS_PRIVATELINK, "runs on")
' aac rel: source="SYS_SCREENING_EGRESS"; target="TS_AWS_PRIVATELINK"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_EGRESS, TS_AWS_TGW, "runs on")
' aac rel: source="SYS_SCREENING_EGRESS"; target="TS_AWS_TGW"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_GATEWAY, TS_AWS_SECRETS, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_AWS_SECRETS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_GATEWAY, TS_AWS_CLOUDWATCH, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_AWS_CLOUDWATCH"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_GATEWAY, TS_NET_VPC_RISKOPS, "runs on")
' aac rel: source="SYS_SCREENING_GATEWAY"; target="TS_NET_VPC_RISKOPS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_SCREENING_EGRESS, TS_NET_VPC_SHARED, "runs on")
' aac rel: source="SYS_SCREENING_EGRESS"; target="TS_NET_VPC_SHARED"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_AUTH_SWITCH, TS_ONPREM_DC, "runs on")
' aac rel: source="SYS_AUTH_SWITCH"; target="TS_ONPREM_DC"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_MERCH_RISK, DA_MERCHANT, "ReadWrite")
' aac rel: source="SYS_MERCH_RISK"; target="DA_MERCHANT"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(SYS_MERCH_RISK, DA_MERCH_SETTLE, "Read")
' aac rel: source="SYS_MERCH_RISK"; target="DA_MERCH_SETTLE"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_DEPOSIT, DA_DEPOSIT_ACCOUNT, "ReadWrite")
' aac rel: source="SYS_DEPOSIT"; target="DA_DEPOSIT_ACCOUNT"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(SYS_AUTH_SWITCH, DA_AUTH_LOG, "ReadWrite")
' aac rel: source="SYS_AUTH_SWITCH"; target="DA_AUTH_LOG"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(SYS_AUTH_SWITCH, DA_CARD_ACCOUNT, "Read")
' aac rel: source="SYS_AUTH_SWITCH"; target="DA_CARD_ACCOUNT"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_AUTH_SWITCH, DA_TRANSACTION, "ReadWrite")
' aac rel: source="SYS_AUTH_SWITCH"; target="DA_TRANSACTION"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"

SHOW_LEGEND()
@enduml
