' aac DA_SCREENING_OUTCOMES: company_domain="Risk and Compliance"
Person(ACT_SCREENING_ANALYST, "Screening Analyst", "Works the alert queue: clears the false positives and escalates the rest. The queue exists because the screening does, and its volume is the number the vendor's tuning is judged on.", $tags="actors")
' aac ACT_SCREENING_ANALYST: company_domain="Risk and Compliance"; actor_kind="Role"; internal="Yes"

