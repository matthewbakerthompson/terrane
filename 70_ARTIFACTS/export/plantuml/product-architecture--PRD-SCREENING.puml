        ' aac TS_AWS_CLOUDWATCH: company_domain="Enterprise Platform"; technology="Observability"
      }
    }
  }
  Boundary(b_AWS__shared_network, "account shared-network") {
    Boundary(b_AWS__shared_network__Edge, "Edge") {
      Deployment_Node(TS_AWS_APIGW, "Amazon API Gateway", "API gateway", "The managed front door every AWS-hosted API is published through.", $tags="tech_services") {
        ' aac TS_AWS_APIGW: company_domain="Enterprise Platform"; technology="API gateway"
      }
    }
    Boundary(b_AWS__shared_network__Shared_Services, "Shared-Services") {
      Deployment_Node(TS_AWS_PRIVATELINK, "AWS PrivateLink", "Private egress", "Private egress to partner and vendor endpoints without internet transit.", $tags="tech_services") {
        ' aac TS_AWS_PRIVATELINK: company_domain="Enterprise Platform"; technology="Private egress"
      }
