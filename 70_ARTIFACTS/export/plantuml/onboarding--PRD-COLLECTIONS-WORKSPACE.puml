      }
    }
  }
  Boundary(b_Azure__azure_platform_prod, "subscription azure-platform-prod") {
    Boundary(b_Azure__azure_platform_prod__uksouth, "region uksouth") {
      Boundary(b_Azure__azure_platform_prod__uksouth__Shared_Services, "Shared-Services") {
