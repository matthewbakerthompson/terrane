@startuml
' Processes That Touch Restricted Data
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Processes That Touch Restricted Data

AddElementTag("data_assets", $bgColor="#a7f3d0", $borderColor="#047857", $fontColor="#0f172a", $legendText="data asset")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")

Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_AUTH_LOG, "Authorization log", "Every authorization request and response, with the decision, the reason and whether stand-in answered.", $tags="data_assets")
  ' aac DA_AUTH_LOG: company_domain=""
  SystemDb(DA_CARD_ACCOUNT, "Card account master", "Account, balance, limit and status records for every card account.", $tags="data_assets")
  ' aac DA_CARD_ACCOUNT: company_domain="Card Issuing"
  SystemDb(DA_CARDSVC_OPERATIONAL, "Card Servicing operational data", "Operational records held by Card Servicing.", $tags="data_assets")
  ' aac DA_CARDSVC_OPERATIONAL: company_domain="Servicing"
  SystemDb(DA_TRANSACTION, "Card transaction history", "Authorized, cleared and settled card transactions.", $tags="data_assets")
  ' aac DA_TRANSACTION: company_domain="Payments"
  SystemDb(DA_COLLECT_OPERATIONAL, "Collections Workspace operational data", "Operational records held by Collections Workspace.", $tags="data_assets")
  ' aac DA_COLLECT_OPERATIONAL: company_domain="Collections"
  SystemDb(DA_APPLICATION, "Credit application record", "Application content, identity evidence, and decision inputs, including bureau pulls.", $tags="data_assets")
  ' aac DA_APPLICATION: company_domain=""
  SystemDb(DA_BUREAU_FILE, "Credit bureau furnishing file", "Monthly tradeline furnishing extract and consumer-dispute responses.", $tags="data_assets")
  ' aac DA_BUREAU_FILE: company_domain=""
  SystemDb(DA_CUST360_CURATED, "Customer 360 curated dataset", "Curated, governed dataset produced by Customer 360.", $tags="data_assets")
  ' aac DA_CUST360_CURATED: company_domain="Data and Analytics"
  SystemDb(DA_CUSTOMER_PROFILE, "Customer profile", "Contact details, preferences and servicing history.", $tags="data_assets")
  ' aac DA_CUSTOMER_PROFILE: company_domain="Servicing"
  SystemDb(DA_DEPOSIT_ACCOUNT, "Deposit account and CD record", "Depositor identity and ownership category, account terms, rate, interest accrued, maturity and instructions.", $tags="data_assets")
  ' aac DA_DEPOSIT_ACCOUNT: company_domain=""
  SystemDb(DA_DISPUTES_VENDOR_FEED, "Dispute Management Platform vendor feed", "Landed vendor extract from Pegasystems.", $tags="data_assets")
  ' aac DA_DISPUTES_VENDOR_FEED: company_domain="Servicing"
  SystemDb(DA_LENDING_OPERATIONAL, "Installment Lending operational data", "Operational records held by Installment Lending.", $tags="data_assets")
  ' aac DA_LENDING_OPERATIONAL: company_domain="Lending"
  SystemDb(DA_LOAN_ACCOUNT, "Installment loan account", "Loan terms, payment schedule, balances, payment history and status for each installment loan.", $tags="data_assets")
  ' aac DA_LOAN_ACCOUNT: company_domain=""
  SystemDb(DA_SCREENING_OUTCOMES, "NICE Actimize Screening outcomes", "What the vendor decided and why, landed our side. Held because a decision we cannot explain is a decision we cannot defend.", $tags="data_assets")
  ' aac DA_SCREENING_OUTCOMES: company_domain="Risk and Compliance"
  SystemDb(DA_PAYMENT_INSTR, "Payment instructions", "Cardholder payment methods and instructions: ACH details, scheduled payments.", $tags="data_assets")
  ' aac DA_PAYMENT_INSTR: company_domain=""
}
Boundary(b_Process, "Process") {
  System(P_DEPOSITS_005, "Accrue and pay deposit interest", "Accrue interest daily on every CD and savings account at its contract rate, credit or pay it on schedule, and post the expense to the ledger. An accrual error repeats across every account on the same rate, so the daily accrual is reconciled to the ledger before close.", $tags="processes")
  ' aac P_DEPOSITS_005: company_domain=""
  System(P_DEPOSITS_008, "Administer deposit insurance records and escheatment", "Keep the ownership categories and records the deposit insurer needs to determine coverage, answer depositors' coverage questions, and report and remit dormant balances to the states. In a failure, coverage is determined from these records, so a record that cannot be read is a depositor who cannot be paid on time.", $tags="processes")
  ' aac P_DEPOSITS_008: company_domain=""
  System(P_PAYMENTS_010, "Allocate payment across balances", "Apply each payment above the minimum to the balance with the highest rate first, as the card rules require, and treat promotional, deferred-interest and disputed balances correctly. Allocation errors overcharge interest on every account with more than one balance, which makes them a remediation, not a correction.", $tags="processes")
  ' aac P_PAYMENTS_010: company_domain=""
  System(P_SERVICING_001, "Assess interest, fees, and minimum payment", "Calculate interest, fees, and the minimum payment due for the billing cycle. Cycle assessment applies the cardholder agreement exactly: interest method, fee triggers, and minimum-payment formula, because a systematic error here is a remediation event.", $tags="processes")
  ' aac P_SERVICING_001: company_domain=""
  System(P_LENDING_012, "Assign repossession and send required notices", "Assign a licensed repossession agent, confirm the recovery and the personal property found inside, and send the notices of redemption rights and intended sale each state requires. A repossession done or noticed outside state law voids the deficiency and invites a claim, so the notice timeline is controlled state by state.", $tags="processes")
  ' aac P_LENDING_012: company_domain=""
  System(P_LENDING_009, "Bill installment loan and post payments", "Send the monthly bill, take payments by ACH, debit card, check and automatic payment, and post them to interest, principal and fees in the order the contract says. Posting drives the delinquency that collections and bureau reporting read, so a misposted payment shows up as a wrong late fee, a wrong call and a wrong bureau line.", $tags="processes")
  ' aac P_LENDING_009: company_domain=""
  System(P_LENDING_006, "Board loan and fund dealer", "Create the loan on the servicing platform with its terms, payment schedule and collateral, pay the dealer the amount financed with its reserve, and post the entries. Boarding errors surface months later as wrong payment amounts or payoff quotes, and a funding paid twice or to the wrong dealer is cash out of the door.", $tags="processes")
  ' aac P_LENDING_006: company_domain=""
  System(P_LENDING_015, "Calculate and settle dealer reserve", "Calculate the dealer's participation on each funded loan, pay it, and charge back the unearned part when a loan pays off or defaults inside the chargeback window. Reserve is the dealer's pay for the rate it sets, so its calculation is also what the markup review reads.", $tags="processes")
  ' aac P_LENDING_015: company_domain=""
  System(P_LENDING_014, "Cancel ancillary products and refund unearned premium", "When a loan pays off early, is charged off, or its collateral is repossessed or destroyed, cancel the gap coverage, service contract and credit insurance sold with it and refund the unearned part. Missed refunds are a recurring supervisory finding in indirect lending, and they are owed whether or not the borrower asks.", $tags="processes")
  ' aac P_LENDING_014: company_domain=""
  System(P_CARD_PMT_001, "Capture and apply cardholder payment", "Accept a cardholder payment through any channel and apply it to the account on the correct effective date.", $tags="processes")
  ' aac P_CARD_PMT_001: company_domain=""
  System(P_ORIG_001, "Capture card application", "Accept and validate a complete card application from any origination channel. Capture is complete when the application has every field decisioning needs and the applicant has the required disclosures; incomplete applications route to cure, not decline.", $tags="processes")
  ' aac P_ORIG_001: company_domain=""
  System(P_SERVICING_015, "Close account and settle final balance", "Close the account at the cardholder's or the bank's request, stop new charges while recurring payments and pending items clear, forfeit or pay out rewards per the terms, report the closure to the bureaus correctly, and confirm it in writing. A closed account still has a balance to bill and a bureau line to keep accurate.", $tags="processes")
  ' aac P_SERVICING_015: company_domain=""
  System(P_LENDING_011, "Collect delinquent installment loan", "Work past-due installment loans through calls, letters and digital contact, take promises and arrangements, and decide when a loan goes to repossession. Recreation loans are secured and seasonal, so treatment weighs the collateral and the season as well as the days past due; the contact limits that apply to cards apply here too.", $tags="processes")
  ' aac P_LENDING_011: company_domain=""
  System(P_TPS_002, "Convert client portfolio", "Migrate a client portfolio onto the servicing platform with reconciled balances and no cardholder disruption.", $tags="processes")
  ' aac P_TPS_002: company_domain=""
  System(P_STMT_GEN_001, "Cut cycle and generate statement", "Cut the billing cycle and generate the cardholder statement including the rewards position. Cycle cut is the hard deadline that sequences assessment, statement generation, and delivery; a late cut cascades into payment due dates and regulatory timing.", $tags="processes")
  ' aac P_STMT_GEN_001: company_domain=""
  System(P_LENDING_004, "Decide indirect loan and return terms", "Score the application against the recreation lending credit policy, price it, and return an approval, a counteroffer with conditions, or a decline to the dealer while the buyer waits. Counteroffers and declines carry adverse action obligations, and the collateral's value sets the advance, so the decision reads the asset's value guide as well as the bureau.", $tags="processes")
  ' aac P_LENDING_004: company_domain=""
  System(P_FRAUD_007, "Detect and act on first-party fraud and bust-out", "Spot accounts run up to the limit by their owners with no intent to repay, from rapid balance build, payments that return and links between applications, then restrict the account and route it to fraud rather than collections. Booked as credit loss, first-party fraud is worked by the wrong team and reported in the wrong line.", $tags="processes")
  ' aac P_FRAUD_007: company_domain=""
  System(P_FRAUD_001, "Detect and action transaction fraud alert", "Detect a suspected fraudulent transaction, action the alert, and contact the cardholder. Alert handling runs against loss and customer-friction budgets; actions span block, reissue, and contact, and the clock matters because exposure grows per transaction.", $tags="processes")
  ' aac P_FRAUD_001: company_domain=""
  System(P_PAYMENTS_008, "Enroll and run automatic payments", "Enroll a cardholder's bank account for recurring payments of the minimum, the statement balance or a fixed amount, verify the account, and originate the debits on schedule under the authorization the cardholder gave. Each debit needs a valid authorization, and a debit taken after it was revoked is an error claim.", $tags="processes")
  ' aac P_PAYMENTS_008: company_domain=""
  System(P_ORIG_006, "Establish account and issue credentials", "Open the account on the core platform and issue the card credential. Account establishment writes the account of record and triggers credential issuance; a failure here strands an approved applicant, which is why it carries a same-day SLA.", $tags="processes")
  ' aac P_ORIG_006: company_domain=""
  System(P_ORIG_004, "Execute credit decision", "Apply the approved credit strategy to render an approve, decline, or counter-offer decision with a line assignment.", $tags="processes")
  ' aac P_ORIG_004: company_domain=""
  System(P_PRIVACY_001, "Fulfill consumer privacy request", "Receive, verify, and fulfill a consumer privacy rights request within the required period. Identity verification precedes any disclosure; state privacy laws set the clocks and the evidence of fulfillment is retained per request.", $tags="processes")
  ' aac P_PRIVACY_001: company_domain=""
  System(P_COLLECTIONS_005, "Furnish credit bureau data", "Compile and furnish account data to the consumer reporting agencies. Monthly Metro 2 furnishing to the bureaus; accuracy is an FCRA obligation, and the file must reconcile to the system of record before transmission.", $tags="processes")
  ' aac P_COLLECTIONS_005: company_domain=""
  System(P_PAYMENTS_002, "Ingest clearing file and post transactions", "Receive network clearing files and post transactions to cardholder accounts. Clearing ingestion matches presentments to authorizations, posts to accounts, and routes exceptions; the file must balance to network totals before posting completes.", $tags="processes")
  ' aac P_PAYMENTS_002: company_domain=""
  System(P_FRAUD_008, "Investigate synthetic identity", "Investigate identities built from real and invented data, often seasoned for months before they bust out, by linking shared phones, addresses and devices across applications and accounts; close the linked accounts and feed the pattern back to application screening. A synthetic identity has no victim to complain, so it is found only by looking.", $tags="processes")
  ' aac P_FRAUD_008: company_domain=""
  System(P_ORIG_005, "Issue adverse action notice", "Generate and deliver a compliant adverse action or counter-offer notice within the required period. ECOA and FCRA set the notice content and the clock; the principal reasons must match the actual decision factors, which is exactly what fair-lending testing checks.", $tags="processes")
  ' aac P_ORIG_005: company_domain=""
  System(P_DEPOSITS_003, "Issue brokered CDs through the broker network", "Agree the size, term and rate of a brokered CD issue with Treasury, offer it through the broker-dealer network, and confirm the allocations each broker sold. Brokered CDs are a primary funding channel, and their volume is watched against the brokered deposit limits that apply if capital weakens.", $tags="processes")
  ' aac P_DEPOSITS_003: company_domain=""
  System(P_PAYMENTS_007, "Maintain authorization routing and network connectivity", "Maintain the switch's routing tables, network keys and message specifications, apply the networks' release changes, and test connectivity with each network. A routing or key error declines every transaction on that path until it is fixed.", $tags="processes")
  ' aac P_PAYMENTS_007: company_domain=""
  System(P_LENDING_002, "Monitor dealer performance and program compliance", "Review each dealer's volume, early payment defaults, funding exceptions, complaints and rate markup against program limits, and put dealers on watch, retrain or end them. Dealer markup is where indirect lending meets fair lending exposure, so the review evidences the markup cap as well as credit quality.", $tags="processes")
  ' aac P_LENDING_002: company_domain=""
  System(P_COMPLIANCE_007, "Monitor transactions for suspicious activity", "Run monitoring scenarios over card, loan, deposit and merchant activity, triage the alerts, and escalate unusual activity to investigation, tuning the scenarios to the bank's risk assessment. Alerts aged past the review window put suspicious activity report deadlines at risk.", $tags="processes")
  ' aac P_COMPLIANCE_007: company_domain=""
  System(P_COLLECTIONS_008, "Negotiate settlement offer", "Offer a reduced lump-sum or short-term settlement within the approved matrix, put the terms in writing before payment, and on completion close the account and update the bureaus as settled. A settlement outside the matrix, or without written terms, is the account a regulator samples first.", $tags="processes")
  ' aac P_COLLECTIONS_008: company_domain=""
  System(P_DEPOSITS_002, "Open and fund direct deposit account", "Open a CD or savings account applied for online, verify the depositor's identity and screen for sanctions, deliver the account disclosures, and take the opening deposit by ACH or wire. Deposit accounts are an entry point for fraud and money laundering, so identity and the source of funds are checked before the account goes live.", $tags="processes")
  ' aac P_DEPOSITS_002: company_domain=""
  System(P_PAYMENTS_006, "Operate stand-in authorization during a host outage", "When the authorization host is slow or down, switch to stand-in so the switch or the network approves within set limits, then replay the stand-in decisions to the ledger when the host returns. Stand-in limits trade lost sales against unsecured exposure, and every stand-in approval must post or it is a balance nobody owes.", $tags="processes")
  ' aac P_PAYMENTS_006: company_domain=""
  System(P_LENDING_016, "Originate point-of-sale installment loan", "Take a financing application started in a retailer's checkout, check affordability from the shopper's bank data with consent, decide it, and book the installment loan with disbursement through the card ledger. The point-of-sale products run on platforms of their own, apart from the dealer channel, and share its credit policy and adverse action rules.", $tags="processes")
  ' aac P_LENDING_016: company_domain=""
  System(P_LENDING_007, "Perfect lien with titling state", "Record the bank as lienholder with the titling state, electronically where the state allows and on paper where it does not, and chase the title until it is in custody. An unperfected lien leaves the loan unsecured in a bankruptcy, so anything aging past the policy window is reported weekly by state and by dealer.", $tags="processes")
  ' aac P_LENDING_007: company_domain=""
  System(P_PAYMENTS_001, "Process authorization request", "Receive, decision, and respond to a real-time authorization request within the network response window.", $tags="processes")
  ' aac P_PAYMENTS_001: company_domain=""
  System(P_DISPUTE_001, "Process cardholder dispute claim", "Take a cardholder dispute claim, apply provisional credit, investigate, determine, and notify within regulatory timers.", $tags="processes")
  ' aac P_DISPUTE_001: company_domain=""
  System(P_DEPOSITS_007, "Process CD maturity, renewal, and early withdrawal", "Send maturity notices ahead of the date, take the depositor's instruction, renew at the current rate or pay out at maturity, and calculate the penalty on an early withdrawal. A CD that renews without the required notice, or pays out to an unverified account, is both a complaint and a fraud exposure.", $tags="processes")
  ' aac P_DEPOSITS_007: company_domain=""
  System(P_PAYMENTS_009, "Process lockbox and check payments", "Receive mailed checks through the lockbox, match each to an account by coupon or by research, post it the day it arrives, and work the exceptions. A payment received by the cutoff must be credited that day, so unmatched items are researched before they age.", $tags="processes")
  ' aac P_PAYMENTS_009: company_domain=""
  System(P_SERVICING_013, "Process product change or upgrade", "Move an account to another card product at the cardholder's request or by invitation, carrying over the balance, history and rewards as the program rules say, and issue the new card and terms. A product change that resets the account's age or loses rewards is a complaint and, if terms worsen without notice, a disclosure failure.", $tags="processes")
  ' aac P_SERVICING_013: company_domain=""
  System(P_DEPOSITS_006, "Produce deposit tax reporting", "Produce and deliver year-end interest statements to depositors and file the information returns, with corrections and backup withholding where a taxpayer id is missing or wrong. The filing deadlines are fixed, and missing or wrong forms carry penalties by the form.", $tags="processes")
  ' aac P_DEPOSITS_006: company_domain=""
  System(P_LENDING_008, "Quote payoff and release title", "Give the borrower or a refinancing lender a payoff quote, apply the payoff, and release the lien and send the title within the state's deadline. Late releases carry statutory penalties and complaints, and a release sent before the payoff funds clear is collateral given away.", $tags="processes")
  ' aac P_LENDING_008: company_domain=""
  System(P_LENDING_003, "Receive and validate dealer-submitted application", "Accept a credit application keyed by the dealer's finance office, check it is complete, verify the applicant's identity and screen it for application fraud before it reaches the decision. The buyer is at the dealership, so intake runs against a point-of-sale clock; an incomplete or unverified application that slips through becomes a funding exception later.", $tags="processes")
  ' aac P_LENDING_003: company_domain=""
  System(P_NETWORK_RECON_001, "Reconcile network settlement", "Reconcile network settlement files against internal transaction and ledger positions and resolve breaks.", $tags="processes")
  ' aac P_NETWORK_RECON_001: company_domain=""
  System(P_SERVICING_016, "Refund credit balance and report unclaimed property", "Refund a credit balance when the cardholder asks or once it reaches the regulatory age, by check or deposit, and report and remit balances that cannot be returned to the states as unclaimed property. Both clocks are regulatory, and a refund check that is never cashed starts the unclaimed property clock again.", $tags="processes")
  ' aac P_SERVICING_016: company_domain=""
  System(P_LENDING_013, "Remarket recovered collateral and pursue deficiency", "Recondition and sell the recovered vehicle or boat at auction or retail, apply the proceeds, cancel the ancillary products for refund, and collect, place or sell the deficiency balance. The sale must be commercially reasonable and properly noticed, or the deficiency cannot be collected at all.", $tags="processes")
  ' aac P_LENDING_013: company_domain=""
  System(P_SERVICING_014, "Retain account at closure request", "When a cardholder asks to close, find the reason, offer what the retention strategy allows, such as a fee waiver, a rate review or a product change, and record the outcome. Offers follow the approved matrix, or two cardholders in the same position get different treatment.", $tags="processes")
  ' aac P_SERVICING_014: company_domain=""
  System(P_LENDING_005, "Review contract package and clear stipulations", "Check the signed retail installment contract, the title application and the proofs of income, insurance and identity the approval was conditioned on, and send back what is missing or wrong. A contract funded with an open stipulation is a loan the bank may not be able to enforce or perfect, which is why funding waits on this review.", $tags="processes")
  ' aac P_LENDING_005: company_domain=""
  System(P_ORIG_003, "Screen application for fraud", "Score and adjudicate the application for synthetic, stolen, and first-party fraud risk. Fraud screening runs before credit decisioning so stolen and synthetic identities never consume a bureau pull; referred applications go to manual review with an SLA.", $tags="processes")
  ' aac P_ORIG_003: company_domain=""
  System(P_COMPLIANCE_008, "Screen transactions and parties against sanctions in line", "Screen card transactions in the authorization path, and customers and counterparties nightly, against sanctions, politically exposed person and adverse media lists, and hold or block the true matches. A missed sanctions match is a strict-liability violation, so list updates are applied the day they are published.", $tags="processes")
  ' aac P_COMPLIANCE_008: company_domain=""
  System(P_LENDING_010, "Service installment loan account requests", "Handle borrower requests on a loan: due-date changes, payment deferrals and extensions, insurance and address updates, and statements of account. A deferral changes the payment schedule and the interest earned, so it is approved to policy and recorded where collections and finance will see it.", $tags="processes")
  ' aac P_LENDING_010: company_domain=""
  System(P_LENDING_017, "Service point-of-sale installment loan", "Collect the scheduled installments on point-of-sale loans, handle early settlement and missed payments, and keep the shopper informed by message and statement. These loans repay over months rather than years and are serviced on the installment lending platform, not on the recreation loan system.", $tags="processes")
  ' aac P_LENDING_017: company_domain=""
  System(P_CREDIT_001, "Set and deploy credit decision strategy", "Define, test, approve, and deploy changes to the credit decision strategy and its cutoffs. Strategy changes ship through champion-challenger testing with documented approval; the deployed strategy is the single decisioning authority for originations.", $tags="processes")
  ' aac P_CREDIT_001: company_domain=""
  System(P_DEPOSITS_001, "Set deposit rates and product terms", "Set the rate sheet for CDs and savings against funding needs and the market, approve term and early withdrawal penalty changes, and publish the disclosures that must match. Rates are the funding cost of every loan the bank makes, and a published rate that differs from the booked one is a disclosure error.", $tags="processes")
  ' aac P_DEPOSITS_001: company_domain=""
  System(P_DEPOSITS_004, "Settle brokered CDs and keep the position", "Settle each brokered issue through the depository against the brokers' allocations, record the CD position, and pay interest and maturities through the same channel, reconciling to the brokers' records. The underlying depositors are the brokers' customers, so their insurance coverage depends on the pass-through records kept here.", $tags="processes")
  ' aac P_DEPOSITS_004: company_domain=""
  System(P_COMPLIANCE_006, "Test credit decisions and pricing for fair lending", "Test approvals, lines, pricing, dealer markup and collections treatment for disparities across protected classes, using proxy methods where the data is not collected, and investigate and remediate what the testing finds. Fair lending findings lead to restitution and consent orders, and discretionary dealer markup is the classic exposure.", $tags="processes")
  ' aac P_COMPLIANCE_006: company_domain=""
  System(P_ORIG_002, "Verify applicant identity and satisfy CIP", "Verify the applicant's identity and record evidence satisfying customer identification obligations. CIP evidence is retained per BSA requirements; verification failures route to document request rather than automatic decline, and synthetic identity signals feed fraud screening.", $tags="processes")
  ' aac P_ORIG_002: company_domain=""
}

