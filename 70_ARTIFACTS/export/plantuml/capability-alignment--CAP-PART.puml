AddElementTag("controls", $bgColor="#fca5a5", $borderColor="#b91c1c", $fontColor="#0f172a", $legendText="control")
AddElementTag("frameworks", $bgColor="#d9f99d", $borderColor="#4d7c0f", $fontColor="#0f172a", $legendText="framework")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_PART_04, "Client Service Level & Performance Management", "Manage delivery against contracted service levels and report performance.", $tags="capabilities")
  ' aac CAP_PART_04: company_domain="Cross-Functional Services"
  System(CAP_PART_05, "Co-Brand & Program Partner Management", "Manage co-brand and program partner economics and obligations.", $tags="capabilities")
  ' aac CAP_PART_05: company_domain="Cross-Functional Services"
  System(CAP_PART_01, "Issuing Bank & Sponsor Relationship", "Manage the issuing bank relationship and its obligations.", $tags="capabilities")
  ' aac CAP_PART_01: company_domain="Cross-Functional Services"
  System(CAP_PART_02, "Network & Scheme Relationship", "Manage network membership, rules, and mandate adoption.", $tags="capabilities")
  ' aac CAP_PART_02: company_domain="Cross-Functional Services"
  System(CAP_PART, "Partner & Client Relationship Management", "Partner & Client Relationship Management. Level 0 enterprise capability domain (Direct tier).", $tags="capabilities")
  ' aac CAP_PART: company_domain="Cross-Functional Services"
  System(CAP_PART_03, "Servicing Client Origination & Contracting", "Win and contract third-party servicing engagements.", $tags="capabilities")
  ' aac CAP_PART_03: company_domain="Cross-Functional Services"
}
Boundary(b_Control, "Control") {
  System(CTL_CLIENT_SLA, "Client reporting and feed monitoring", "Contracted client reporting and data feeds are monitored to schedule and specification; misses alert before the client notices and count against the SLA.", $tags="controls")
  ' aac CTL_CLIENT_SLA: company_domain=""
  System(CTL_CLOSE_SIGNOFF, "Close reconciliation sign-off", "Period-end reconciliations and journal approvals complete with segregation of duties before financial sign-off.", $tags="controls")
  ' aac CTL_CLOSE_SIGNOFF: company_domain=""
  System(CTL_MKT_REVIEW, "Marketing material compliance review", "No creative or offer reaches market without documented compliance sign-off.", $tags="controls")
  ' aac CTL_MKT_REVIEW: company_domain=""
}
Boundary(b_Framework, "Framework") {
  System(FW_APQC, "APQC Process Classification Framework", "A cross-industry process taxonomy. Used here for the enabling tier, where a card-specific name adds nothing: finance, HR and corporate services look much the same in any industry, and inventing local names for them costs comparability for no benefit.", $tags="frameworks")
  ' aac FW_APQC: company_domain=""
  System(FW_BIAN, "BIAN", "The Banking Industry Architecture Network's service landscape. A reference model of banking service domains, organized into business areas. Strong on what a bank does and deliberately silent on how it is run.", $tags="frameworks")
  ' aac FW_BIAN: company_domain=""
}
Boundary(b_Process, "Process") {
  System(P_PARTNERSHIPS_003, "Calculate and settle partner revenue share", "Calculate each partner's share of interchange, interest and fees, its bounties for new accounts and its rewards funding under the agreement, settle the net amount, and reconcile it to the ledger. Revenue share is the partner's view of the program's health, so a disputed calculation sours the relationship as well as the books.", $tags="processes")
  ' aac P_PARTNERSHIPS_003: company_domain=""
  System(P_PARTNERSHIPS_001, "Fulfill issuing bank oversight obligations", "Produce contracted reporting, respond to oversight requests, and manage obligations under the issuing bank agreement.", $tags="processes")
  ' aac P_PARTNERSHIPS_001: company_domain=""
  System(P_PAYMENTS_005, "Implement network mandate release", "Assess and implement network mandate and release changes by the required date. Network mandates carry hard effective dates and fines for misses; assessment, build, and attestation are tracked per mandate from bulletin to production.", $tags="processes")
  ' aac P_PAYMENTS_005: company_domain=""
  System(P_PARTNERSHIPS_002, "Manage co-brand program agreement", "Negotiate and amend a co-brand or affinity agreement, track the partner's obligations on marketing, data sharing and approval of card terms, and hold the quarterly program review. The partner's brand is on the card but the bank is the lender, so marketing and terms the partner proposes still pass the bank's compliance review.", $tags="processes")
  ' aac P_PARTNERSHIPS_002: company_domain=""
  System(P_CLIENTMGMT_001, "Qualify, price, and contract servicing client", "Qualify a lender that wants its card portfolio serviced, price the work from the portfolio's size and the services chosen, answer the client's own diligence of the bank, and sign the servicing agreement and service levels. The agreement sets the reporting, service levels and change process every later step is held to.", $tags="processes")
  ' aac P_CLIENTMGMT_001: company_domain=""
  System(P_CLIENTMGMT_002, "Review client service levels and performance", "Report each client's service levels, portfolio performance and open issues, hold the monthly service review, and agree remediation and credits where a service level was missed. Missed service levels carry contractual credits, and a run of them can end a client relationship.", $tags="processes")
  ' aac P_CLIENTMGMT_002: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
  System(SYS_GL, "General ledger", "General ledger and financial accounting.", $tags="systems")
  ' aac SYS_GL: company_domain=""
  System(SYS_GRC, "Governance, risk and compliance platform", "Policy, control, issue, and risk register management.", $tags="systems")
  ' aac SYS_GRC: company_domain=""
  System(SYS_CLIENT_PORTAL, "Servicing client portal", "Client reporting, data exchange, and interaction.", $tags="systems")
  ' aac SYS_CLIENT_PORTAL: company_domain=""
}

