Boundary(b_Data_Asset, "Data Asset") {
  SystemDb(DA_CARD_ACCOUNT, "Card account master", "Account, balance, limit and status records for every card account.", $tags="data_assets")
  ' aac DA_CARD_ACCOUNT: company_domain="Card Issuing"
  SystemDb(DA_BUREAU_FILE, "Credit bureau furnishing file", "Monthly tradeline furnishing extract and consumer-dispute responses.", $tags="data_assets")
  ' aac DA_BUREAU_FILE: company_domain=""
  SystemDb(DA_LENDING_OPERATIONAL, "Installment Lending operational data", "Operational records held by Installment Lending.", $tags="data_assets")
  ' aac DA_LENDING_OPERATIONAL: company_domain="Lending"
  SystemDb(DA_PAYMENT_INSTR, "Payment instructions", "Cardholder payment methods and instructions: ACH details, scheduled payments.", $tags="data_assets")
  ' aac DA_PAYMENT_INSTR: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
  System(OI_LEDGER_QUEUE, "Core Ledger request queue", "Postings, holds and balance requests put on the ledger's MQ request queue, answered on the reply queue in the order they arrived. Built with MQ.", $tags="offered_interfaces")
  ' aac OI_LEDGER_QUEUE: company_domain="Card Issuing"; technology="MQ"
  System(OI_IDENTITY_API, "Customer Identity API", "Customer authentication and the profile behind it, for every product that signs a customer in. Built with HTTPS.", $tags="offered_interfaces")
  ' aac OI_IDENTITY_API: company_domain="Enterprise Platform"; technology="HTTPS"
  System(SYS_IDENTITY_SVC, "Customer Identity Service", "Shared platform service: Customer Identity Service. Built with AKS.", $tags="systems")
  ' aac SYS_IDENTITY_SVC: company_domain="Enterprise Platform"; hosting="Azure"; technology="AKS"
  System_Ext(SYS_CREDIT_BUREAU, "Experian Credit Bureau", "External credit reference agency used for affordability and bureau search at application time. Reached over PrivateLink from the lending workload account. Built with Experian.", $tags="systems")
  ' aac SYS_CREDIT_BUREAU: company_domain="Risk and Compliance"; hosting="SaaS"; technology="Experian"
  System(OI_LENDING_API, "Installment Lending API", "The domain API Installment Lending offers its channels, its jobs and its partners. Built with HTTPS.", $tags="offered_interfaces")
  ' aac OI_LENDING_API: company_domain="Lending"; technology="HTTPS"
  System(SYS_LENDING_WORKER, "Installment Lending Async Worker", "Consumes Installment Lending domain events and drives long-running work. Built with EKS · MSK.", $tags="systems")
  ' aac SYS_LENDING_WORKER: company_domain="Lending"; hosting="AWS"; technology="EKS · MSK"
  System(SYS_LENDING_DB, "Installment Lending Database", "Relational database for Installment Lending, encrypted with a customer managed key. Built with RDS.", $tags="systems")
  ' aac SYS_LENDING_DB: company_domain="Lending"; hosting="AWS"; technology="RDS"
  System(SYS_LENDING_BUCKET, "Installment Lending Object Store", "S3 bucket holding signed credit agreements and disbursement evidence. Seven-year retention with Object Lock; a records-management obligation rather than ordinary product storage. Built with S3.", $tags="systems")
  ' aac SYS_LENDING_BUCKET: company_domain="Lending"; hosting="AWS"; technology="S3"
  System(SYS_LENDING_API, "Installment Lending Service", "Domain service for Installment Lending, behind the Installment Lending API. Built with EKS · Installment Lending Cache.", $tags="systems")
  ' aac SYS_LENDING_API: company_domain="Lending"; hosting="AWS"; technology="EKS · Installment Lending Cache"
  System(SYS_LENDING_WEB, "Installment Lending Web", "Customer-facing front end for Installment Lending. Built with EKS.", $tags="systems")
  ' aac SYS_LENDING_WEB: company_domain="Lending"; hosting="AWS"; technology="EKS"
}
Boundary(b_Technology_Service, "Technology Service") {
  Deployment_Node(TS_AWS_CLOUDWATCH, "Amazon CloudWatch", "Observability", "Metrics, logs and alarms for every workload in the landing zone.", $tags="tech_services") {
    ' aac TS_AWS_CLOUDWATCH: company_domain="Enterprise Platform"; technology="Observability"
  }
  Deployment_Node(TS_AWS_EKS, "Amazon EKS", "Container platform", "Managed Kubernetes running the containerized workloads.", $tags="tech_services") {
    ' aac TS_AWS_EKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Deployment_Node(TS_AWS_MSK, "Amazon MSK", "Event stream", "Managed Kafka carrying domain events between products.", $tags="tech_services") {
    ' aac TS_AWS_MSK: company_domain="Enterprise Platform"; technology="Event stream"
  }
  Deployment_Node(TS_AWS_RDS, "Amazon RDS for PostgreSQL", "Relational database", "Managed relational database, Multi-AZ, encrypted with a customer managed key.", $tags="tech_services") {
    ' aac TS_AWS_RDS: company_domain="Enterprise Platform"; technology="Relational database"
  }
  Deployment_Node(TS_AWS_S3, "Amazon S3", "Object store", "Object storage for landing zones, artifacts and archives.", $tags="tech_services") {
    ' aac TS_AWS_S3: company_domain="Enterprise Platform"; technology="Object store"
  }
  Deployment_Node(TS_AWS_KMS, "AWS KMS", "Key management", "Customer managed keys for data at rest.", $tags="tech_services") {
    ' aac TS_AWS_KMS: company_domain="Enterprise Platform"; technology="Key management"
  }
  Deployment_Node(TS_AWS_PRIVATELINK, "AWS PrivateLink", "Private egress", "Private egress to partner and vendor endpoints without internet transit.", $tags="tech_services") {
    ' aac TS_AWS_PRIVATELINK: company_domain="Enterprise Platform"; technology="Private egress"
  }
  Deployment_Node(TS_AWS_SECRETS, "AWS Secrets Manager", "Secrets manager", "Application credentials and rotation.", $tags="tech_services") {
    ' aac TS_AWS_SECRETS: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_AZURE_APIM, "Azure API Management", "API gateway", "The API gateway every internal and partner API is published through.", $tags="tech_services") {
    ' aac TS_AZURE_APIM: company_domain="Enterprise Platform"; technology="API gateway"
  }
  Deployment_Node(TS_AZURE_KEYVAULT, "Azure Key Vault", "Secrets manager", "Secret, key and certificate management.", $tags="tech_services") {
    ' aac TS_AZURE_KEYVAULT: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_AZURE_AKS, "Azure Kubernetes Service", "Container platform", "Managed Kubernetes hosting the containerized estate.", $tags="tech_services") {
    ' aac TS_AZURE_AKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Deployment_Node(TS_IDENTITY_DNS, "Customer Identity Service DNS", "Azure DNS", "Name resolution and, in practice, the failover mechanism of last resort.", $tags="tech_services") {
    ' aac TS_IDENTITY_DNS: company_domain="Enterprise Platform"; technology="Azure DNS"
  }
  Deployment_Node(TS_IDENTITY_WAF, "Customer Identity Service Web application firewall", "Azure WAF", "Request inspection at the edge. Blocks the traffic nobody wrote a test for.", $tags="tech_services") {
    ' aac TS_IDENTITY_WAF: company_domain="Enterprise Platform"; technology="Azure WAF"
  }
  Deployment_Node(TS_LENDING_BACKUP, "Installment Lending Backup and recovery", "AWS Backup", "Copies that survive the thing they came from. The recovery objective is a property of this, not of the database.", $tags="tech_services") {
    ' aac TS_LENDING_BACKUP: company_domain="Lending"; technology="AWS Backup"
  }
  Deployment_Node(TS_LENDING_CACHE, "Installment Lending Cache", "Amazon ElastiCache", "In-memory key-value store. Also, in most estates, an accidental database with no backup.", $tags="tech_services") {
    ' aac TS_LENDING_CACHE: company_domain="Lending"; technology="Amazon ElastiCache"
  }
  Deployment_Node(TS_NET_SUB_LEND_APP_A, "Lending App Subnet A", "Subnet", $tags="tech_services") {
    ' aac TS_NET_SUB_LEND_APP_A: company_domain="Lending"; technology="Subnet"
  }
  Deployment_Node(TS_NET_SUB_LEND_APP_B, "Lending App Subnet B", "Subnet", $tags="tech_services") {
    ' aac TS_NET_SUB_LEND_APP_B: company_domain="Lending"; technology="Subnet"
  }
  Deployment_Node(TS_NET_SUB_LEND_DATA_A, "Lending Data Subnet A", "Subnet", $tags="tech_services") {
    ' aac TS_NET_SUB_LEND_DATA_A: company_domain="Lending"; technology="Subnet"
  }
  Deployment_Node(TS_NET_SUB_LEND_DATA_B, "Lending Data Subnet B", "Subnet", $tags="tech_services") {
    ' aac TS_NET_SUB_LEND_DATA_B: company_domain="Lending"; technology="Subnet"
  }
  Deployment_Node(TS_ONPREM_DC, "Primary Data Center", "Virtual network", "The data center the mainframe and the authorization switch live in. Modeled because half the integration cost of any cloud onboarding is the path back to here.", $tags="tech_services") {
    ' aac TS_ONPREM_DC: company_domain="Enterprise Platform"; technology="Virtual network"
  }
}

