' aac rel: source="ACT_SERVICING_CLIENT"; target="SYS_CLIENT_PORTAL"; label="Receives reports and data feeds"; relation="actor_uses_system"; interaction="Receives reports and data feeds"
Rel(ACT_COBRAND_PARTNER, SYS_CLIENT_PORTAL, "Receives program performance reports")
' aac rel: source="ACT_COBRAND_PARTNER"; target="SYS_CLIENT_PORTAL"; label="Receives program performance reports"; relation="actor_uses_system"; interaction="Receives program performance reports"
