Rel(ACT_SERVICING_AGENT, SYS_CONTACT, "Agent desktop")
' aac rel: source="ACT_SERVICING_AGENT"; target="SYS_CONTACT"; label="Agent desktop"; relation="actor_uses_system"; interaction="Agent desktop"
Rel(ACT_COLLECTIONS_AGENT, SYS_DIALER, "Outbound campaigns")
' aac rel: source="ACT_COLLECTIONS_AGENT"; target="SYS_DIALER"; label="Outbound campaigns"; relation="actor_uses_system"; interaction="Outbound campaigns"
Rel(ACT_UNDERWRITER, SYS_ORIG_DECISION, "Manual review queue")
' aac rel: source="ACT_UNDERWRITER"; target="SYS_ORIG_DECISION"; label="Manual review queue"; relation="actor_uses_system"; interaction="Manual review queue"
Rel(ACT_UNDERWRITER, SYS_CREDIT_DATA, "Strategy analysis")
' aac rel: source="ACT_UNDERWRITER"; target="SYS_CREDIT_DATA"; label="Strategy analysis"; relation="actor_uses_system"; interaction="Strategy analysis"
Rel(ACT_DEALER, SYS_DEALER_PORTAL, "Submits applications and contracts")
' aac rel: source="ACT_DEALER"; target="SYS_DEALER_PORTAL"; label="Submits applications and contracts"; relation="actor_uses_system"; interaction="Submits applications and contracts"
Rel(ACT_BORROWER, SYS_PAYMENT_GW, "Pays the loan")
' aac rel: source="ACT_BORROWER"; target="SYS_PAYMENT_GW"; label="Pays the loan"; relation="actor_uses_system"; interaction="Pays the loan"
Rel(ACT_BORROWER, SYS_CONTACT, "Calls about the loan")
' aac rel: source="ACT_BORROWER"; target="SYS_CONTACT"; label="Calls about the loan"; relation="actor_uses_system"; interaction="Calls about the loan"
Rel(ACT_FUNDING_ANALYST, SYS_LOS, "Clears stipulations and funds")
' aac rel: source="ACT_FUNDING_ANALYST"; target="SYS_LOS"; label="Clears stipulations and funds"; relation="actor_uses_system"; interaction="Clears stipulations and funds"
Rel(ACT_FUNDING_ANALYST, SYS_LOAN_SVC, "Boards loans")
' aac rel: source="ACT_FUNDING_ANALYST"; target="SYS_LOAN_SVC"; label="Boards loans"; relation="actor_uses_system"; interaction="Boards loans"
Rel(ACT_UNDERWRITER, SYS_LOS, "Reviews referred dealer applications")
' aac rel: source="ACT_UNDERWRITER"; target="SYS_LOS"; label="Reviews referred dealer applications"; relation="actor_uses_system"; interaction="Reviews referred dealer applications"
Rel(ACT_ISO, SYS_MERCHANT_WEB, "Submits merchant applications")
' aac rel: source="ACT_ISO"; target="SYS_MERCHANT_WEB"; label="Submits merchant applications"; relation="actor_uses_system"; interaction="Submits merchant applications"
Rel(ACT_DEPOSITOR, SYS_DEPOSIT, "Opens and manages CDs and savings")
' aac rel: source="ACT_DEPOSITOR"; target="SYS_DEPOSIT"; label="Opens and manages CDs and savings"; relation="actor_uses_system"; interaction="Opens and manages CDs and savings"
Rel(ACT_DEPOSIT_BROKER, SYS_BROKER_GW, "Exchanges allocation and position files")
' aac rel: source="ACT_DEPOSIT_BROKER"; target="SYS_BROKER_GW"; label="Exchanges allocation and position files"; relation="actor_uses_system"; interaction="Exchanges allocation and position files"
