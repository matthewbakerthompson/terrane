  System(SYS_MOBILE, "Cardholder mobile application", "Cardholder mobile self-service.", $tags="systems")
  ' aac SYS_MOBILE: company_domain=""
  System(SYS_CONTACT, "Contact center platform", "Contact center routing, voice, and digital channels.", $tags="systems")
  ' aac SYS_CONTACT: company_domain=""
  System(SYS_ORIG_DECISION, "Originations decision engine", "Application processing and credit decision execution.", $tags="systems")
  ' aac SYS_ORIG_DECISION: company_domain=""
}

Rel(P_ORIG_001, SYS_ORIG_DECISION, "Primary")
