Rel(P_ORIG_001, DA_APPLICATION, "Writes")
' aac rel: source="P_ORIG_001"; target="DA_APPLICATION"; label="Writes"; relation="process_uses_data_asset"; access="Writes"
Rel(P_ORIG_001, DA_PROSPECT, "Both")
