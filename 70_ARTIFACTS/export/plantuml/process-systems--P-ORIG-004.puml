' aac rel: source="P_ORIG_004"; target="DA_BUREAU_FILE"; label="Reads"; relation="process_uses_data_asset"; access="Reads"
Rel(P_ORIG_004, DA_MODEL_FEAT, "Reads")
' aac rel: source="P_ORIG_004"; target="DA_MODEL_FEAT"; label="Reads"; relation="process_uses_data_asset"; access="Reads"
Rel(P_ORIG_004, CTL_ADVERSE_ACT, "governed by")
