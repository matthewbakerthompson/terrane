Rel(TS_GCP_SHARED_VPC, TS_GCPNET_SUB_ANALYTICS_DATA_DR, "subnetwork (DR)")
' aac rel: source="TS_GCP_SHARED_VPC"; target="TS_GCPNET_SUB_ANALYTICS_DATA_DR"; label="subnetwork (DR)"; relation="tech_service_connects_to"; connection="subnetwork (DR)"

