Rel(SYS_CARDSVC_WEB, TS_CARDSVC_WAF, "runs on")
' aac rel: source="SYS_CARDSVC_WEB"; target="TS_CARDSVC_WAF"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CARDSVC_WEB, TS_AZURE_AKS, "runs on")
' aac rel: source="SYS_CARDSVC_WEB"; target="TS_AZURE_AKS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CARDSVC_WEB, TS_ENTRA_ID, "runs on")
' aac rel: source="SYS_CARDSVC_WEB"; target="TS_ENTRA_ID"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CARDSVC_API, DA_CARDSVC_OPERATIONAL, "ReadWrite")
' aac rel: source="SYS_CARDSVC_API"; target="DA_CARDSVC_OPERATIONAL"; label="ReadWrite"; relation="system_reads_writes"; operation="ReadWrite"
Rel(SYS_CARDSVC_API, DA_CARD_ACCOUNT, "Read")
' aac rel: source="SYS_CARDSVC_API"; target="DA_CARD_ACCOUNT"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_CARDSVC_API, DA_TRANSACTION, "Read")
' aac rel: source="SYS_CARDSVC_API"; target="DA_TRANSACTION"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(OI_CARDSVC_API, SYS_CARDSVC_API, "offered by")
' aac rel: source="OI_CARDSVC_API"; target="SYS_CARDSVC_API"; label="offered by"; field="system_id"

SHOW_LEGEND()
