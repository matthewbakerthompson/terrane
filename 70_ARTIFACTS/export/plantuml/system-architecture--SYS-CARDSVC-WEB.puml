Rel(SYS_CARDSVC_API, TS_AZURE_AKS, "runs on")
' aac rel: source="SYS_CARDSVC_API"; target="TS_AZURE_AKS"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CARDSVC_API, TS_CARDSVC_CACHE, "runs on")
' aac rel: source="SYS_CARDSVC_API"; target="TS_CARDSVC_CACHE"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CARDSVC_API, TS_AZURE_MONITOR, "runs on")
' aac rel: source="SYS_CARDSVC_API"; target="TS_AZURE_MONITOR"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CARDSVC_API, TS_AZURE_KEYVAULT, "runs on")
' aac rel: source="SYS_CARDSVC_API"; target="TS_AZURE_KEYVAULT"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_CARDSVC_WEB, TS_CARDSVC_DNS, "runs on")
