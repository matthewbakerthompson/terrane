@startuml
' Lending — Landscape
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Lending — Landscape

AddElementTag("offered_interfaces", $bgColor="#e6ecff", $borderColor="#6366f1", $fontColor="#0f172a", $legendText="offered interface")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")
AddRelTag("api-call", $legendText="API call")
AddRelTag("event", $legendText="Event on the bus")
AddRelTag("event-over-https", $legendText="Event over HTTPS")
AddRelTag("own-datastore", $legendText="Its own datastore")
AddRelTag("pipeline-load", $legendText="Pipeline load")
AddRelTag("private-egress", $legendText="Private path to a vendor")
AddRelTag("queued-request", $legendText="Request on a queue")
AddRelTag("scheduled-file", $legendText="Scheduled file")
AddRelTag("scheduled-pull", $legendText="Scheduled API pull")

Boundary(b_Card_Issuing, "Card Issuing") {
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
  System(OI_LEDGER_QUEUE, "Core Ledger request queue", "Postings, holds and balance requests put on the ledger's MQ request queue, answered on the reply queue in the order they arrived. Built with MQ.", $tags="offered_interfaces")
  ' aac OI_LEDGER_QUEUE: company_domain="Card Issuing"; technology="MQ"
}
Boundary(b_Data_and_Analytics, "Data and Analytics") {
  System(SYS_DATA_INGEST, "Enterprise Data Ingestion Hub", "Landing zone and ingestion orchestration for inbound file and event feeds before they reach the warehouse. Built with Service Bus · Snowflake Data Cloud.", $tags="systems")
  ' aac SYS_DATA_INGEST: company_domain="Data and Analytics"; hosting="Azure"; technology="Service Bus · Snowflake Data Cloud"
}
Boundary(b_Enterprise_Platform, "Enterprise Platform") {
  System(OI_IDENTITY_API, "Customer Identity API", "Customer authentication and the profile behind it, for every product that signs a customer in. Built with HTTPS.", $tags="offered_interfaces")
  ' aac OI_IDENTITY_API: company_domain="Enterprise Platform"; technology="HTTPS"
  System(SYS_IDENTITY_SVC, "Customer Identity Service", "Shared platform service: Customer Identity Service. Built with AKS.", $tags="systems")
  ' aac SYS_IDENTITY_SVC: company_domain="Enterprise Platform"; hosting="Azure"; technology="AKS"
  System(SYS_OBAFF_EGRESS, "Open Banking Affordability Private Egress", "PrivateLink endpoint and egress allow-list for TrueLayer. The control that keeps regulated data off the public internet, and the thing a security review asks to see first.", $tags="systems")
  ' aac SYS_OBAFF_EGRESS: company_domain="Enterprise Platform"; hosting="GCP"
}
Boundary(b_Lending, "Lending") {
  System(OI_LENDING_API, "Installment Lending API", "The domain API Installment Lending offers its channels, its jobs and its partners. Built with HTTPS.", $tags="offered_interfaces")
  ' aac OI_LENDING_API: company_domain="Lending"; technology="HTTPS"
  System(SYS_LENDING_WORKER, "Installment Lending Async Worker", "Consumes Installment Lending domain events and drives long-running work. Built with EKS · MSK.", $tags="systems")
  ' aac SYS_LENDING_WORKER: company_domain="Lending"; hosting="AWS"; technology="EKS · MSK"
  System(SYS_LENDING_DB, "Installment Lending Database", "Relational database for Installment Lending, encrypted with a customer managed key. Built with RDS.", $tags="systems")
  ' aac SYS_LENDING_DB: company_domain="Lending"; hosting="AWS"; technology="RDS"
  System(SYS_LENDING_EDGE, "Installment Lending Edge", "CDN distribution and WAF ruleset for Installment Lending.", $tags="systems")
  ' aac SYS_LENDING_EDGE: company_domain="Lending"; hosting="AWS"
  System(SYS_LENDING_HUB, "Installment Lending Integration Hub", "Mediates every Installment Lending integration: one place for mapping, routing, retry and the audit trail, so the spokes do not each carry their own.", $tags="systems")
  ' aac SYS_LENDING_HUB: company_domain="Lending"; hosting="AWS"
  System(SYS_LENDING_ALB, "Installment Lending Load Balancer", "Public load balancer terminating TLS for Installment Lending.", $tags="systems")
  ' aac SYS_LENDING_ALB: company_domain="Lending"; hosting="AWS"
  System(SYS_LENDING_BUCKET, "Installment Lending Object Store", "S3 bucket holding signed credit agreements and disbursement evidence. Seven-year retention with Object Lock; a records-management obligation rather than ordinary product storage. Built with S3.", $tags="systems")
  ' aac SYS_LENDING_BUCKET: company_domain="Lending"; hosting="AWS"; technology="S3"
  System(SYS_LENDING_API, "Installment Lending Service", "Domain service for Installment Lending, behind the Installment Lending API. Built with EKS · Installment Lending Cache.", $tags="systems")
  ' aac SYS_LENDING_API: company_domain="Lending"; hosting="AWS"; technology="EKS · Installment Lending Cache"
  System(SYS_LENDING_WEB, "Installment Lending Web", "Customer-facing front end for Installment Lending. Built with EKS.", $tags="systems")
  ' aac SYS_LENDING_WEB: company_domain="Lending"; hosting="AWS"; technology="EKS"
  System(SYS_LENDPERF_PIPELINE, "Lending Portfolio Performance Pipeline", "Dataflow jobs on a Composer schedule, ingesting the source events of Lending Portfolio Performance from Pub/Sub and curating them into BigQuery. Built with BigQuery · Dataflow +3.", $tags="systems")
  ' aac SYS_LENDPERF_PIPELINE: company_domain="Lending"; hosting="GCP"; technology="BigQuery · Dataflow +3"
  System(SYS_LENDPERF_SEMANTIC, "Lending Portfolio Performance Semantic Layer", "Governed models and metrics exposed to analysts for Lending Portfolio Performance, served from BigQuery through Looker. Built with BigQuery · Looker.", $tags="systems")
  ' aac SYS_LENDPERF_SEMANTIC: company_domain="Lending"; hosting="GCP"; technology="BigQuery · Looker"
  System_Ext(SYS_OBAFF_VENDOR, "Open Banking Affordability", "Open banking data access and affordability categorization, operated by TrueLayer in their own tenancy under the UK open banking framework; bank data is held for the assessment and deleted at the vendor once the result is returned. Built with TrueLayer.", $tags="systems")
  ' aac SYS_OBAFF_VENDOR: company_domain="Lending"; hosting="SaaS"; technology="TrueLayer"
  System(SYS_OBAFF_GATEWAY, "Open Banking Affordability Integration Gateway", "Our side of the TrueLayer integration: request mapping, retry and back-off, circuit breaking when the vendor is down, and the audit trail of what we sent them. Built with GKE.", $tags="systems")
  ' aac SYS_OBAFF_GATEWAY: company_domain="Lending"; hosting="GCP"; technology="GKE"
  System(SYS_OBAFF_WEBHOOKS, "Open Banking Affordability Webhook Listener", "Receives TrueLayer callbacks, verifies their signature, and forwards the event. Public by necessity, small by design. Built with GKE.", $tags="systems")
  ' aac SYS_OBAFF_WEBHOOKS: company_domain="Lending"; hosting="GCP"; technology="GKE"
  System(OI_POSFIN_API, "Point-of-Sale Finance API", "The domain API Point-of-Sale Finance offers its channels, its jobs and its partners. Built with HTTPS.", $tags="offered_interfaces")
  ' aac OI_POSFIN_API: company_domain="Lending"; technology="HTTPS"
  System(SYS_POSFIN_DB, "Point-of-Sale Finance Database", "Relational database for Point-of-Sale Finance, encrypted with a customer managed key. Built with Cloud SQL.", $tags="systems")
  ' aac SYS_POSFIN_DB: company_domain="Lending"; hosting="GCP"; technology="Cloud SQL"
  System(SYS_POSFIN_EVENTS, "Point-of-Sale Finance Event Publisher", "Publishes Point-of-Sale Finance domain events onto the enterprise bus. Built with Pub/Sub.", $tags="systems")
  ' aac SYS_POSFIN_EVENTS: company_domain="Lending"; hosting="GCP"; technology="Pub/Sub"
  System(SYS_POSFIN_API, "Point-of-Sale Finance Service", "Domain API for point-of-sale finance: dealer applications, shopper identity and consent, decisions, and the payment schedule that follows. Built with GKE · Point-of-Sale Finance Cache.", $tags="systems")
  ' aac SYS_POSFIN_API: company_domain="Lending"; hosting="GCP"; technology="GKE · Point-of-Sale Finance Cache"
  System(SYS_POSFIN_WEB, "Point-of-Sale Finance Web", "Customer-facing front end for Point-of-Sale Finance. Built with GKE.", $tags="systems")
  ' aac SYS_POSFIN_WEB: company_domain="Lending"; hosting="GCP"; technology="GKE"
}
Boundary(b_Risk_and_Compliance, "Risk and Compliance") {
  System_Ext(SYS_CREDIT_BUREAU, "Experian Credit Bureau", "External credit reference agency used for affordability and bureau search at application time. Reached over PrivateLink from the lending workload account. Built with Experian.", $tags="systems")
  ' aac SYS_CREDIT_BUREAU: company_domain="Risk and Compliance"; hosting="SaaS"; technology="Experian"
  System(SYS_REG_REPORTING, "Regulatory Reporting Engine", "Planned replacement for the spreadsheet-based regulatory reporting process, sourcing from the warehouse rather than from the ledger directly. Built with AKS · Snowflake Data Cloud.", $tags="systems")
  ' aac SYS_REG_REPORTING: company_domain="Risk and Compliance"; hosting="Azure"; technology="AKS · Snowflake Data Cloud"
}
Boundary(b_Servicing, "Servicing") {
  System_Ext(SYS_CRM, "Dynamics 365 Customer Service", "Contact center desktop and case management for servicing agents. Built with Microsoft.", $tags="systems")
  ' aac SYS_CRM: company_domain="Servicing"; hosting="SaaS"; technology="Microsoft"
}

Rel(SYS_CRM, SYS_CORE_LEDGER, "Servicing CRM to Core Ledger", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CRM"; target="SYS_CORE_LEDGER"; label="Servicing CRM to Core Ledger"; interface_id="INT-CRM-LEDGER"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CORE_LEDGER, SYS_DATA_INGEST, "Core Ledger to Data Ingestion Hub", "FileTransfer", $tags="scheduled-file")
' aac rel: source="SYS_CORE_LEDGER"; target="SYS_DATA_INGEST"; label="Core Ledger to Data Ingestion Hub"; interface_id="INT-LEDGER-INGEST"; kind="scheduled-file"; integration_style="Batch"; auth_method="KeyPair"; frequency="Daily"; direction="Outbound"
Rel(SYS_LENDING_API, OI_LEDGER_QUEUE, "Installment Lending Service to Core Card Ledger", "MQ", $tags="queued-request")
' aac rel: source="SYS_LENDING_API"; target="OI_LEDGER_QUEUE"; label="Installment Lending Service to Core Card Ledger"; interface_id="INT-LENDING-API-LEDGER"; kind="queued-request"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"; offered_interface_id="OI-LEDGER-QUEUE"
Rel(SYS_LENDING_API, OI_IDENTITY_API, "Installment Lending Service to Identity Service", "HTTPS", $tags="api-call")
' aac rel: source="SYS_LENDING_API"; target="OI_IDENTITY_API"; label="Installment Lending Service to Identity Service"; interface_id="INT-LENDING-API-IDENTITY"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"; offered_interface_id="OI-IDENTITY-API"
Rel(SYS_LENDING_WORKER, SYS_DATA_INGEST, "Installment Lending Worker to Data Ingestion Hub", "S3", $tags="pipeline-load")
' aac rel: source="SYS_LENDING_WORKER"; target="SYS_DATA_INGEST"; label="Installment Lending Worker to Data Ingestion Hub"; interface_id="INT-LENDING-WORKER-INGEST"; kind="pipeline-load"; integration_style="Batch"; auth_method="IAM"; frequency="Daily"; direction="Outbound"
Rel(SYS_LENDING_API, SYS_CREDIT_BUREAU, "Installment Lending Service to Credit Bureau", "HTTPS", $tags="api-call")
' aac rel: source="SYS_LENDING_API"; target="SYS_CREDIT_BUREAU"; label="Installment Lending Service to Credit Bureau"; interface_id="INT-LENDING-API-BUREAU"; kind="api-call"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"
Rel(SYS_LENDING_WEB, OI_LENDING_API, "Installment Lending Web to API", "HTTPS", $tags="api-call")
' aac rel: source="SYS_LENDING_WEB"; target="OI_LENDING_API"; label="Installment Lending Web to API"; interface_id="INT-LENDING-WEB-API"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"; offered_interface_id="OI-LENDING-API"
Rel(SYS_LENDING_EDGE, SYS_LENDING_ALB, "Installment Lending Edge to Load Balancer", "HTTPS", $tags="api-call")
' aac rel: source="SYS_LENDING_EDGE"; target="SYS_LENDING_ALB"; label="Installment Lending Edge to Load Balancer"; interface_id="INT-LENDING-EDGE-ALB"; kind="api-call"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Inbound"
Rel(SYS_LENDING_ALB, SYS_LENDING_WEB, "Installment Lending Load Balancer to Web", "HTTPS", $tags="api-call")
' aac rel: source="SYS_LENDING_ALB"; target="SYS_LENDING_WEB"; label="Installment Lending Load Balancer to Web"; interface_id="INT-LENDING-ALB-WEB"; kind="api-call"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Inbound"
Rel(SYS_LENDING_API, SYS_LENDING_WORKER, "Installment Lending Service to Async Worker", "Kafka", $tags="event")
' aac rel: source="SYS_LENDING_API"; target="SYS_LENDING_WORKER"; label="Installment Lending Service to Async Worker"; interface_id="INT-LENDING-API-WORKER"; kind="event"; integration_style="Event"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_LENDING_API, SYS_LENDING_DB, "Installment Lending Service to Database", "PostgreSQL", $tags="own-datastore")
' aac rel: source="SYS_LENDING_API"; target="SYS_LENDING_DB"; label="Installment Lending Service to Database"; interface_id="INT-LENDING-API-DB"; kind="own-datastore"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_LENDING_API, SYS_LENDING_BUCKET, "Installment Lending Service to Object Store", "HTTPS", $tags="api-call")
' aac rel: source="SYS_LENDING_API"; target="SYS_LENDING_BUCKET"; label="Installment Lending Service to Object Store"; interface_id="INT-LENDING-API-BUCKET"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CORE_LEDGER, SYS_LENDING_HUB, "CORE-LEDGER via Installment Lending hub", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CORE_LEDGER"; target="SYS_LENDING_HUB"; label="CORE-LEDGER via Installment Lending hub"; interface_id="INT-LENDING-CORE-LEDGER-HUB"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CREDIT_BUREAU, SYS_LENDING_HUB, "CREDIT-BUREAU via Installment Lending hub", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CREDIT_BUREAU"; target="SYS_LENDING_HUB"; label="CREDIT-BUREAU via Installment Lending hub"; interface_id="INT-LENDING-CREDIT-BUREAU-HUB"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_CRM, SYS_LENDING_HUB, "CRM via Installment Lending hub", "HTTPS", $tags="api-call")
' aac rel: source="SYS_CRM"; target="SYS_LENDING_HUB"; label="CRM via Installment Lending hub"; interface_id="INT-LENDING-CRM-HUB"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_POSFIN_EVENTS, SYS_LENDPERF_PIPELINE, "Source events to Lending Portfolio Performance Pipeline", "Pub/Sub", $tags="event")
' aac rel: source="SYS_POSFIN_EVENTS"; target="SYS_LENDPERF_PIPELINE"; label="Source events to Lending Portfolio Performance Pipeline"; interface_id="INT-LENDPERF-INGEST"; kind="event"; integration_style="Event"; auth_method="WorkloadIdentity"; frequency="Realtime"; direction="Inbound"
Rel(SYS_LENDPERF_PIPELINE, SYS_LENDPERF_SEMANTIC, "Lending Portfolio Performance Pipeline to Semantic Layer", "SQL", $tags="pipeline-load")
' aac rel: source="SYS_LENDPERF_PIPELINE"; target="SYS_LENDPERF_SEMANTIC"; label="Lending Portfolio Performance Pipeline to Semantic Layer"; interface_id="INT-LENDPERF-PIPE-SEMANTIC"; kind="pipeline-load"; integration_style="Batch"; auth_method="WorkloadIdentity"; frequency="Daily"; direction="Outbound"
Rel(SYS_LENDPERF_SEMANTIC, SYS_REG_REPORTING, "Lending Portfolio Performance Semantic Layer to Regulatory Reporting Engine", "HTTPS", $tags="scheduled-pull")
' aac rel: source="SYS_LENDPERF_SEMANTIC"; target="SYS_REG_REPORTING"; label="Lending Portfolio Performance Semantic Layer to Regulatory Reporting Engine"; interface_id="INT-LENDPERF-REGREPORTING"; kind="scheduled-pull"; integration_style="Batch"; auth_method="WorkloadIdentity"; frequency="Daily"; direction="Outbound"
Rel(SYS_POSFIN_API, SYS_OBAFF_GATEWAY, "SYS-POSFIN-API to Open Banking Affordability Gateway", "HTTPS", $tags="api-call")
' aac rel: source="SYS_POSFIN_API"; target="SYS_OBAFF_GATEWAY"; label="SYS-POSFIN-API to Open Banking Affordability Gateway"; interface_id="INT-OBAFF-CALLER-GATEWAY"; kind="api-call"; integration_style="Request-response"; auth_method="MutualTLS"; frequency="Realtime"; direction="Outbound"
Rel(SYS_OBAFF_GATEWAY, SYS_OBAFF_EGRESS, "Open Banking Affordability Gateway to Private Egress", "HTTPS", $tags="api-call")
' aac rel: source="SYS_OBAFF_GATEWAY"; target="SYS_OBAFF_EGRESS"; label="Open Banking Affordability Gateway to Private Egress"; interface_id="INT-OBAFF-GATEWAY-EGRESS"; kind="api-call"; integration_style="Request-response"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_OBAFF_EGRESS, SYS_OBAFF_VENDOR, "Private Egress to TrueLayer", "PrivateLink", $tags="private-egress")
' aac rel: source="SYS_OBAFF_EGRESS"; target="SYS_OBAFF_VENDOR"; label="Private Egress to TrueLayer"; interface_id="INT-OBAFF-EGRESS-VENDOR"; kind="private-egress"; integration_style="Request-response"; auth_method="WorkloadIdentity"; frequency="Realtime"; direction="Outbound"
Rel(SYS_OBAFF_VENDOR, SYS_OBAFF_WEBHOOKS, "TrueLayer webhooks", "HTTPS", $tags="event-over-https")
' aac rel: source="SYS_OBAFF_VENDOR"; target="SYS_OBAFF_WEBHOOKS"; label="TrueLayer webhooks"; interface_id="INT-OBAFF-VENDOR-WEBHOOKS"; kind="event-over-https"; integration_style="Event"; auth_method="HMAC"; frequency="Realtime"; direction="Inbound"
Rel(SYS_OBAFF_WEBHOOKS, SYS_POSFIN_API, "Open Banking Affordability Webhook Listener to SYS-POSFIN-API", "HTTPS", $tags="event-over-https")
' aac rel: source="SYS_OBAFF_WEBHOOKS"; target="SYS_POSFIN_API"; label="Open Banking Affordability Webhook Listener to SYS-POSFIN-API"; interface_id="INT-OBAFF-WEBHOOKS-CONSUMER"; kind="event-over-https"; integration_style="Event"; auth_method="IAM"; frequency="Realtime"; direction="Outbound"
Rel(SYS_POSFIN_WEB, OI_POSFIN_API, "Point-of-Sale Finance Web to API", "HTTPS", $tags="api-call")
' aac rel: source="SYS_POSFIN_WEB"; target="OI_POSFIN_API"; label="Point-of-Sale Finance Web to API"; interface_id="INT-POSFIN-WEB-API"; kind="api-call"; integration_style="Request-response"; auth_method="OAuth2"; frequency="Realtime"; direction="Outbound"; offered_interface_id="OI-POSFIN-API"
Rel(SYS_POSFIN_API, SYS_POSFIN_DB, "Point-of-Sale Finance Service to Database", "PostgreSQL", $tags="own-datastore")
' aac rel: source="SYS_POSFIN_API"; target="SYS_POSFIN_DB"; label="Point-of-Sale Finance Service to Database"; interface_id="INT-POSFIN-API-DB"; kind="own-datastore"; integration_style="Request-response"; auth_method="WorkloadIdentity"; frequency="Realtime"; direction="Outbound"
Rel(SYS_POSFIN_API, SYS_POSFIN_EVENTS, "Point-of-Sale Finance Service to Event Publisher", "AMQP", $tags="event")
' aac rel: source="SYS_POSFIN_API"; target="SYS_POSFIN_EVENTS"; label="Point-of-Sale Finance Service to Event Publisher"; interface_id="INT-POSFIN-API-EVENTS"; kind="event"; integration_style="Event"; auth_method="WorkloadIdentity"; frequency="Realtime"; direction="Outbound"
Rel(OI_IDENTITY_API, SYS_IDENTITY_SVC, "offered by")
' aac rel: source="OI_IDENTITY_API"; target="SYS_IDENTITY_SVC"; label="offered by"; field="system_id"
Rel(OI_LEDGER_QUEUE, SYS_CORE_LEDGER, "offered by")
' aac rel: source="OI_LEDGER_QUEUE"; target="SYS_CORE_LEDGER"; label="offered by"; field="system_id"
Rel(OI_LENDING_API, SYS_LENDING_API, "offered by")
' aac rel: source="OI_LENDING_API"; target="SYS_LENDING_API"; label="offered by"; field="system_id"
Rel(OI_POSFIN_API, SYS_POSFIN_API, "offered by")
' aac rel: source="OI_POSFIN_API"; target="SYS_POSFIN_API"; label="offered by"; field="system_id"

SHOW_LEGEND()
@enduml
