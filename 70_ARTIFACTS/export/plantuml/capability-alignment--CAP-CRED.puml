@startuml
' Credit Decisioning & Portfolio Management — Frameworks, Controls, Systems
' Generated from the model by `terrane export plantuml`. Edit the model, not the diagram.
!include <C4/C4_Deployment>

title Credit Decisioning & Portfolio Management — Frameworks, Controls, Systems

AddElementTag("capabilities", $bgColor="#ddd6fe", $borderColor="#6d28d9", $fontColor="#0f172a", $legendText="capability")
AddElementTag("controls", $bgColor="#fca5a5", $borderColor="#b91c1c", $fontColor="#0f172a", $legendText="control")
AddElementTag("frameworks", $bgColor="#d9f99d", $borderColor="#4d7c0f", $fontColor="#0f172a", $legendText="framework")
AddElementTag("processes", $bgColor="#bae6fd", $borderColor="#0369a1", $fontColor="#0f172a", $legendText="process")
AddElementTag("systems", $bgColor="#c7d6ff", $borderColor="#4338ca", $fontColor="#0f172a", $legendText="system")

Boundary(b_Capability, "Capability") {
  System(CAP_CRED_07, "Account Review & Reissue Decisioning", "Perform periodic account-level risk review and reissue decisions.", $tags="capabilities")
  ' aac CAP_CRED_07: company_domain="Originations"
  System(CAP_CRED_06, "Authorization Strategy Management", "Set the rules governing real-time authorization decisions.", $tags="capabilities")
  ' aac CAP_CRED_06: company_domain="Originations"
  System(CAP_CRED, "Credit Decisioning & Portfolio Management", "Credit Decisioning & Portfolio Management. Level 0 enterprise capability domain (Core tier).", $tags="capabilities")
  ' aac CAP_CRED: company_domain="Originations"
  System(CAP_CRED_03, "Credit Line Assignment & Management", "Set initial lines and manage increases, decreases, and reallocation.", $tags="capabilities")
  ' aac CAP_CRED_03: company_domain="Originations"
  System(CAP_CRED_01, "Credit Strategy & Scorecard Management", "Own the credit decision strategy and its cutoffs.", $tags="capabilities")
  ' aac CAP_CRED_01: company_domain="Originations"
  System(CAP_CRED_05, "Loss Forecasting & Allowance", "Forecast credit losses and set the allowance.", $tags="capabilities")
  ' aac CAP_CRED_05: company_domain="Originations"
  System(CAP_CRED_02, "Model Development & Validation", "Build, document, and validate credit and fraud models.", $tags="capabilities")
  ' aac CAP_CRED_02: company_domain="Originations"
  System(CAP_CRED_04, "Portfolio Risk Monitoring & Segmentation", "Monitor vintage, roll rate, and segment performance across the portfolio.", $tags="capabilities")
  ' aac CAP_CRED_04: company_domain="Originations"
}
Boundary(b_Control, "Control") {
  System(CTL_ADVERSE_ACT, "Adverse action notice completeness", "Every declined application generates a compliant adverse action notice with the principal reasons, within the required period.", $tags="controls")
  ' aac CTL_ADVERSE_ACT: company_domain=""
  System(CTL_AUTH_AVAIL, "Authorization availability and stand-in", "Authorization availability is monitored against the network SLA with tested stand-in arrangements; incidents invoke the resilience playbook.", $tags="controls")
  ' aac CTL_AUTH_AVAIL: company_domain=""
  System(CTL_TREATMENT_APPR, "Treatment strategy approval", "Collections treatment strategies and authorization strategies deploy only with documented risk and compliance approval and champion-challenger evidence.", $tags="controls")
  ' aac CTL_TREATMENT_APPR: company_domain=""
}
Boundary(b_Framework, "Framework") {
  System(FW_BIAN, "BIAN", "The Banking Industry Architecture Network's service landscape. A reference model of banking service domains, organized into business areas. Strong on what a bank does and deliberately silent on how it is run.", $tags="frameworks")
  ' aac FW_BIAN: company_domain=""
}
Boundary(b_Process, "Process") {
  System(P_CREDIT_009, "Acquire and refresh credit bureau data", "Source consumer bureau data for prescreen, account review, and portfolio monitoring under permissible purpose, and manage refresh cadence and quality.", $tags="processes")
  ' aac P_CREDIT_009: company_domain=""
  System(P_CREDIT_005, "Conduct monthly portfolio credit review", "Review vintage, roll-rate, and segment performance against risk appetite and record the actions agreed at the portfolio credit review.", $tags="processes")
  ' aac P_CREDIT_005: company_domain=""
  System(P_CREDIT_002, "Develop and validate credit model", "Build, document, and validate credit and fraud models prior to production deployment. Development evidence, data lineage, and validation results follow model risk management expectations; nothing reaches production without an independent validation record.", $tags="processes")
  ' aac P_CREDIT_002: company_domain=""
  System(P_ORIG_004, "Execute credit decision", "Apply the approved credit strategy to render an approve, decline, or counter-offer decision with a line assignment.", $tags="processes")
  ' aac P_ORIG_004: company_domain=""
  System(P_CREDIT_004, "Execute credit line decrease or account action", "Apply risk-driven line decreases or account actions, with required notice. Adverse action obligations apply to decreases and closures just as they do to declines; the notice must state the principal reasons and bureau information used.", $tags="processes")
  ' aac P_CREDIT_004: company_domain=""
  System(P_CREDIT_003, "Execute credit line increase program", "Identify eligible accounts and execute line increases under the approved strategy. Eligibility, ability-to-pay checks, and notice requirements are built into the program design; execution is batch with opt-out handling.", $tags="processes")
  ' aac P_CREDIT_003: company_domain=""
  System(P_CREDIT_007, "Maintain authorization strategy", "Define and deploy the rules governing real-time authorization decisions. Authorization strategy balances approval rates, fraud losses, and credit exposure in real time; changes deploy through the same testing discipline as origination strategy.", $tags="processes")
  ' aac P_CREDIT_007: company_domain=""
  System(P_CREDIT_008, "Perform account review and reissue decision", "Review account risk periodically and decide reissue, close, or continue. Periodic account review drives reissue, line, and closure decisions at card expiry and on risk triggers; decisions carry the same notice obligations as any adverse action.", $tags="processes")
  ' aac P_CREDIT_008: company_domain=""
  System(P_PAYMENTS_001, "Process authorization request", "Receive, decision, and respond to a real-time authorization request within the network response window.", $tags="processes")
  ' aac P_PAYMENTS_001: company_domain=""
  System(P_CREDIT_006, "Produce loss forecast and allowance", "Produce the credit loss forecast and set the allowance for the reporting period. The CECL forecast and allowance feed the financial statements; assumptions, overlays, and approvals are documented for both auditors and examiners.", $tags="processes")
  ' aac P_CREDIT_006: company_domain=""
  System(P_CREDIT_001, "Set and deploy credit decision strategy", "Define, test, approve, and deploy changes to the credit decision strategy and its cutoffs. Strategy changes ship through champion-challenger testing with documented approval; the deployed strategy is the single decisioning authority for originations.", $tags="processes")
  ' aac P_CREDIT_001: company_domain=""
}
Boundary(b_System, "System") {
  System(SYS_CORE_LEDGER, "Core Card Ledger", "The mainframe card ledger holding balances, limits, postings and interest. Everything else in the estate is downstream of this.", $tags="systems")
  ' aac SYS_CORE_LEDGER: company_domain="Card Issuing"; hosting="On-prem"
  System(SYS_CREDIT_DATA, "Credit data and decisioning environment", "Credit data, analytics, and decisioning environment. Built with Snowflake Data Cloud.", $tags="systems")
  ' aac SYS_CREDIT_DATA: company_domain=""; technology="Snowflake Data Cloud"
  System(SYS_DATA_INGEST, "Enterprise Data Ingestion Hub", "Landing zone and ingestion orchestration for inbound file and event feeds before they reach the warehouse. Built with Service Bus · Snowflake Data Cloud.", $tags="systems")
  ' aac SYS_DATA_INGEST: company_domain="Data and Analytics"; hosting="Azure"; technology="Service Bus · Snowflake Data Cloud"
  System(SYS_MODEL, "Model platform", "Model development, deployment, and monitoring.", $tags="systems")
  ' aac SYS_MODEL: company_domain=""
  System(SYS_ORIG_DECISION, "Originations decision engine", "Application processing and credit decision execution.", $tags="systems")
  ' aac SYS_ORIG_DECISION: company_domain=""
}

