Rel(P_ORIG_002, DA_APPLICATION, "Both")
' aac rel: source="P_ORIG_002"; target="DA_APPLICATION"; label="Both"; relation="process_uses_data_asset"; access="Both"
Rel(P_ORIG_003, DA_APPLICATION, "Reads")
' aac rel: source="P_ORIG_003"; target="DA_APPLICATION"; label="Reads"; relation="process_uses_data_asset"; access="Reads"
Rel(P_ORIG_004, DA_APPLICATION, "Both")
' aac rel: source="P_ORIG_004"; target="DA_APPLICATION"; label="Both"; relation="process_uses_data_asset"; access="Both"
Rel(P_ORIG_005, DA_APPLICATION, "Reads")
' aac rel: source="P_ORIG_005"; target="DA_APPLICATION"; label="Reads"; relation="process_uses_data_asset"; access="Reads"

SHOW_LEGEND()
