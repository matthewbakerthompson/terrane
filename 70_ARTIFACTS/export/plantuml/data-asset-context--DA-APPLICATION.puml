Rel(SYS_CREDIT_DATA, DA_APPLICATION, "Read")
' aac rel: source="SYS_CREDIT_DATA"; target="DA_APPLICATION"; label="Read"; relation="system_reads_writes"; operation="Read"
Rel(SYS_AML, DA_APPLICATION, "Read")
