      ' aac SYS_LENDING_API: company_domain="Lending"; hosting="AWS"; technology="EKS · Installment Lending Cache"
    }
  }
}
Boundary(b_Azure, "Azure") {
  Deployment_Node(TS_AZURE_APIM, "Azure API Management", "API gateway", "The API gateway every internal and partner API is published through.", $tags="tech_services") {
    ' aac TS_AZURE_APIM: company_domain="Enterprise Platform"; technology="API gateway"
  }
  Deployment_Node(TS_AZURE_KEYVAULT, "Azure Key Vault", "Secrets manager", "Secret, key and certificate management.", $tags="tech_services") {
    ' aac TS_AZURE_KEYVAULT: company_domain="Enterprise Platform"; technology="Secrets manager"
  }
  Deployment_Node(TS_AZURE_AKS, "Azure Kubernetes Service", "Container platform", "Managed Kubernetes hosting the containerized estate.", $tags="tech_services") {
    ' aac TS_AZURE_AKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Boundary(b_Azure__azure_cards_prod, "subscription azure-cards-prod") {
    Boundary(b_Azure__azure_cards_prod__Private_App, "Private-App") {
      System(SYS_CARDSVC_API, "Card Servicing Service", "The service behind the Card Servicing API, backing the channel. Built with AKS · Card Servicing Cache.", $tags="systems")
      ' aac SYS_CARDSVC_API: company_domain="Servicing"; hosting="Azure"; technology="AKS · Card Servicing Cache"
      System(SYS_COLLECT_API, "Collections Workspace Service", "The service behind the Collections Workspace API, backing the channel. Built with AKS · Collections Workspace Cache.", $tags="systems")
      ' aac SYS_COLLECT_API: company_domain="Collections"; hosting="Azure"; technology="AKS · Collections Workspace Cache"
    }
  }
  Boundary(b_Azure__azure_platform_prod, "subscription azure-platform-prod") {
    Boundary(b_Azure__azure_platform_prod__Edge, "Edge") {
      Deployment_Node(TS_IDENTITY_DNS, "Customer Identity Service DNS", "Azure DNS", "Name resolution and, in practice, the failover mechanism of last resort.", $tags="tech_services") {
        ' aac TS_IDENTITY_DNS: company_domain="Enterprise Platform"; technology="Azure DNS"
      }
      Deployment_Node(TS_IDENTITY_WAF, "Customer Identity Service Web application firewall", "Azure WAF", "Request inspection at the edge. Blocks the traffic nobody wrote a test for.", $tags="tech_services") {
        ' aac TS_IDENTITY_WAF: company_domain="Enterprise Platform"; technology="Azure WAF"
      }
    }
    Boundary(b_Azure__azure_platform_prod__Shared_Services, "Shared-Services") {
      System(OI_IDENTITY_API, "Customer Identity API", "Customer authentication and the profile behind it, for every product that signs a customer in. Built with HTTPS.", $tags="offered_interfaces")
      ' aac OI_IDENTITY_API: company_domain="Enterprise Platform"; technology="HTTPS"
      System(SYS_IDENTITY_SVC, "Customer Identity Service", "Shared platform service: Customer Identity Service. Built with AKS.", $tags="systems")
      ' aac SYS_IDENTITY_SVC: company_domain="Enterprise Platform"; hosting="Azure"; technology="AKS"
    }
  }
  Boundary(b_Azure__azure_risk_prod, "subscription azure-risk-prod") {
    Boundary(b_Azure__azure_risk_prod__Public, "Public") {
      System(SYS_IDV_WEBHOOKS, "Identity Document Verification Webhook Listener", "Receives Onfido callbacks, verifies their signature, and forwards the event. Public by necessity, small by design. Built with AKS.", $tags="systems")
      ' aac SYS_IDV_WEBHOOKS: company_domain="Risk and Compliance"; hosting="Azure"; technology="AKS"
    }
    Boundary(b_Azure__azure_risk_prod__Private_App, "Private-App") {
      System(SYS_IDV_GATEWAY, "Identity Document Verification Integration Gateway", "Our side of the Onfido integration: request mapping, retry and back-off, circuit breaking when the vendor is down, and the audit trail of what we sent them. Built with AKS.", $tags="systems")
      ' aac SYS_IDV_GATEWAY: company_domain="Risk and Compliance"; hosting="Azure"; technology="AKS"
    }
  }
}

