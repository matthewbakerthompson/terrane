  System(SYS_IDV_EGRESS, "Identity Document Verification Private Egress", "PrivateLink endpoint and egress allow-list for Onfido. The control that keeps regulated data off the public internet, and the thing a security review asks to see first.", $tags="systems")
  ' aac SYS_IDV_EGRESS: company_domain="Enterprise Platform"; hosting="Azure"
  System(SYS_IDV_WEBHOOKS, "Identity Document Verification Webhook Listener", "Receives Onfido callbacks, verifies their signature, and forwards the event. Public by necessity, small by design. Built with AKS.", $tags="systems")
  ' aac SYS_IDV_WEBHOOKS: company_domain="Risk and Compliance"; hosting="Azure"; technology="AKS"
}
Boundary(b_Technology_Service, "Technology Service") {
  Deployment_Node(TS_AZURE_APIM, "Azure API Management", "API gateway", "The API gateway every internal and partner API is published through.", $tags="tech_services") {
    ' aac TS_AZURE_APIM: company_domain="Enterprise Platform"; technology="API gateway"
  }
  Deployment_Node(TS_AZURE_AKS, "Azure Kubernetes Service", "Container platform", "Managed Kubernetes hosting the containerized estate.", $tags="tech_services") {
    ' aac TS_AZURE_AKS: company_domain="Enterprise Platform"; technology="Container platform"
  }
  Deployment_Node(TS_AZURE_PRIVATELINK, "Azure Private Link", "Private egress", "Private endpoints to bought services, so the only path our data takes to a vendor never touches the public internet.", $tags="tech_services") {
    ' aac TS_AZURE_PRIVATELINK: company_domain="Enterprise Platform"; technology="Private egress"
  }
  Deployment_Node(TS_AZURE_VWAN, "Azure Virtual WAN hub", "Transit hub", "The hub every virtual network attaches to, and the route back to the data center.", $tags="tech_services") {
    ' aac TS_AZURE_VWAN: company_domain="Enterprise Platform"; technology="Transit hub"
  }
}

Rel(SYS_IDV_EGRESS, SYS_IDV_VENDOR, "Private Egress to Onfido", "PrivateLink", $tags="private-egress")
