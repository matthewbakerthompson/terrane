Rel(SYS_IDV_EGRESS, TS_AZURE_PRIVATELINK, "runs on")
' aac rel: source="SYS_IDV_EGRESS"; target="TS_AZURE_PRIVATELINK"; label="runs on"; relation="system_uses_tech_service"
Rel(SYS_IDV_EGRESS, TS_AZURE_VWAN, "runs on")
' aac rel: source="SYS_IDV_EGRESS"; target="TS_AZURE_VWAN"; label="runs on"; relation="system_uses_tech_service"
